{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Phase 260.A.5 auth tenancy dashboard: cross-tenant denials by endpoint and requested/actual tenant pairs.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Top denied endpoints (last 1h)",
      "type": "graph",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "topk(10, sum by (endpoint) (increase(cross_tenant_denied_total[1h])))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "short",
          "label": "denials/hour"
        },
        {
          "format": "short"
        }
      ]
    },
    {
      "title": "Top requested-tenant pairs (last 24h)",
      "type": "table",
      "datasource": "PostgreSQL",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT details_json->>'requested_tenant_id' AS requested_tenant_id, details_json->>'actual_tenant_id' AS actual_tenant_id, COUNT(*) AS denied_count FROM audit_events WHERE action = 'CROSS_TENANT_DENIED' AND timestamp >= NOW() - INTERVAL '24 hours' GROUP BY 1, 2 ORDER BY denied_count DESC LIMIT 10;"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 27,
  "style": "dark",
  "tags": [
    "auth",
    "tenancy",
    "phase-260"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "utc",
  "title": "Auth Tenancy",
  "uid": "auth-tenancy",
  "version": 1
}
