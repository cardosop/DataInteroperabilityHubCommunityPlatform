{
  "title": "Redis Performance Monitoring",
  "tags": [
    "redis",
    "performance",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 27,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Memory Usage per Instance",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "(redis_memory_used_bytes{redis_instance=~\"cache|queue|events|channels\"} / redis_memory_max_bytes{redis_instance=~\"cache|queue|events|channels\"}) * 100",
          "legendFormat": "{{redis_instance}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "percent",
          "label": "Memory Usage (%)",
          "max": 100,
          "min": 0
        },
        {
          "format": "short"
        }
      ],
      "alert": {
        "conditions": [
          {
            "evaluator": {
              "params": [
                80
              ],
              "type": "gt"
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "A",
                "5m",
                "now"
              ]
            },
            "reducer": {
              "params": [],
              "type": "last"
            },
            "type": "query"
          }
        ],
        "executionErrorState": "alerting",
        "for": "5m",
        "frequency": "10s",
        "handler": 1,
        "name": "Redis Memory Usage High",
        "noDataState": "no_data",
        "notifications": []
      }
    },
    {
      "id": 2,
      "title": "Connection Pool Usage per Instance",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "(redis_connected_clients{redis_instance=~\"cache|queue|events|channels\"} / redis_maxclients{redis_instance=~\"cache|queue|events|channels\"}) * 100",
          "legendFormat": "{{redis_instance}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "percent",
          "label": "Connection Pool Usage (%)",
          "max": 100,
          "min": 0
        },
        {
          "format": "short"
        }
      ],
      "alert": {
        "conditions": [
          {
            "evaluator": {
              "params": [
                90
              ],
              "type": "gt"
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "A",
                "5m",
                "now"
              ]
            },
            "reducer": {
              "params": [],
              "type": "last"
            },
            "type": "query"
          }
        ],
        "executionErrorState": "alerting",
        "for": "5m",
        "frequency": "10s",
        "handler": 1,
        "name": "Redis Connection Pool Exhaustion",
        "noDataState": "no_data",
        "notifications": []
      }
    },
    {
      "id": 3,
      "title": "Command Rate per Instance",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(redis_commands_total{redis_instance=~\"cache|queue|events|channels\"}[5m])) by (redis_instance)",
          "legendFormat": "{{redis_instance}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "ops",
          "label": "Commands/sec"
        },
        {
          "format": "short"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latency (P95) per Instance",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(redis_commands_duration_seconds_bucket{redis_instance=~\"cache|queue|events|channels\"}[5m])) by (redis_instance, le))",
          "legendFormat": "{{redis_instance}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "s",
          "label": "Latency (seconds)"
        },
        {
          "format": "short"
        }
      ],
      "alert": {
        "conditions": [
          {
            "evaluator": {
              "params": [
                0.1
              ],
              "type": "gt"
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "A",
                "5m",
                "now"
              ]
            },
            "reducer": {
              "params": [],
              "type": "last"
            },
            "type": "query"
          }
        ],
        "executionErrorState": "alerting",
        "for": "5m",
        "frequency": "10s",
        "handler": 1,
        "name": "Redis Latency High",
        "noDataState": "no_data",
        "notifications": []
      }
    },
    {
      "id": 5,
      "title": "Memory Usage by Instance (Current)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 16
      },
