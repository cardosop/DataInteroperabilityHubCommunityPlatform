        {
          "expr": "(redis_memory_used_bytes{redis_instance=\"cache\"} / redis_memory_max_bytes{redis_instance=\"cache\"}) * 100",
          "refId": "A"
        }
      ],
      "options": {
        "fieldOptions": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 80
                },
                {
                  "color": "red",
                  "value": 95
                }
              ]
            }
          }
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
