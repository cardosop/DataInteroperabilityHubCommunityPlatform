{
  "title": "Marketplace Connections Overview",
  "tags": [
    "marketplace",
    "connections",
    "integration",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Total Connections by Marketplace Type",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(marketplace_connections_total) by (marketplace_type)",
          "legendFormat": "{{marketplace_type}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto"
      },
      "description": "Total number of marketplace connections created, grouped by marketplace type"
    },
    {
      "id": 2,
      "title": "Active vs Inactive Connections",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum(marketplace_connections_total) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "options": {
        "pieType": "pie",
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "visible",
          "placement": "right"
        }
      },
      "description": "Distribution of active and inactive marketplace connections"
    },
    {
      "id": 3,
      "title": "Connection Status by Marketplace Type",
      "type": "bargauge",
      "targets": [
        {
          "expr": "sum(marketplace_connection_status) by (marketplace_type)",
          "legendFormat": "{{marketplace_type}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "description": "Current active connection count by marketplace type"
    },
    {
      "id": 4,
      "title": "Connection Creation Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(marketplace_connections_total[5m])) by (marketplace_type, status)",
          "legendFormat": "{{marketplace_type}} {{status}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "yaxes": [
        {
          "format": "ops",
          "label": "Connections/sec"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      },
      "description": "Rate of marketplace connection creation over time"
    },
    {
      "id": 5,
      "title": "Connections by Tenant",
      "type": "table",
      "targets": [
        {
          "expr": "sum(marketplace_connections_total) by (tenant_id, marketplace_type, status)",
          "format": "table",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Marketplace connections grouped by tenant and marketplace type"
    },
    {
      "id": 6,
      "title": "Connection Status Changes Over Time",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(marketplace_connection_status[5m])) by (marketplace_type)",
          "legendFormat": "{{marketplace_type}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "yaxes": [
        {
          "format": "ops",
          "label": "Changes/sec"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      },
      "description": "Rate of connection status changes (activations/deactivations) over time"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "marketplace_type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(marketplace_connections_total, marketplace_type)",
        "includeAll": true,
        "multi": true,
        "allValue": null,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "tenant_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(marketplace_connections_total, tenant_id)",
        "includeAll": true,
        "multi": true,
        "allValue": null,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "editable": true,
  "graphTooltip": 0,
  "links": []
}
