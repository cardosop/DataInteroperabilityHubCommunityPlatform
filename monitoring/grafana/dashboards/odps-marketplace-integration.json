    {
      "id": 8,
      "title": "Purchase Conversion Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  CASE\n    WHEN COUNT(DISTINCT l.id) > 0 THEN\n      (COUNT(DISTINCT o.id)::float / COUNT(DISTINCT l.id)::float * 100)\n    ELSE 0\n  END AS conversion_rate\nFROM listings l\nLEFT JOIN orders o ON o.listing_id = l.id\n  AND o.status IN ('APPROVED', 'FULFILLED')\n  AND o.created_at >= $__timeFrom()\n  AND o.created_at <= $__timeTo()\nWHERE l.created_at >= $__timeFrom()\n  AND l.created_at <= $__timeTo()",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
