    {
      "id": 3,
      "title": "Pricing Plan Usage",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  plan->>'planID' AS plan_id,\n  plan->>'name' AS plan_name,\n  COUNT(*) AS usage_count\nFROM contracts c,\n  LATERAL jsonb_array_elements(\n    COALESCE(\n      c.hub_contract_json->'marketplace'->'x_odps'->'pricing_plans',\n      '[]'::jsonb\n    )\n  ) AS plan\nWHERE c.original_spec_type = 'ODPS'\n  AND c.hub_contract_json IS NOT NULL\n  AND c.hub_contract_json->'marketplace'->'x_odps'->'pricing_plans' IS NOT NULL\nGROUP BY plan->>'planID', plan->>'name'\nORDER BY usage_count DESC",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
