          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  method_key AS access_method,\n  COUNT(*) AS usage_count\nFROM contracts c,\n  LATERAL jsonb_object_keys(\n    COALESCE(\n      c.hub_contract_json->'marketplace'->'x_odps'->'access_methods',\n      '{}'::jsonb\n    )\n  ) AS method_key\nWHERE c.original_spec_type = 'ODPS'\n  AND c.hub_contract_json IS NOT NULL\n  AND c.hub_contract_json->'marketplace'->'x_odps'->'access_methods' IS NOT NULL\nGROUP BY method_key\nORDER BY usage_count DESC",
          "refId": "A",
