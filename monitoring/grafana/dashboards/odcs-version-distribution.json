{
  "title": "ODCS Version Distribution",
  "tags": [
    "odcs",
    "version",
    "distribution",
    "backward-compatibility",
    "task-6.2.5"
  ],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "ODCS Version Distribution (Pie Chart)",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(odcs_version_distribution_total[24h])) by (version)",
          "legendFormat": "{{version}}",
          "refId": "A"
        }
      ],
      "description": "Distribution of ODCS versions (3.0.2, 3.0.1, 3.0.0, 3.0.0-preview, 2.2.2) over last 24 hours"
    },
    {
      "id": 2,
      "title": "ODCS Version Distribution Over Time",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(odcs_version_distribution_total[5m])) by (version)",
          "legendFormat": "{{version}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "reqps",
          "label": "Documents/sec"
        },
        {
          "format": "short"
        }
      ],
      "description": "Rate of ODCS documents by version over time"
    },
    {
      "id": 3,
      "title": "ODCS Version Distribution by Tenant",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(increase(odcs_version_distribution_total[1h])) by (version, tenant_id)",
          "legendFormat": "{{version}} ({{tenant_id}})",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "short",
          "label": "Documents"
        },
        {
          "format": "short"
        }
      ],
      "description": "ODCS version distribution broken down by tenant"
    },
    {
      "id": 4,
      "title": "ODCS Version Adoption Trend",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(increase(odcs_version_distribution_total{version=\"3.0.2\"}[1h]))",
          "legendFormat": "3.0.2",
          "refId": "A"
        },
        {
          "expr": "sum(increase(odcs_version_distribution_total{version=\"3.0.1\"}[1h]))",
          "legendFormat": "3.0.1",
          "refId": "B"
        },
        {
          "expr": "sum(increase(odcs_version_distribution_total{version=\"3.0.0\"}[1h]))",
          "legendFormat": "3.0.0",
          "refId": "C"
        },
        {
          "expr": "sum(increase(odcs_version_distribution_total{version=\"3.0.0-preview\"}[1h]))",
          "legendFormat": "3.0.0-preview",
          "refId": "D"
        },
        {
          "expr": "sum(increase(odcs_version_distribution_total{version=\"2.2.2\"}[1h]))",
          "legendFormat": "2.2.2",
          "refId": "E"
        }
      ],
      "yaxes": [
        {
          "format": "short",
          "label": "Documents"
        },
        {
          "format": "short"
        }
      ],
      "description": "Trend of ODCS version adoption over time"
    },
    {
      "id": 5,
      "title": "ODCS Version Percentage",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(odcs_version_distribution_total[5m])) by (version) / sum(rate(odcs_version_distribution_total[5m]))",
          "legendFormat": "{{version}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "percentunit",
          "label": "Percentage",
          "min": 0,
          "max": 1
        },
        {
          "format": "short"
        }
      ],
      "description": "Percentage of total ODCS documents by version"
    },
    {
      "id": 6,
      "title": "ODCS Version Heatmap",
      "type": "heatmap",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(odcs_version_distribution_total[5m])) by (version, tenant_id)",
          "format": "heatmap",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "short",
          "label": "Version"
        },
        {
          "format": "short"
        }
      ],
      "description": "Heatmap showing ODCS version distribution by tenant"
    }
  ]
}
