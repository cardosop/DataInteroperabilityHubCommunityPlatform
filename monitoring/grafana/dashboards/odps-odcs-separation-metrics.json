{
  "title": "ODPS vs ODCS Separation Metrics",
  "tags": [
    "odps",
    "odcs",
    "separation",
    "marketplace",
    "technical",
    "task-6.2.5"
  ],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Ingestion Rate: ODPS (Marketplace) vs ODCS (Technical)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(odps_ingestion_total{source=\"marketplace\"}[5m]))",
          "legendFormat": "ODPS (Marketplace)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(odcs_ingestion_total{source=\"technical\"}[5m]))",
          "legendFormat": "ODCS (Technical)",
          "refId": "B"
        }
      ],
      "yaxes": [
        {
          "format": "reqps",
          "label": "Ingestions/sec"
        },
        {
          "format": "short"
        }
      ],
      "description": "Comparison of ODPS marketplace vs ODCS technical ingestion rates"
    },
    {
      "id": 2,
      "title": "Normalization Success Rate: ODPS vs ODCS",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(odps_normalization_total{status=\"success\"}[5m])) / sum(rate(odps_normalization_total[5m]))",
          "legendFormat": "ODPS Success Rate",
          "refId": "A"
        },
        {
          "expr": "sum(rate(odcs_normalization_total{status=\"success\"}[5m])) / sum(rate(odcs_normalization_total[5m]))",
          "legendFormat": "ODCS Success Rate",
          "refId": "B"
        }
      ],
      "yaxes": [
        {
          "format": "percentunit",
          "label": "Success Rate",
          "min": 0,
          "max": 1
        },
        {
          "format": "short"
        }
      ],
      "description": "Normalization success rate comparison between ODPS and ODCS"
    },
    {
      "id": 3,
      "title": "Total Documents: ODPS vs ODCS",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(increase(odps_ingestion_total{source=\"marketplace\"}[1h]))",
          "legendFormat": "ODPS (Marketplace)",
          "refId": "A"
        },
        {
          "expr": "sum(increase(odcs_ingestion_total{source=\"technical\"}[1h]))",
          "legendFormat": "ODCS (Technical)",
          "refId": "B"
        }
      ],
      "yaxes": [
        {
          "format": "short",
          "label": "Total Documents"
        },
        {
          "format": "short"
        }
      ],
      "description": "Total number of documents ingested in the last hour"
    },
    {
      "id": 4,
      "title": "Version Distribution: ODPS vs ODCS",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(odps_version_distribution_total[5m])) by (version)",
          "legendFormat": "ODPS {{version}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(odcs_version_distribution_total[5m])) by (version)",
          "legendFormat": "ODCS {{version}}",
          "refId": "B"
        }
      ],
      "yaxes": [
        {
          "format": "reqps",
          "label": "Documents/sec"
        },
        {
          "format": "short"
        }
      ],
      "description": "Version distribution comparison between ODPS and ODCS"
    },
    {
      "id": 5,
      "title": "ODPS vs ODCS Adoption Ratio",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(odps_ingestion_total{source=\"marketplace\"}[5m])) / sum(rate(odcs_ingestion_total{source=\"technical\"}[5m]))",
          "legendFormat": "ODPS/ODCS Ratio",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "short",
          "label": "Ratio"
        },
        {
          "format": "short"
        }
      ],
      "description": "Ratio of ODPS marketplace to ODCS technical ingestion rates"
    },
    {
      "id": 6,
      "title": "Separation Metrics Summary",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(increase(odps_ingestion_total{source=\"marketplace\"}[24h]))",
          "legendFormat": "ODPS (24h)",
          "refId": "A"
        },
        {
          "expr": "sum(increase(odcs_ingestion_total{source=\"technical\"}[24h]))",
          "legendFormat": "ODCS (24h)",
          "refId": "B"
        },
        {
          "expr": "sum(rate(odps_normalization_total{status=\"success\"}[5m])) / sum(rate(odps_normalization_total[5m]))",
          "legendFormat": "ODPS Success %",
          "refId": "C"
        },
        {
          "expr": "sum(rate(odcs_normalization_total{status=\"success\"}[5m])) / sum(rate(odcs_normalization_total[5m]))",
          "legendFormat": "ODCS Success %",
          "refId": "D"
        }
      ],
      "description": "Summary statistics for ODPS vs ODCS separation metrics"
    }
  ]
}
