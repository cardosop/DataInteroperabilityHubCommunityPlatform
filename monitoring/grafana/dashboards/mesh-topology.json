{
  "title": "Mesh Topology Dashboard",
  "tags": [
    "data-mesh",
    "topology",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Topology Update Rate",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(mesh_topology_updates_total[5m])) by (tenant_id)",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "ops",
          "label": "Updates/sec"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      }
    },
    {
      "id": 2,
      "title": "Topology Update Duration (P95)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(mesh_topology_update_duration_seconds_bucket[5m])) by (tenant_id, le))",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "s",
          "label": "Duration"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      }
    },
    {
      "id": 3,
      "title": "Current Domain Count",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(mesh_domain_count) by (tenant_id, status)",
          "legendFormat": "{{tenant_id}} - {{status}}",
          "refId": "A"
        }
      ],
      "options": {
        "unit": "short",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Current Relationship Count",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(mesh_relationship_count) by (tenant_id)",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "unit": "short",
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "title": "Topology Update Failures",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(mesh_topology_update_failures_total[5m])) by (tenant_id, error_type)",
          "legendFormat": "{{tenant_id}} - {{error_type}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "ops",
          "label": "Failures/sec"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      }
    },
    {
      "id": 6,
      "title": "Topology Update Failure Rate",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "(sum(rate(mesh_topology_update_failures_total[15m])) by (tenant_id) / sum(rate(mesh_topology_updates_total[15m])) by (tenant_id)) * 100",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "unit": "percent",
        "min": 0,
        "max": 100,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "value": 0,
              "color": "green"
            },
            {
              "value": 1,
              "color": "yellow"
            },
            {
              "value": 5,
              "color": "red"
            }
          ]
        }
      }
    },
    {
      "id": 7,
      "title": "Domain Count by Status",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(mesh_domain_count) by (tenant_id, status)",
          "legendFormat": "{{tenant_id}} - {{status}}",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    }
  ]
}
