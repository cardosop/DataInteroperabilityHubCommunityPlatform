{
  "title": "Webhook Service",
  "tags": [
    "webhook",
    "service"
  ],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Webhook Deliveries",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(webhook_deliveries_total[5m])) by (status, event_type)",
          "legendFormat": "{{status}} {{event_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Webhook Retries",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(webhook_retries_total[5m])) by (attempt)",
          "legendFormat": "Attempt {{attempt}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Webhook Delivery Duration (p95)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(webhook_delivery_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Pending Webhooks",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "webhook_queue_length",
          "legendFormat": "Pending",
          "refId": "A"
        }
      ]
    }
  ]
}
