{
  "title": "Marketplace Sync Jobs Monitoring",
  "tags": [
    "marketplace",
    "sync",
    "jobs",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Sync Job Start Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(marketplace_sync_jobs_total[5m])) by (marketplace_type, direction, status)",
          "legendFormat": "{{marketplace_type}} {{direction}} {{status}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "yaxes": [
        {
          "format": "ops",
          "label": "Jobs/sec"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      },
      "description": "Rate of sync job starts over time, grouped by marketplace type, direction, and status"
    },
    {
      "id": 2,
      "title": "Sync Job Success Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "(sum(rate(marketplace_sync_job_success_rate[5m])) by (marketplace_type, direction) / sum(rate(marketplace_sync_jobs_total[5m])) by (marketplace_type, direction)) * 100",
          "legendFormat": "{{marketplace_type}} {{direction}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "yaxes": [
        {
          "format": "percent",
          "label": "Success Rate",
          "min": 0,
          "max": 100
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      },
      "description": "Success rate percentage of sync jobs by marketplace type and direction"
    },
    {
      "id": 3,
      "title": "Sync Job Duration (P50, P95, P99)",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(marketplace_sync_job_duration_seconds_bucket[5m])) by (marketplace_type, direction, status, le))",
          "legendFormat": "{{marketplace_type}} {{direction}} {{status}} P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(marketplace_sync_job_duration_seconds_bucket[5m])) by (marketplace_type, direction, status, le))",
          "legendFormat": "{{marketplace_type}} {{direction}} {{status}} P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(marketplace_sync_job_duration_seconds_bucket[5m])) by (marketplace_type, direction, status, le))",
          "legendFormat": "{{marketplace_type}} {{direction}} {{status}} P99",
          "refId": "C"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "yaxes": [
        {
          "format": "s",
          "label": "Duration"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      },
      "description": "Sync job duration percentiles showing P50, P95, and P99 latencies"
    },
    {
      "id": 4,
      "title": "Sync Job Status Distribution",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum(marketplace_sync_jobs_total) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "options": {
        "pieType": "pie",
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "visible",
          "placement": "right"
        }
      },
      "description": "Distribution of sync jobs by status (started, completed, failed, partial)"
    },
    {
      "id": 5,
      "title": "Failed Sync Jobs Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(marketplace_sync_jobs_total{status=\"failed\"}[5m])) by (marketplace_type, direction, tenant_id)",
          "legendFormat": "{{marketplace_type}} {{direction}} {{tenant_id}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "yaxes": [
        {
          "format": "ops",
          "label": "Failures/sec"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      },
      "description": "Rate of failed sync jobs over time, grouped by marketplace type and direction"
    },
    {
      "id": 6,
      "title": "Sync Jobs by Direction",
      "type": "bargauge",
      "targets": [
        {
          "expr": "sum(marketplace_sync_jobs_total) by (direction, status)",
          "legendFormat": "{{direction}} {{status}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "description": "Total sync jobs by direction (PUSH, PULL, BIDIRECTIONAL) and status"
    },
    {
      "id": 7,
      "title": "Sync Job Duration by Status",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(marketplace_sync_job_duration_seconds_bucket{status=\"completed\"}[5m])) by (marketplace_type, le))",
          "legendFormat": "{{marketplace_type}} Completed P95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(marketplace_sync_job_duration_seconds_bucket{status=\"failed\"}[5m])) by (marketplace_type, le))",
          "legendFormat": "{{marketplace_type}} Failed P95",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "yaxes": [
        {
          "format": "s",
          "label": "Duration"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      },
      "description": "P95 duration comparison between completed and failed sync jobs"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "marketplace_type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(marketplace_sync_jobs_total, marketplace_type)",
        "includeAll": true,
        "multi": true,
        "allValue": null,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "direction",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(marketplace_sync_jobs_total, direction)",
        "includeAll": true,
        "multi": true,
        "allValue": null,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "tenant_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(marketplace_sync_jobs_total, tenant_id)",
        "includeAll": true,
        "multi": true,
        "allValue": null,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "editable": true,
  "graphTooltip": 0,
  "links": []
}
