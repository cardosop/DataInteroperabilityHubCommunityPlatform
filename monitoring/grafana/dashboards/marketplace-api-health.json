{
  "title": "Marketplace API Health",
  "tags": [
    "marketplace",
    "api",
    "health",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "API Call Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(marketplace_api_calls_total[5m])) by (marketplace_type, endpoint, method, status_code)",
          "legendFormat": "{{marketplace_type}} {{endpoint}} {{method}} {{status_code}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "yaxes": [
        {
          "format": "ops",
          "label": "Calls/sec"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      },
      "description": "Rate of API calls to marketplaces over time, grouped by endpoint, method, and status code"
    },
    {
      "id": 2,
      "title": "API Call Duration (P50, P95, P99)",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(marketplace_api_call_duration_seconds_bucket[5m])) by (marketplace_type, endpoint, method, status_code, le))",
          "legendFormat": "{{marketplace_type}} {{endpoint}} {{method}} {{status_code}} P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(marketplace_api_call_duration_seconds_bucket[5m])) by (marketplace_type, endpoint, method, status_code, le))",
          "legendFormat": "{{marketplace_type}} {{endpoint}} {{method}} {{status_code}} P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(marketplace_api_call_duration_seconds_bucket[5m])) by (marketplace_type, endpoint, method, status_code, le))",
          "legendFormat": "{{marketplace_type}} {{endpoint}} {{method}} {{status_code}} P99",
          "refId": "C"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "yaxes": [
        {
          "format": "s",
          "label": "Duration"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      },
      "description": "API call duration percentiles showing P50, P95, and P99 latencies"
    },
    {
      "id": 3,
      "title": "API Error Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(marketplace_api_call_errors_total[5m])) by (marketplace_type, endpoint, method, error_type)",
          "legendFormat": "{{marketplace_type}} {{endpoint}} {{method}} {{error_type}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "yaxes": [
        {
          "format": "ops",
          "label": "Errors/sec"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      },
      "description": "Rate of API call errors over time, grouped by error type"
    },
    {
      "id": 4,
      "title": "API Call Success Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "(sum(rate(marketplace_api_calls_total{status_code=~\"2..\"}[5m])) by (marketplace_type, endpoint) / sum(rate(marketplace_api_calls_total[5m])) by (marketplace_type, endpoint)) * 100",
          "legendFormat": "{{marketplace_type}} {{endpoint}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "yaxes": [
        {
          "format": "percent",
          "label": "Success Rate",
          "min": 0,
          "max": 100
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      },
      "description": "Success rate percentage of API calls (2xx status codes) by marketplace and endpoint"
    },
    {
      "id": 5,
      "title": "API Calls by Status Code",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum(marketplace_api_calls_total) by (status_code)",
          "legendFormat": "{{status_code}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "options": {
        "pieType": "pie",
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "visible",
          "placement": "right"
        }
      },
      "description": "Distribution of API calls by HTTP status code"
    },
    {
      "id": 6,
      "title": "API Rate Limit Tracking",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(marketplace_api_calls_total{status_code=\"429\"}[5m])) by (marketplace_type, endpoint)",
          "legendFormat": "{{marketplace_type}} {{endpoint}} Rate Limited",
          "refId": "A"
        },
        {
          "expr": "sum(rate(marketplace_api_call_errors_total{error_type=~\".*RateLimit.*|.*429.*\"}[5m])) by (marketplace_type, endpoint)",
          "legendFormat": "{{marketplace_type}} {{endpoint}} Rate Limit Error",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "yaxes": [
        {
          "format": "ops",
          "label": "Rate Limited/sec"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      },
      "description": "Rate of API calls hitting rate limits (429 status codes) and rate limit errors"
    },
    {
      "id": 7,
      "title": "API Calls by Endpoint",
      "type": "table",
      "targets": [
        {
          "expr": "sum(marketplace_api_calls_total) by (marketplace_type, endpoint, method, status_code, tenant_id)",
          "format": "table",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "API calls grouped by marketplace type, endpoint, method, status code, and tenant"
    },
    {
      "id": 8,
      "title": "API Error Percentage",
      "type": "graph",
      "targets": [
        {
          "expr": "(sum(rate(marketplace_api_call_errors_total[5m])) by (marketplace_type, endpoint) / sum(rate(marketplace_api_calls_total[5m])) by (marketplace_type, endpoint)) * 100",
          "legendFormat": "{{marketplace_type}} {{endpoint}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "yaxes": [
        {
          "format": "percent",
          "label": "Error Rate",
          "min": 0,
          "max": 100
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      },
      "description": "Error rate percentage for API calls by marketplace and endpoint"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "marketplace_type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(marketplace_api_calls_total, marketplace_type)",
        "includeAll": true,
        "multi": true,
        "allValue": null,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(marketplace_api_calls_total, endpoint)",
        "includeAll": true,
        "multi": true,
        "allValue": null,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "tenant_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(marketplace_api_calls_total, tenant_id)",
        "includeAll": true,
        "multi": true,
        "allValue": null,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "editable": true,
  "graphTooltip": 0,
  "links": []
}
