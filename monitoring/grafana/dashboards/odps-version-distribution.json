{
  "title": "ODPS Version Distribution",
  "tags": [
    "odps",
    "version",
    "distribution",
    "task-6.2.5"
  ],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "ODPS Version Distribution (Pie Chart)",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(odps_version_distribution_total[24h])) by (version)",
          "legendFormat": "{{version}}",
          "refId": "A"
        }
      ],
      "description": "Distribution of ODPS versions (4.1, 4.0, 3.x, 2.x, 1.x) over last 24 hours"
    },
    {
      "id": 2,
      "title": "ODPS Version Distribution Over Time",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(odps_version_distribution_total[5m])) by (version)",
          "legendFormat": "{{version}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "reqps",
          "label": "Documents/sec"
        },
        {
          "format": "short"
        }
      ],
      "description": "Rate of ODPS documents by version over time"
    },
    {
      "id": 3,
      "title": "ODPS Version Distribution by Tenant",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(increase(odps_version_distribution_total[1h])) by (version, tenant_id)",
          "legendFormat": "{{version}} ({{tenant_id}})",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "short",
          "label": "Documents"
        },
        {
          "format": "short"
        }
      ],
      "description": "ODPS version distribution broken down by tenant"
    },
    {
      "id": 4,
      "title": "ODPS Version Adoption Trend",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(increase(odps_version_distribution_total{version=\"4.1\"}[1h]))",
          "legendFormat": "4.1",
          "refId": "A"
        },
        {
          "expr": "sum(increase(odps_version_distribution_total{version=\"4.0\"}[1h]))",
          "legendFormat": "4.0",
          "refId": "B"
        },
        {
          "expr": "sum(increase(odps_version_distribution_total{version=~\"3\\..*\"}[1h]))",
          "legendFormat": "3.x",
          "refId": "C"
        },
        {
          "expr": "sum(increase(odps_version_distribution_total{version=~\"2\\..*\"}[1h]))",
          "legendFormat": "2.x",
          "refId": "D"
        },
        {
          "expr": "sum(increase(odps_version_distribution_total{version=~\"1\\..*\"}[1h]))",
          "legendFormat": "1.x",
          "refId": "E"
        }
      ],
      "yaxes": [
        {
          "format": "short",
          "label": "Documents"
        },
        {
          "format": "short"
        }
      ],
      "description": "Trend of ODPS version adoption over time"
    },
    {
      "id": 5,
      "title": "ODPS Version Percentage",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(odps_version_distribution_total[5m])) by (version) / sum(rate(odps_version_distribution_total[5m]))",
          "legendFormat": "{{version}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "percentunit",
          "label": "Percentage",
          "min": 0,
          "max": 1
        },
        {
          "format": "short"
        }
      ],
      "description": "Percentage of total ODPS documents by version"
    },
    {
      "id": 6,
      "title": "ODPS Version Heatmap",
      "type": "heatmap",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(odps_version_distribution_total[5m])) by (version, tenant_id)",
          "format": "heatmap",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "short",
          "label": "Version"
        },
        {
          "format": "short"
        }
      ],
      "description": "Heatmap showing ODPS version distribution by tenant"
    }
  ]
}
