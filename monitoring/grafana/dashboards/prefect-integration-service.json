{
  "title": "Prefect Integration Service",
  "tags": [
    "prefect",
    "integration",
    "service"
  ],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"prefect-integration-service\"}[5m])) by (method, route)",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Prefect Deployments Synced",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(prefect_deployments_synced_total[5m]))",
          "legendFormat": "Deployments Synced",
          "refId": "A"
        },
        {
          "expr": "sum(increase(prefect_deployments_failed_total[5m]))",
          "legendFormat": "Deployments Failed",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request Duration (p95)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"prefect-integration-service\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Error Rate",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_errors_total{service=\"prefect-integration-service\"}[5m]))",
          "legendFormat": "Errors/sec",
          "refId": "A"
        }
      ]
    }
  ]
}
