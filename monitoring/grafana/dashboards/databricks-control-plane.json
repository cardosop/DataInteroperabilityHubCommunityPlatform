{
  "title": "Databricks \u2014 Control Plane",
  "uid": "databricks-control-plane",
  "description": "Shared DoD gate (openspec add-databricks-control-plane \u2014 Ops & observability) \u2014 the Databricks control-plane estate rollup: workspace mirror staleness across all three mirrors, the UC change approval pipeline, the SQL-warehouse and job fleets, cost budgets, and DLT updates. Metrics from hub/apps/databricks_admin/metrics.py.",
  "tags": [
    "databricks",
    "control-plane",
    "estate",
    "production"
  ],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Workspaces tracked (UC sync)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "count(databricks_uc_sync_last_success_timestamp)",
          "legendFormat": "workspaces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "UC mirror \u2014 max staleness",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "max(time() - databricks_uc_sync_last_success_timestamp)",
          "legendFormat": "max mirror age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 43200,
                "color": "yellow"
              },
              {
                "value": 129600,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Warehouse mirror \u2014 max staleness",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "max(time() - databricks_warehouse_mirror_last_success_timestamp)",
          "legendFormat": "max mirror age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 43200,
                "color": "yellow"
              },
              {
                "value": 86400,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Jobs mirror \u2014 max staleness",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "max(time() - databricks_jobs_mirror_last_success_timestamp)",
          "legendFormat": "max mirror age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 43200,
                "color": "yellow"
              },
              {
                "value": 86400,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "UC approval backlog",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(databricks_uc_change_pending_approvals)",
          "legendFormat": "pending requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 10,
                "color": "yellow"
              },
              {
                "value": 20,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Oldest pending approval",
      "gridPos": {
        "x": 6,
        "y": 6,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "max(databricks_uc_change_oldest_pending_seconds)",
          "legendFormat": "oldest pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 86400,
                "color": "yellow"
              },
              {
                "value": 259200,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "UC sync runs (24h) by outcome",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(databricks_uc_sync_runs_total[24h]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
