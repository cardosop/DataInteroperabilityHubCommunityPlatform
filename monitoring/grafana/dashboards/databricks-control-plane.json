    {
      "id": 20,
      "type": "stat",
      "title": "Job run failure share (30m)",
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(rate(databricks_job_runs_total{outcome=\"FAILED\"}[30m])) / sum(rate(databricks_job_runs_total[30m]))",
          "legendFormat": "failure share"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              {
                "value": 0,
