      "type": "timeseries",
      "title": "UC sync duration p95",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(databricks_uc_sync_duration_seconds_bucket[6h])))",
          "legendFormat": "p95 sync duration"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
