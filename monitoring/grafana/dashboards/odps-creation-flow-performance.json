  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Creation Flow Duration (P50, P95, P99)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(workflow_execution_duration_seconds_bucket{workflow_name=\"product_creation\"}[5m])) by (tenant_id, le))",
          "legendFormat": "{{tenant_id}} P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(workflow_execution_duration_seconds_bucket{workflow_name=\"product_creation\"}[5m])) by (tenant_id, le))",
          "legendFormat": "{{tenant_id}} P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(workflow_execution_duration_seconds_bucket{workflow_name=\"product_creation\"}[5m])) by (tenant_id, le))",
          "legendFormat": "{{tenant_id}} P99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "barAlignment": 0,
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "insertNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "yaxes": [
        {
          "format": "s",
          "label": "Duration (seconds)"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      },
      "description": "ODPS creation flow duration percentiles (P50, P95, P99) over time. Tracks the time taken to complete the entire product creation workflow."
    },
    {
      "id": 2,
      "title": "Creation Flow Success Rate",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(sum(rate(workflow_instances_completed_total{workflow_name=\"product_creation\", status=\"COMPLETED\"}[5m])) by (tenant_id) / sum(rate(workflow_instances_started_total{workflow_name=\"product_creation\"}[5m])) by (tenant_id)) * 100",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 80,
                "color": "yellow"
              },
              {
                "value": 95,
                "color": "green"
              }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "ODPS creation flow success rate percentage. Calculated as completed workflows / started workflows * 100. Target: >95%"
    },
