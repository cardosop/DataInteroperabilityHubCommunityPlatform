    {
      "id": 23,
      "title": "Business Rules Validation Cache Hit Rate",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 72
      },
      "targets": [
        {
          "expr": "(sum(rate(workflow_business_rules_validation_cache_hits_total[5m])) by (workflow_name, rule_name) / (sum(rate(workflow_business_rules_validation_cache_hits_total[5m])) by (workflow_name, rule_name) + sum(rate(workflow_business_rules_validation_cache_misses_total[5m])) by (workflow_name, rule_name))) * 100",
          "legendFormat": "{{workflow_name}} - {{rule_name}}",
          "refId": "A"
        }
      ],
      "options": {
        "unit": "percent",
        "min": 0,
        "max": 100,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "value": 0,
              "color": "red"
            },
            {
              "value": 50,
              "color": "yellow"
            },
            {
              "value": 80,
              "color": "green"
            }
          ]
        }
      }
    },
    {
      "id": 24,
      "title": "Business Rules Validation by Validation Type",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 72
      },
      "targets": [
        {
          "expr": "sum(rate(workflow_business_rules_validations_total[5m])) by (workflow_name, validation_type, result)",
          "legendFormat": "{{workflow_name}} - {{validation_type}} - {{result}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "ops",
          "label": "Validations/sec"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      }
    },
    {
      "id": 25,
      "title": "Business Rules Validation Failure Rate",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 72
      },
      "targets": [
        {
          "expr": "(sum(rate(workflow_business_rules_validations_total{result=\"invalid\"}[5m])) by (workflow_name, rule_name) / sum(rate(workflow_business_rules_validations_total[5m])) by (workflow_name, rule_name)) * 100",
          "legendFormat": "{{workflow_name}} - {{rule_name}}",
          "refId": "A"
        }
      ],
      "options": {
        "unit": "percent",
        "min": 0,
        "max": 100,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "value": 0,
              "color": "green"
            },
            {
              "value": 5,
              "color": "yellow"
            },
            {
              "value": 10,
              "color": "red"
            }
          ]
        }
      }
