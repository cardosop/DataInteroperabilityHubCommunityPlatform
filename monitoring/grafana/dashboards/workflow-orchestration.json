  ],
  "templating": {
    "list": [
      {
        "name": "workflow_name",
        "type": "query",
        "label": "Workflow Name",
        "datasource": "Prometheus",
        "query": "label_values(workflow_instances_created_total, workflow_name)",
        "multi": true,
        "includeAll": true
      },
      {
        "name": "tenant_id",
        "type": "query",
        "label": "Tenant ID",
        "datasource": "Prometheus",
        "query": "label_values(workflow_instances_created_total, tenant_id)",
        "multi": true,
        "includeAll": true
      }
    ]
  }
}
