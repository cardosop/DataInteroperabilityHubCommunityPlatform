      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 64
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(workflow_business_rules_validation_duration_seconds_bucket[5m])) by (workflow_name, rule_name, validation_type, le))",
          "legendFormat": "{{workflow_name}} - {{rule_name}} - {{validation_type}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "s",
          "label": "Duration"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      }
