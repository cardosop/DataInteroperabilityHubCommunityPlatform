# Developer environment template — generated by `make dev-env`
# DO NOT commit .env.dev to version control; commit only this template.
#
# Passwords are intentionally random per-developer (openssl rand -hex 8).
# Re-run `make dev-env` to regenerate; existing .env.dev will be backed up.

ENVIRONMENT=development
DEBUG=True

# Phase 200: when true, non-MVP /api/v1 areas return 404 and are omitted from OpenAPI (default off for full dev)
# MVP_MODE=false

# Django Settings
SECRET_KEY=__SECRET_KEY__
ALLOWED_HOSTS=localhost,127.0.0.1,api-service
DJANGO_SETTINGS_MODULE=hub.settings

# Database Configuration (must match postgres service in docker-compose.yml)
DATABASE_URL=postgresql://hub:__POSTGRES_PASSWORD__@localhost:5432/hub
POSTGRES_USER=hub
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=hub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_QUEUE_URL=redis://localhost:6380/0
REDIS_EVENTS_URL=redis://localhost:6381/0
REDIS_CHANNELS_URL=redis://localhost:6382/0
REDIS_URL=redis://localhost:6379/0

# S3/MinIO Configuration
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=__MINIO_ROOT_PASSWORD__
AWS_STORAGE_BUCKET_NAME=hub-files
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=__MINIO_ROOT_PASSWORD__

# ClamAV (Phase 203 — malware scan after upload). In Docker Compose use CLAMAV_HOST=clamav; on host use 127.0.0.1 if port 3310 is published.
CLAMAV_ENABLED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Apache Jena Fuseki
FUSEKI_URL=http://localhost:3030
FUSEKI_DATASET=hub
FUSEKI_ADMIN_PASSWORD=__FUSEKI_ADMIN_PASSWORD__

# JWT Configuration
JWT_SECRET_KEY=__JWT_SECRET_KEY__
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800

# Internal service-to-service authentication key.
# shared/auth.py raises ValueError at startup if this is absent — every
# FastAPI microservice (compliance, DQ, semantic) will crash on boot without it.
# Generate a fresh key: openssl rand -hex 32
INTERNAL_API_KEY=__INTERNAL_API_KEY__

# Service URLs
DATACONTRACT_SERVICE_URL=http://localhost:8080
DQ_SERVICE_URL=http://localhost:8083
COMPLIANCE_SERVICE_URL=http://localhost:8082
SEMANTIC_SERVICE_URL=http://localhost:8081
# Phase 21: IRI prefix for per-tenant named graphs in Fuseki.
# All tenant data is stored in GRAPH <${SEMANTIC_TENANT_GRAPH_PREFIX}<tenant_id>>.
SEMANTIC_TENANT_GRAPH_PREFIX=urn:tenant:
# Phase 22: Base IRI for the semantic layer (ontology namespace + resource
# URIs). Override with your own domain in production.
SEMANTIC_BASE_IRI=https://hub.example.com

# Phase 24.6: OWL/RDFS inference (disabled by default).
# When true, Fuseki TDB2 uses an RDFS reasoner (2-5x query latency).
SEMANTIC_INFERENCE_ENABLED=false
# Phase 27: SPARQL query guard-rails
SPARQL_QUERY_TIMEOUT_SECONDS=30
SPARQL_MAX_RESULT_SIZE=10000
SEMANTIC_CACHE_TTL=3600
SHACL_VALIDATION_ENABLED=true
SHACL_VALIDATION_MODE=strict
FUSEKI_TDB_PATH=/fuseki/tdb2

# Contract Standard Versions (Phase 26.10.1)
ODCS_VERSIONS_SUPPORTED=2.2.2,3.0.0,3.0.1,3.0.2,3.1.0
ODPS_VERSIONS_SUPPORTED=1.x,2.x,3.x,4.0,4.1,4.2,bitol-0.9.0,bitol-1.0.0

# Webhook Delivery Settings (Phase 44)
WEBHOOK_RETRY_INTERVALS=1,5,30,300,1800
WEBHOOK_REQUEST_TIMEOUT=30

# Metrics (Phase 52)
DISABLE_METRICS=true

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Rate limiting (relaxed for dev)
RATE_LIMIT_ENABLED=false
MAX_LOGIN_ATTEMPTS=100

# Async polling deadlines (Phase 69)
COMPLIANCE_POLL_MAX_SECONDS=300
DQ_POLL_MAX_SECONDS=300

# Auto-pause after consecutive failures (Phase 71)
MAX_CONSECUTIVE_FAILURES=5
