# Environment Configuration Template
# Copy this file to .env.dev, .env.staging, or .env.production and customize as needed
# DO NOT commit actual secrets to version control

# ==============================================================================
# Database Configuration
# ==============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hub
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub

# ==============================================================================
# PgBouncer — Connection Pooler
# ==============================================================================
# Set PGBOUNCER_ENABLED=true when POSTGRES_HOST points to PgBouncer.
# Django sets CONN_MAX_AGE=0 automatically when this is true (required for
# transaction pooling — persistent connections are incompatible with PgBouncer
# transaction mode).
#
# Production/Staging: set POSTGRES_HOST=pgbouncer and PGBOUNCER_ENABLED=true
# Dev: leave POSTGRES_HOST=postgres and PGBOUNCER_ENABLED=false (or unset)
PGBOUNCER_ENABLED=false
PGBOUNCER_PORT=5433

# Passwords for the pgbouncer role (auth_query user) and pgbouncer_admin role.
# These are injected into both the postgres initdb scripts (to create the roles)
# and the pgbouncer container entrypoint (to generate userlist.txt).
# REQUIRED in production and staging. Generate strong random secrets.
# Example: openssl rand -base64 32
PGBOUNCER_AUTH_PASSWORD=change-me-in-production
PGBOUNCER_ADMIN_PASSWORD=change-me-in-production

# ==============================================================================
# Redis Configuration
# ==============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ==============================================================================
# MinIO/S3 Configuration
# ==============================================================================
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_STORAGE_BUCKET_NAME=hub-files

# ==============================================================================
# CKAN Integration Configuration
# ==============================================================================
# CKAN Dados.gov.br API Key (for production Brazilian government data portal)
# Get your API key from: https://dados.gov.br/api/3/action/user_show
CKAN_DADOS_GOV_BR_API_KEY=

# CKAN Test Configuration
# URL of CKAN instance to use for testing (defaults to demo.ckan.org if not set)
CKAN_TEST_URL=

# CKAN Test API Key (for write operations and integration auth test)
# When unset: push tests expect NotImplementedError; integration authenticate test is skipped
CKAN_TEST_API_KEY=

# ==============================================================================
# Brand (Phase 28.7 Meshant)
# ==============================================================================
# Product name used in UI, emails, OpenAPI, SDKs. Default: Meshant
APP_NAME=Meshant

# ==============================================================================
# Django Configuration
# ==============================================================================
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,api-service
DJANGO_SETTINGS_MODULE=hub.settings

# ==============================================================================
# API Server Concurrency (Gunicorn)
# ==============================================================================
# Number of gunicorn worker processes. Formula: (2 × CPU cores) + 1.
# Dev uses uvicorn --reload (this var has no effect in dev).
# Examples: 1 CPU → 3, 2 CPU → 5, 4 CPU → 9, 8 CPU → 17
# GUNICORN_WORKERS=9

# ==============================================================================
# JWT Configuration
# ==============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800

# ==============================================================================
# Worker API (Scheduled Ingestion & Export Internal)
# ==============================================================================
# Base URL of the hub API service (used by Prefect worker to call hub internal endpoints)
# In Docker Compose: http://api-service:8000
# In Kubernetes: http://api-service.default.svc.cluster.local:8000 (adjust namespace if needed)
HUB_BASE_URL=http://api-service:8000

# API key for Prefect worker to call hub internal endpoints.
# When set, worker authenticates with Authorization: ApiKey <HUB_WORKER_API_KEY>
# and must send X-Tenant-ID on every request.
# Supports scopes: scheduled_ingestion:internal, scheduled_export:internal
# See docs/SCHEDULED_INGESTION_WORKER_API.md and scheduled export internal API docs
# Generate via: python hub/manage.py create_api_key --scopes scheduled_ingestion:internal,scheduled_export:internal
# Or use separate keys: SCHEDULED_EXPORT_WORKER_KEY for export-only workers
HUB_WORKER_API_KEY=

# Optional: Separate API key for scheduled export workers (if different from ingestion workers)
# When set, scheduled export workers can use this key instead of HUB_WORKER_API_KEY
# Same authentication mechanism: Authorization: ApiKey <SCHEDULED_EXPORT_WORKER_KEY> + X-Tenant-ID
SCHEDULED_EXPORT_WORKER_KEY=

# ==============================================================================
# Feature Flags
# ==============================================================================
# Tenant switch (Phase 29.65): when true (default), users can switch active tenant via
# GET /auth/me/tenants/, POST /auth/switch-tenant/, and X-Tenant-Id header.
# Set to false to disable during migration or rollback. See docs/TENANT_SWITCH_PLAN.md
# FEATURE_TENANT_SWITCH_ENABLED=true

# Frontend UX (Phase 29.66.16): baked in at build time. Set to false to disable Toast or Breadcrumbs.
# Passed to frontend Docker build; also used by frontend/.env for local dev. Default: enabled.
# VITE_FEATURE_TOAST_ENABLED=true
# VITE_FEATURE_BREADCRUMBS_ENABLED=true
# VITE_FEATURE_RESOURCE_PICKERS_ENABLED=true

# ==============================================================================
# Billing (Stripe)
# ==============================================================================
# Optional: Stripe secret key (e.g. sk_test_... for test mode). When set, billing
# subscription and customer creation use Stripe; when unset, Stripe-dependent
# tests are skipped. For full billing test coverage, set STRIPE_SECRET_KEY in
# the test environment (e.g. export STRIPE_SECRET_KEY=sk_test_... before running
# batch 16 or phase 12a).
STRIPE_SECRET_KEY=
# Optional: Stripe webhook signing secret (whsec_...) for /api/v1/billing/webhooks/stripe/
STRIPE_WEBHOOK_SECRET=

# ==============================================================================
# Service URLs
# ==============================================================================
DATACONTRACT_SERVICE_URL=http://datacontract-service:8080
DQ_SERVICE_URL=http://dq-service:8083
COMPLIANCE_SERVICE_URL=http://compliance-service:8082
SEMANTIC_SERVICE_URL=http://semantic-service:8081

# ==============================================================================
# Fuseki Configuration
# ==============================================================================
FUSEKI_URL=http://fuseki:3030
FUSEKI_DATASET=hub
FUSEKI_ADMIN_PASSWORD=admin

# ==============================================================================
# OpenTelemetry Configuration
# ==============================================================================
OPENTELEMETRY_ENABLED=true
OPENTELEMETRY_METRICS_ENABLED=true
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
ENVIRONMENT=development
APP_VERSION=1.0.0
