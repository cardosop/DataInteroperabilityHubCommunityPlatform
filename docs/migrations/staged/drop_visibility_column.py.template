from django.db import migrations


class Migration(migrations.Migration):

    # Phase-1 migration (0013_visibility_to_property) already removed
    # the field + index from Django state. Phase-2 is a database-only
    # column drop — no state operation needed.
    dependencies = [
        ("assets", "0013_visibility_to_property"),
    ]

    operations = [
        # Phase-2 is purely a database-side column drop. Django state
        # was already updated in phase-1 via SeparateDatabaseAndState
        # — there is nothing left for Django to "forget" about. Wrap
        # the raw SQL in SeparateDatabaseAndState with empty
        # state_operations to make this contract explicit and
        # prevent Django from auto-detecting any state change.
        #
        # Reverse path re-creates the column with the pre-Phase-1
        # default + NOT NULL constraint, back-filled from ``status``
        # (matches phase-1's reverse SQL semantically). Reversing
        # phase-2 alone leaves the column in the post-phase-1 state;
        # callers that need to fully revert to phase-0 must also
        # reverse phase-1.
        migrations.SeparateDatabaseAndState(
            state_operations=[],
            database_operations=[
                migrations.RunSQL(
                    sql="ALTER TABLE assets DROP COLUMN IF EXISTS visibility;",
                    reverse_sql=(
                        # Recreate the column with the back-fill that
                        # phase-1's reverse_sql also applies, so a
                        # double-reverse (phase-2 then phase-1) lands
                        # on byte-identical pre-Phase-1 state.
                        "ALTER TABLE assets "
                        "ADD COLUMN visibility varchar(20) NULL; "
                        "UPDATE assets SET visibility = CASE "
                        "  WHEN status = 'PUBLIC' THEN 'PUBLIC' "
                        "  ELSE 'INTERNAL' "
                        "END;"
                    ),
                ),
            ],
        ),
    ]
