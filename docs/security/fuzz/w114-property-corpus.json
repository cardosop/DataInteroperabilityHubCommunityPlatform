  "sparql": [
    {
      "query": "SELECT * WHERE { ?s ?p ?o }",
      "expect_valid": true
    },
    {
      "query": "INSERT DATA { <s> <p> <o> }",
      "expect_valid": false,
      "note": "update keyword gate"
    },
    {
      "query": "DROP ALL",
      "expect_valid": false
    },
    {
      "query": "INS#comment\nERT DATA { <s> <p> <o> }",
      "expect_valid": false,
      "note": "obfuscated INSERT dies at the query-type gate"
    },
    {
      "query": "WITH x DELETE { ?s ?p ?o } WHERE { ?s ?p ?o }",
      "expect_valid": false,
      "note": "SPARQL Update delete-where"
    },
    {
      "query": "SELECT * WHERE { SERVICE <http://169.254.169.254/latest/meta-data/> { ?s ?p ?o } }",
      "expect_valid": false,
      "code": "SPARQL_FEDERATION_NOT_ALLOWED",
      "note": "SERVICE without tenant context default-rejects (metadata SSRF probe)"
    },
    {
      "query": "SELECT * WHERE { ?s ?p ?o",
      "expect_valid": false,
      "note": "unbalanced braces"
    },
    {
      "query": "PREFIX ex: <http://ex.org/>\nSELECT * WHERE { ?s ?p ?o }",
      "expect_valid": true,
      "note": "PREFIX stripping must not break valid queries"
    }
  ],
