      "check_definitions": [
        {
          "type": "not_null",
          "column": "col"
        }
      ],
      "expect": "SQLSafetyError",
      "note": "FQN breakout refused"
    },
    {
      "warehouse_type": "snowflake",
      "table_fqn": "db.schema.tbl",
      "check_definitions": [
        {
          "type": "unknown_check_type"
        }
      ],
      "expect": "ok",
      "note": "unknown check types are skipped, never crash"
    },
    {
      "warehouse_type": "snowflake",
      "table_fqn": "db.schema.tbl",
      "check_definitions": [
        {
          "type": "accepted_values",
          "column": "status",
          "values": [
            "a' OR '1'='1",
            "b"
          ]
        }
      ],
      "expect": "ok",
      "note": "accepted-values literals are ANSI-escaped (the compiled SQL carries the doubled quote)"
    }
  ],
