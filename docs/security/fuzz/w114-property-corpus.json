{
  "note": "W11.4 (oss-release-remediation) — the ASVS V5 fuzz corpus. Every entry is a REGRESSION INPUT the Hypothesis property suites found (or a canonical adversarial sample), replayed through the real target by each suite's test_w114_corpus_replay. A change that alters any pinned outcome flips the replay RED.",
  "cents": [
    {
      "input": "19.99",
      "expect_cents": 1999,
      "note": "W2.1 float-artifact regression — int(x*100) truncation charged 1998"
    },
    {
      "input": 19.99,
      "expect_cents": 1999,
      "note": "float coerced via str() shortest-repr"
    },
    {
      "input": "2.235",
      "expect_cents": 224,
      "note": "ROUND_HALF_UP, not banker's HALF_EVEN (224.5 case: banker's gives 224)"
    },
    {
      "input": "-2.235",
      "expect_cents": -224,
      "note": "half-up away from zero on negatives"
    },
    {
      "input": "2.245",
      "expect_cents": 225,
      "note": "the sibling half-cent that banker's rounds to 224"
    },
    {
      "input": "0.005",
      "expect_cents": 1,
      "note": "half-cent rounds up, never truncates to 0"
    },
    {
      "input": "-0.005",
      "expect_cents": -1
    },
    {
      "input": "1e27",
      "expect_cents": 100000000000000000000000000000,
      "note": "W2.9 precision regression — 28+ digit coverage via exponent"
    },
    {
      "input": "inf",
      "expect_error": true,
      "note": "non-finite refused loudly, never crashes"
    },
    {
      "input": "nan",
      "expect_error": true
    },
    {
      "input": true,
      "expect_error": true,
      "note": "bool is not money"
    },
    {
      "input": null,
      "expect_error": true,
      "note": "missing amount never silently becomes 0"
    }
  ],
