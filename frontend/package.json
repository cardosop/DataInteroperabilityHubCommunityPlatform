{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "glob": "^13.0.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:rules": "node e2e/.eslint-rules/run-tests.cjs",
    "lint:e2e:guards": "eslint e2e",
    "i18n:check": "node scripts/check-i18n-keys.cjs",
    "i18n:check:strict": "node scripts/check-i18n-keys.cjs --strict-orphans",
    "i18n:check:hardcoded": "node scripts/check-i18n-hardcoded.cjs --all",
    "i18n:check:hardcoded:test": "node --test scripts/check-i18n-hardcoded.test.cjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "preview": "vite preview",
    "test": "NODE_OPTIONS='--no-webstorage' vitest",
    "test:run": "NODE_OPTIONS='--no-webstorage' vitest --run",
    "test:run:ci": "NODE_OPTIONS='--no-webstorage --max-old-space-size=4096' vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "NODE_OPTIONS='--no-webstorage' vitest --coverage",
    "test:component": "NODE_OPTIONS='--no-webstorage --max-old-space-size=8192' vitest run src/features/ && NODE_OPTIONS='--no-webstorage --max-old-space-size=8192' vitest run src/shared/api/ src/shared/utils/ src/shared/hooks/",
    "test:component:protected-route": "VITEST_NODE_HEAP=16384 NODE_OPTIONS='--no-webstorage --max-old-space-size=32768' vitest run src/shared/components/__tests__/ProtectedRoute.test.tsx",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:coverage:check": "NODE_OPTIONS='--no-webstorage --max-old-space-size=8192' vitest run --coverage",
    "test:integration:api": "bash scripts/run-integration-api-tests.sh",
    "test:e2e": "bash scripts/e2e-detect-api.sh",
    "test:e2e:mvp": "bash scripts/e2e-detect-api.sh --config=playwright.mvp.config.ts --project=chromium-mvp",
    "test:e2e:mvp:visible": "E2E_VISIBLE=1 bash scripts/e2e-detect-api.sh --config=playwright.mvp.config.ts --project=chromium-mvp --project=visible-mvp",
    "test:e2e:full": "bash ../scripts/run-e2e-with-backend.sh",
    "test:e2e:ui": "bash scripts/e2e-detect-api.sh --ui",
    "test:e2e:headed": "bash scripts/e2e-detect-api.sh --headed",
    "test:e2e:debug": "bash scripts/e2e-detect-api.sh --debug",
    "test:e2e:visible": "E2E_VISIBLE=1 bash scripts/e2e-detect-api.sh --project=visible",
    "test:e2e:visible:ui": "E2E_VISIBLE=1 playwright test --ui --project=visible",
    "test:e2e:visible:auth": "E2E_VISIBLE=1 bash scripts/e2e-detect-api.sh --project=visible e2e/auth-visitor-journeys.spec.ts e2e/journeys/auth/",
    "test:e2e:routes": "bash scripts/e2e-detect-api.sh --project=chromium-routes --timeout=120000 e2e/journeys/contracts-odps/ e2e/journeys/marketplace-dc/ e2e/journeys/dq-compliance-governance/ e2e/journeys/mesh-virtualization-search-ai/ e2e/journeys/integrations-jobs-webhooks/ e2e/journeys/admin-audit-settings/ e2e/cross-cutting/alternate-flows-failure.spec.ts",
    "test:e2e:routes:batch1": "bash scripts/e2e-detect-api.sh --project=chromium-routes --timeout=120000 e2e/journeys/contracts-odps/ && bash scripts/e2e-detect-api.sh --project=chromium-routes --timeout=120000 e2e/journeys/marketplace-dc/",
    "test:e2e:routes:batch2": "bash scripts/e2e-detect-api.sh --project=chromium-routes --timeout=120000 e2e/journeys/dq-compliance-governance/ e2e/journeys/mesh-virtualization-search-ai/",
    "test:e2e:routes:batch3": "bash scripts/e2e-detect-api.sh --project=chromium-routes --timeout=120000 e2e/journeys/integrations-jobs-webhooks/ e2e/journeys/admin-audit-settings/ e2e/cross-cutting/alternate-flows-failure.spec.ts",
    "test:e2e:batch1": "bash scripts/e2e-batches.sh 1",
    "test:e2e:batch2": "bash scripts/e2e-batches.sh 2",
    "test:e2e:batch3": "bash scripts/e2e-batches.sh 3",
    "test:e2e:batch4": "bash scripts/e2e-batches.sh 4",
    "test:e2e:batch5": "bash scripts/e2e-batches.sh 5",
    "test:e2e:batch6": "bash scripts/e2e-batches.sh 6",
    "test:e2e:batch7": "bash scripts/e2e-batches.sh 7",
    "test:e2e:batch8": "bash scripts/e2e-batches.sh 8",
    "test:e2e:ux": "bash scripts/e2e-detect-api.sh --project=chromium e2e/use-cases/ux/",
    "test:e2e:batches:list": "bash scripts/e2e-batches.sh list",
    "test:e2e:report": "npx playwright show-report"
  },
  "dependencies": {
    "@dagrejs/dagre": "~2.0.4",
    "@floating-ui/react": "^0.27.19",
    "@sentry/react": "~8.55.0",
    "@stripe/react-stripe-js": "^3.10.0",
    "@stripe/stripe-js": "^4.10.0",
    "@tanstack/react-query": "~5.62.11",
    "@tanstack/react-query-devtools": "~5.62.11",
    "@types/react-window": "~1.8.8",
    "@uiw/codemirror-extensions-langs": "~4.25.8",
    "@uiw/react-codemirror": "~4.25.8",
    "@xyflow/react": "~12.10.1",
    "cmdk": "^1.1.1",
    "dompurify": "~3.3.3",
    "highlight.js": "~11.11.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "~0.577.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.13.2",
    "react-window": "~2.2.5",
    "zustand": "~5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.0",
    "@sentry/vite-plugin": "^5.1.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.4.2",
    "schema-dts": "^1.1.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^2.1.8",
    "vitest-axe": "^0.1.0"
  }
}
