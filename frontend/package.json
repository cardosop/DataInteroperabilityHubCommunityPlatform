{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:run:ci": "NODE_OPTIONS='--max-old-space-size=4096' vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:component": "NODE_OPTIONS='--max-old-space-size=8192' vitest run src/features/ && NODE_OPTIONS='--max-old-space-size=8192' vitest run src/shared/api/ src/shared/utils/ src/shared/hooks/",
    "test:component:protected-route": "VITEST_NODE_HEAP=16384 NODE_OPTIONS='--max-old-space-size=32768' vitest run src/shared/components/__tests__/ProtectedRoute.test.tsx",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:coverage:check": "NODE_OPTIONS='--max-old-space-size=8192' vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:visible": "E2E_VISIBLE=1 playwright test --project=visible",
    "test:e2e:visible:ui": "E2E_VISIBLE=1 playwright test --ui --project=visible",
    "test:e2e:visible:auth": "E2E_VISIBLE=1 playwright test --project=visible e2e/auth-visitor-journeys.spec.ts e2e/journeys/auth/",
    "test:e2e:routes": "playwright test --project=chromium-routes --timeout=120000 e2e/journeys/contracts-odps/ e2e/journeys/marketplace-dc/ e2e/journeys/dq-compliance-governance/ e2e/journeys/mesh-virtualization-search-ai/ e2e/journeys/integrations-jobs-webhooks/ e2e/journeys/admin-audit-settings/ e2e/cross-cutting/alternate-flows-failure.spec.ts",
    "test:e2e:routes:batch1": "playwright test --project=chromium-routes --timeout=120000 e2e/journeys/contracts-odps/ && playwright test --project=chromium-routes --timeout=120000 e2e/journeys/marketplace-dc/",
    "test:e2e:routes:batch2": "playwright test --project=chromium-routes --timeout=120000 e2e/journeys/dq-compliance-governance/ e2e/journeys/mesh-virtualization-search-ai/",
    "test:e2e:routes:batch3": "playwright test --project=chromium-routes --timeout=120000 e2e/journeys/integrations-jobs-webhooks/ e2e/journeys/admin-audit-settings/ e2e/cross-cutting/alternate-flows-failure.spec.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.11",
    "@tanstack/react-query-devtools": "^5.62.11",
    "@types/react-window": "^1.8.8",
    "axios": "^1.7.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.3",
    "react-window": "^2.2.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^2.1.8"
  }
}
