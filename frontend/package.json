{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.sass",
    "**/*.less",
    "src/**/*.css",
    "src/main.tsx",
    "src/vite-env.d.ts"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build": "tsc -b && vite build",
    "build:development": "tsc -b && vite build --mode development",
    "build:staging": "tsc -b && vite build --mode staging",
    "build:production": "tsc -b && vite build --mode production",
    "build:analyze": "ANALYZE=true tsc -b && vite build --mode production",
    "build:analyze:staging": "ANALYZE=true tsc -b && vite build --mode staging",
    "build:check-size": "tsc -b && vite build --mode production && node scripts/check-bundle-size.js",
    "build:check-size:staging": "tsc -b && vite build --mode staging && node scripts/check-bundle-size.js",
    "analyze:imports": "node scripts/analyze-imports.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage --watch",
    "test:coverage:check": "vitest run --coverage && node scripts/check-coverage-thresholds.js",
    "test:coverage:html": "vitest run --coverage && open coverage/index.html",
    "test:unit": "vitest run src/**/*.test.{ts,tsx}",
    "test:component": "vitest run src/**/*.component.test.{ts,tsx}",
    "test:a11y": "vitest run src/**/*.a11y.test.{ts,tsx}",
    "test:a11y:watch": "vitest --watch src/**/*.a11y.test.{ts,tsx}",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:e2e:report": "playwright show-report",
    "test:e2e:dashboard": "node -e \"require('./playwright/utils/test-dashboard').generateTestDashboard([], { outputPath: './playwright/reports/dashboard.html' })\"",
    "test:e2e:codegen": "playwright codegen",
    "test:e2e:install": "playwright install",
    "test:e2e:install-deps": "playwright install-deps",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "graphql:codegen": "graphql-codegen --config codegen.ts",
    "preview": "vite preview",
    "preview:staging": "vite preview --mode staging",
    "preview:production": "vite preview --mode production",
    "prepare": "husky || true",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --project-token=${CHROMATIC_PROJECT_TOKEN:-}",
    "chromatic:ci": "npx chromatic --project-token=${CHROMATIC_PROJECT_TOKEN} --exit-once-uploaded"
  },
  "dependencies": {
    "@apollo/client": "^3.11.2",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@hookform/resolvers": "^3.9.0",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "@sentry/react": "^8.38.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.13.13",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "graphql": "^16.9.0",
    "i18next": "^24.0.0",
    "i18next-browser-languagedetector": "^8.0.1",
    "js-yaml": "^4.1.1",
    "lodash-es": "^4.17.21",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ga4": "^2.1.0",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.1.2",
    "react-router-dom": "^6.28.0",
    "web-vitals": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.0",
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@storybook/addon-a11y": "^10.1.8",
    "@storybook/addon-docs": "^10.1.8",
    "@storybook/addon-onboarding": "^10.1.8",
    "@storybook/addon-vitest": "^10.1.8",
    "@storybook/react-vite": "^10.1.8",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router-dom": "^5.3.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^15.2.11",
    "msw": "^2.12.4",
    "playwright": "^1.57.0",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "storybook": "^10.1.8",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.4.1",
    "vitest": "^4.0.15",
    "vitest-axe": "^0.1.0",
    "ws": "^8.18.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
