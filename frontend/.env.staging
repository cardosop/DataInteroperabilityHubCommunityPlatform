# Staging Environment Configuration
VITE_API_BASE_URL=https://staging-api.datahub.example.com
VITE_WS_URL=wss://staging-api.datahub.example.com
VITE_GRAPHQL_URL=https://staging-api.datahub.example.com/graphql
VITE_API_VERSION=v1
VITE_OPENAPI_SCHEMA_URL=https://staging-api.datahub.example.com/api/v1/openapi.json
VITE_ENV=staging
VITE_DEBUG=false
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_DSN=
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_MARKETPLACE=true
VITE_ENABLE_COMPLIANCE=true
VITE_ENABLE_DATA_QUALITY=true
VITE_ENABLE_SCHEDULED_INGESTION=true
VITE_ENABLE_SEARCH=true
VITE_ENABLE_GOVERNANCE=true
VITE_ENABLE_AI_ML=true
VITE_ENABLE_SOCIAL=true
VITE_ENABLE_DEVELOPER=true
VITE_ENABLE_REACT_QUERY_DEVTOOLS=false
VITE_API_TIMEOUT=30000
VITE_WS_RECONNECT_DELAY=3000
VITE_WS_MAX_RECONNECT_ATTEMPTS=5
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,es,fr
VITE_THEME_MODE=light
VITE_THEME_PERSIST=true
VITE_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100
VITE_ENABLE_PROFILER=false
VITE_ENABLE_API_LOGGING=false
VITE_MOCK_API=false
