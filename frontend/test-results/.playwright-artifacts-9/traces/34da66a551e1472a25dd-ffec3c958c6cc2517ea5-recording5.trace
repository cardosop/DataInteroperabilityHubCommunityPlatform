y: 0.6;\n}\n\n.empty-state-title {\n  margin: 0;\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-primary);\n}\n\n.empty-state-message {\n  margin: 0;\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-base);\n  max-width: 400px;\n}\n\n.empty-state-action {\n  margin-top: var(--spacing-sm);\n  padding: var(--spacing-sm) var(--spacing-lg);\n  background: var(--color-primary);\n  color: var(--color-text-on-primary);\n  border: none;\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-medium);\n  cursor: pointer;\n  transition: background-color 0.2s;\n}\n\n.empty-state-action:hover {\n  background: var(--color-primary-dark);\n}\n\n.empty-state-action:active {\n  background: var(--color-primary-darker);\n}\n"],["STYLE",{},".home-page {\n  padding: var(--spacing-lg);\n  max-width: var(--layout-content-max-width);\n  margin: 0 auto;\n}\n\n.home-header {\n  margin-bottom: var(--spacing-xl);\n}\n\n.header-content {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: var(--spacing-lg);\n}\n\n@media (max-width: 768px) {\n  .header-content {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n}\n\n.home-header h1 {\n  margin: 0 0 var(--spacing-sm) 0;\n  font-size: var(--font-size-2xl);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-primary);\n}\n\n.home-header .subtitle {\n  margin: 0;\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-base);\n}\n\n.system-status-widget {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  padding: var(--spacing-sm) var(--spacing-md);\n  background: var(--color-background-secondary);\n  border: 1px solid var(--color-border);\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-sm);\n}\n\n.system-status-label {\n  color: var(--color-text-secondary);\n  font-weight: var(--font-weight-medium);\n}\n\n.system-status-badge {\n  display: inline-block;\n  padding: var(--spacing-xs) var(--spacing-sm);\n  border-radius: var(--border-radius-sm);\n  font-size: var(--font-size-xs);\n  font-weight: var(--font-weight-semibold);\n  text-transform: uppercase;\n}\n\n.system-status-badge.status-healthy {\n  background: var(--color-success-50);\n  color: var(--color-success-900);\n}\n\n.system-status-badge.status-degraded {\n  background: var(--color-warning-50);\n  color: var(--color-warning-800);\n}\n\n.system-status-badge.status-unhealthy {\n  background: var(--color-error-50);\n  color: var(--color-error-900);\n}\n\n.system-status-badge.status-unknown,\n.system-status-badge.status-loading {\n  background: var(--color-background-secondary);\n  color: var(--color-text-secondary);\n}\n\n.quick-actions {\n  margin-bottom: var(--spacing-xl);\n}\n\n.quick-actions h2 {\n  margin: 0 0 var(--spacing-md) 0;\n  font-size: var(--font-size-xl);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-primary);\n}\n\n.quick-actions-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: var(--spacing-md);\n}\n\n.quick-action-card {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: var(--spacing-lg);\n  background: var(--color-background-secondary);\n  border: 1px solid var(--color-border);\n  border-radius: var(--border-radius-md);\n  text-decoration: none;\n  color: var(--color-text-primary);\n  transition: all 0.2s;\n  min-height: 120px;\n}\n\n.quick-action-card:hover {\n  background: var(--color-background-primary);\n  border-color: var(--color-primary);\n  box-shadow: var(--shadow-md);\n  transform: translateY(-2px);\n}\n\n.quick-action-icon {\n  font-size: 2rem;\n  margin-bottom: var(--spacing-sm);\n}\n\n.quick-action-label {\n  font-weight: var(--font-weight-medium);\n  font-size: var(--font-size-base);\n}\n\n.dashboard-sections {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));\n  gap: var(--spacing-lg);\n}\n\n@media (max-width: 1024px) {\n  .dashboard-sections {\n    grid-template-columns: 1fr;\n  }\n}\n\n.dashboard-section {\n  background: var(--color-background-secondary);\n  padding: var(--spacing-lg);\n  border-radius: var(--border-radius-md);\n  box-shadow: var(--shadow-sm);\n}\n\n.section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--spacing-md);\n}\n\n.section-header h2 {\n  margin: 0;\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-primary);\n}\n\n.section-link {\n  color: var(--color-primary);\n  text-decoration: none;\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n}\n\n.section-link:hover {\n  text-decoration: underline;\n}\n\n.items-list {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-md);\n}\n\n.item-card {\n  display: block;\n  padding: var(--spacing-md);\n  background: var(--color-background-primary);\n  border: 1px solid var(--color-border);\n  border-radius: var(--border-radius-md);\n  text-decoration: none;\n  color: var(--color-text-primary);\n  transition: all 0.2s;\n}\n\n.item-card:hover {\n  border-color: var(--color-primary);\n  box-shadow: var(--shadow-sm);\n}\n\n.item-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--spacing-xs);\n}\n\n.item-title {\n  font-weight: var(--font-weight-semibold);\n  font-size: var(--font-size-base);\n  color: var(--color-text-primary);\n}\n\n.item-description {\n  margin: var(--spacing-xs) 0;\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-sm);\n  line-height: 1.5;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n.item-meta {\n  display: flex;\n  gap: var(--spacing-md);\n  margin-top: var(--spacing-xs);\n  font-size: var(--font-size-xs);\n  color: var(--color-text-secondary);\n}\n\n.item-date,\n.item-domain,\n.item-format,\n.item-score {\n  font-size: var(--font-size-xs);\n  color: var(--color-text-secondary);\n}\n\n.status-badge {\n  display: inline-block;\n  padding: var(--spacing-xs) var(--spacing-sm);\n  border-radius: var(--border-radius-sm);\n  font-size: var(--font-size-xs);\n  font-weight: var(--font-weight-medium);\n  text-transform: uppercase;\n}\n\n.status-badge-success {\n  background: var(--color-success-50);\n  color: var(--color-success-900);\n}\n\n.status-badge-warning {\n  background: var(--color-warning-50);\n  color: var(--color-warning-800);\n}\n\n.status-badge-error {\n  background: var(--color-error-50);\n  color: var(--color-error-900);\n}\n\n.status-badge-default {\n  background: var(--color-background-secondary);\n  color: var(--color-text-secondary);\n}\n"]],[[1,53]],["BODY",{},[[1,54]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},["A",{"href":"#main-content","class":"skip-link"},"Skip to main content"],["HEADER",{"class":"app-header","role":"banner"},["DIV",{"class":"header-content"},["DIV",{"class":"header-left"},["A",{"class":"app-title-link","aria-label":"Meshant — go to home","href":"/","data-discover":"true"},["H1",{"class":"app-title"},"Meshant"]]],["DIV",{"class":"header-center"},["INPUT",{"__playwright_value_":"","placeholder":"Search assets, contracts, datasets...","class":"global-search","aria-label":"Global search","type":"search"}]],["DIV",{"class":"header-right"},["DIV",{"class":"tenant-switcher"},["BUTTON",{"class":"tenant-button","aria-label":"Switch tenant","aria-expanded":"false","aria-haspopup":"true"},["SPAN",{},"b4188ab5-8427-42a6-a577-91411243f1cf"],["SPAN",{"class":"dropdown-arrow"},"▼"]]],["DIV",{"class":"notifications-wrapper"},["BUTTON",{"type":"button","class":"notifications-button","aria-label":"Notifications","aria-expanded":"false","aria-haspopup":"true"},"🔔",["SPAN",{"class":"notification-badge","aria-hidden"