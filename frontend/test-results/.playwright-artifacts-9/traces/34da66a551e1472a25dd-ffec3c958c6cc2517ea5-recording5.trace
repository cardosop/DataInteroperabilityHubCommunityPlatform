--border-radius-md);\n  font-size: var(--font-size-base);\n  background: var(--color-background-primary);\n  color: var(--color-text-primary);\n}\n\n.filter-input {\n  flex: 1;\n  min-width: 200px;\n}\n\n.filter-select {\n  min-width: 150px;\n}\n\n.asset-list-table {\n  background: var(--color-background-primary);\n  border: 1px solid var(--color-border);\n  border-radius: var(--border-radius-md);\n  overflow: hidden;\n}\n\n.asset-list-table table {\n  width: 100%;\n  border-collapse: collapse;\n}\n\n.asset-list-table thead {\n  background: var(--color-background-secondary);\n}\n\n.asset-list-table th {\n  padding: var(--spacing-md);\n  text-align: left;\n  font-weight: var(--font-weight-semibold);\n  font-size: var(--font-size-sm);\n  color: var(--color-text-secondary);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.asset-list-table tbody tr {\n  border-top: 1px solid var(--color-border);\n  transition: background-color 0.2s;\n}\n\n.asset-list-table tbody tr:hover {\n  background: var(--color-background-secondary);\n}\n\n.asset-row {\n  cursor: pointer;\n}\n\n.asset-list-table td {\n  padding: var(--spacing-md);\n  font-size: var(--font-size-base);\n  color: var(--color-text-primary);\n}\n\n.asset-description {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-secondary);\n  margin-top: var(--spacing-xs);\n}\n\n.status-badge,\n.visibility-badge {\n  display: inline-block;\n  padding: 2px 8px;\n  border-radius: var(--border-radius-sm);\n  font-size: var(--font-size-xs);\n  font-weight: var(--font-weight-medium);\n  text-transform: uppercase;\n}\n\n.status-draft {\n  background: var(--color-warning-light);\n  /* --color-warning-dark (#F57C00) on --color-warning-100 (#FFECB3) = 2.3:1 — fails WCAG AA.\n     Use --color-warning-800 (#7D4200) which gives ≥6.5:1 on #FFECB3. */\n  color: var(--color-warning-800);\n}\n\n.status-active {\n  background: var(--color-success-light);\n  /* --color-success-dark (#388E3C) on --color-success-100 (#C8E6C9) = 3.06:1 — fails WCAG AA.\n     Use --color-success-900 (#1B5E20) which gives ≥5.3:1 on #C8E6C9. */\n  color: var(--color-success-900);\n}\n\n.status-retired {\n  background: var(--color-background-tertiary);\n  color: var(--color-text-secondary);\n}\n\n.visibility-internal {\n  background: var(--color-info-light);\n  color: var(--color-info-dark);\n}\n\n.visibility-external {\n  background: var(--color-primary-light);\n  color: var(--color-primary-dark);\n}\n\n.visibility-public {\n  background: var(--color-success-light);\n  color: var(--color-success-dark);\n}\n\n.asset-list-pagination {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: var(--spacing-md);\n  margin-top: var(--spacing-lg);\n}\n\n.asset-list-pagination button {\n  padding: var(--spacing-sm) var(--spacing-md);\n  background: var(--color-background-primary);\n  color: var(--color-text-primary);\n  border: 1px solid var(--color-border);\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-base);\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.asset-list-pagination button:hover:not(:disabled) {\n  background: var(--color-background-secondary);\n  border-color: var(--color-primary);\n}\n\n.asset-list-pagination button:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n"]],[[16,53]],["BODY",{},[[16,54]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[15,10]],[[15,36]],["DIV",{"class":"app-body"},["ASIDE",{"class":"app-sidebar","role":"navigation","aria-label":"Main navigation"},["NAV",{"class":"sidebar-nav"},["UL",{"class":"nav-list"},["LI",{},["A",{"class":"nav-link ","href":"/","data-discover":"true"},[[15,38]],[[15,40]]]],["LI",{},["A",{"__playwright_target__":"call@379","class":"nav-link active","href":"/assets","data-discover":"true","aria-current":"page"},[[15,44]],[[15,46]]]],[[15,54]],[[15,60]],[[15,66]],[[15,72]],[[15,78]],[[15,84]],[[15,90]],[[15,96]],[[15,102]],[[15,108]],[[15,114]],[[15,120]],[[15,126]],[[15,132]],[[15,138]]]]],["