rm: rotate(360deg); }\n}\n\n.loading-spinner-message {\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-sm);\n  margin: 0;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n"],["STYLE",{},".skip-link {\n  position: absolute;\n  top: -40px;\n  left: 0;\n  background: var(--color-primary-600);\n  color: var(--color-text-on-primary);\n  padding: var(--spacing-sm) var(--spacing-md);\n  text-decoration: none;\n  z-index: 1000;\n  border-radius: 0 0 var(--border-radius-sm) 0;\n}\n\n.skip-link:focus {\n  top: 0;\n  outline: 2px solid var(--color-primary-300);\n  outline-offset: 2px;\n}\n"],["STYLE",{},".app-shell {\n  display: flex;\n  flex-direction: column;\n  height: 100vh;\n  overflow: hidden;\n}\n\n.app-body {\n  display: flex;\n  flex: 1;\n  overflow: hidden;\n}\n\n.app-main {\n  flex: 1;\n  max-width: var(--layout-content-max-width);\n  margin: 0 auto;\n  overflow-y: auto;\n  padding: var(--spacing-lg);\n  background-color: var(--color-neutral-50);\n}\n"],["STYLE",{},".app-header {\n  background-color: var(--color-neutral-50);\n  border-bottom: 1px solid var(--color-neutral-200);\n  padding: var(--spacing-md);\n  position: sticky;\n  top: 0;\n  z-index: 100;\n}\n\n.header-content {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  max-width: 100%;\n  gap: var(--spacing-md);\n}\n\n.header-left {\n  flex: 0 0 auto;\n}\n\n.app-title-link {\n  text-decoration: none;\n  display: inline-flex;\n  align-items: center;\n  border-radius: var(--border-radius-sm);\n  outline-offset: 2px;\n}\n\n.app-title-link:hover .app-title {\n  color: var(--color-primary-600);\n}\n\n.app-title {\n  font-size: var(--font-size-xl);\n  font-weight: var(--font-weight-semibold);\n  /* WCAG 2 AA: primary-800 (#0A1F44 Meshant navy) on neutral-50 (#fafafa) ≥ 12:1 */\n  color: var(--color-primary-800);\n  margin: 0;\n  transition: color 0.15s ease;\n}\n\n.header-center {\n  flex: 1 1 auto;\n  max-width: 600px;\n  margin: 0 auto;\n}\n\n.global-search {\n  width: 100%;\n  padding: var(--spacing-sm) var(--spacing-md);\n  border: 1px solid var(--color-neutral-300);\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-base);\n}\n\n.global-search:focus {\n  outline: 2px solid var(--color-primary-500);\n  outline-offset: 2px;\n}\n\n.header-right {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  flex: 0 0 auto;\n}\n\n.tenant-switcher {\n  position: relative;\n}\n\n.tenant-static {\n  padding: var(--spacing-sm) var(--spacing-md);\n  font-size: var(--font-size-sm);\n  color: var(--color-neutral-700);\n}\n\n.tenant-button {\n  padding: var(--spacing-sm) var(--spacing-md);\n  border: 1px solid var(--color-neutral-300);\n  border-radius: var(--border-radius-md);\n  background: var(--color-background-primary);\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-xs);\n}\n\n.tenant-dropdown {\n  position: absolute;\n  top: 100%;\n  right: 0;\n  margin-top: var(--spacing-xs);\n  background: var(--color-background-primary);\n  border: 1px solid var(--color-neutral-300);\n  border-radius: var(--border-radius-md);\n  box-shadow: var(--shadow-lg);\n  min-width: 200px;\n  padding: var(--spacing-md);\n}\n\n.tenant-current {\n  padding-bottom: var(--spacing-sm);\n  border-bottom: 1px solid var(--color-neutral-200);\n  margin-bottom: var(--spacing-sm);\n}\n\n.tenant-option {\n  display: block;\n  width: 100%;\n  padding: var(--spacing-sm) var(--spacing-md);\n  text-align: left;\n  border: none;\n  background: none;\n  cursor: pointer;\n  font-size: var(--font-size-sm);\n  color: var(--color-neutral-800);\n  border-radius: var(--border-radius-sm);\n}\n\n.tenant-option:hover:not(.disabled) {\n  background: var(--color-neutral-100);\n}\n\n.tenant-option.active {\n  background: var(--color-neutral-100);\n  font-weight: var(--font-weight-semibold);\n}\n\n.tenant-option.disabled,\n.tenant-option:disabled {\n  color: var(--color-neutral-500);\n  cursor: not-allowed;\n}\n\n.tenant-error {\n  color: var(--color-error-600);\n  font-size: var(--font-size-sm);\n  padding: var(--spacing-sm) 0;\n}\n\n.notifications-wrapper {\n  position: relative;\n}\n\n.notifications-button {\n  position: relative;\n  padding: var(--spacing-sm);\n  border: none;\n  background: transparent;\n  cursor: pointer;\n  font-size: var(--font-size-xl);\n}\n\n.notifications-dropdown {\n  position: absolute;\n  top: 100%;\n  right: 0;\n  margin-top: var(--spacing-xs);\n  background: var(--color-background-primary);\n  border: 1px solid var(--color-neutral-300);\n  border-radius: var(--border-radius-md);\n  box-shadow: var(--shadow-lg);\n  min-width: 280px;\n  max-width: 360px;\n  padding: var(--spacing-lg);\n  z-index: 50;\n}\n\n.notifications-empty {\n  text-align: center;\n}\n\n.notifications-empty-title {\n  margin: 0 0 var(--spacing-sm);\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-neutral-800);\n}\n\n.notifications-empty-message {\n  margin: 0;\n  font-size: var(--font-size-sm);\n  color: var(--color-neutral-600);\n  line-height: 1.4;\n}\n\n.notification-badge {\n  position: absolute;\n  top: 0;\n  right: 0;\n  background: var(--color-error-500);\n  color: var(--color-text-on-primary);\n  border-radius: var(--border-radius-full);\n  width: 18px;\n  height: 18px;\n  font-size: var(--font-size-xs);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.user-menu {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n}\n\n.user-menu-trigger {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-xs);\n  padding: var(--spacing-sm) var(--spacing-md);\n  border: 1px solid var(--color-neutral-300);\n  border-radius: var(--border-radius-md);\n  background: var(--color-background-primary);\n  cursor: pointer;\n  font-size: var(--font-size-sm);\n}\n\n.user-menu-trigger:hover {\n  background: var(--color-neutral-100);\n}\n\n.user-menu-trigger .dropdown-arrow {\n  font-size: 0.7rem;\n  color: var(--color-neutral-500);\n}\n\n.user-menu-dropdown {\n  position: absolute;\n  top: 100%;\n  right: 0;\n  margin-top: var(--spacing-xs);\n  background: var(--color-background-primary);\n  border: 1px solid var(--color-neutral-300);\n  border-radius: var(--border-radius-md);\n  box-shadow: var(--shadow-lg);\n  min-width: 180px;\n  padding: var(--spacing-xs);\n  z-index: 50;\n}\n\n.user-menu-item {\n  display: block;\n  width: 100%;\n  padding: var(--spacing-sm) var(--spacing-md);\n  text-align: left;\n  border: none;\n  background: none;\n  cursor: pointer;\n  font-size: var(--font-size-sm);\n  color: var(--color-neutral-800);\n  text-decoration: none;\n  border-radius: var(--border-radius-sm);\n}\n\n.user-menu-item:hover {\n  background: var(--color-neutral-100);\n}\n\n.user-menu-logout {\n  border-top: 1px solid var(--color-neutral-200);\n  margin-top: var(--spacing-xs);\n  padding-top: var(--spacing-sm);\n}\n\n.user-name {\n  font-size: var(--font-size-sm);\n  color: var(--color-neutral-700);\n}\n\n.logout-button {\n  padding: var(--spacing-sm) var(--spacing-md);\n  border: 1px solid var(--color-neutral-300);\n  border-radius: var(--border-radius-md);\n  background: var(--color-background-primary);\n  cursor: pointer;\n  font-size: var(--font-size-sm);\n}\n\n.logout-button:hover {\n  background: var(--color-neutral-100);\n}\n"],["STYLE",{},".app-sidebar {\n  width: var(--layout-sidebar-width);\n  background-color: var(--color-neutral-50);\n  border-right: 1px solid var(--color-neutral-200);\n  height: 100%;\n  overflow-y: auto;\n}\n\n.sidebar-nav {\n  padding: var(--spacing-md);\n}\n\n.nav-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n.nav-list li {\n  margin-bottom: var(--spacing-xs);\n}\n\n.nav-link {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  padding: var(--spacing-sm) var(--spacing-md);\n  border-radius: var(--border-radius-md);\n  text-decoration: none;\n  color: var(--color-neutral-700);\n  transition: background-color 0.2s;\n}\n\n.nav-link:hover {\n  background-color: var(--color-neutral-100);\n}\n\n.nav-link.active {\n  background-color: var(--color-primary-50);\n  /* WCAG 2 AA: primary-800 (#0A1F44 Meshant navy) on primary-50 (#E8ECF4) ≥ 10:1 */\n  color: var(--color-primary-800);\n  font-weight: var(--font-weight-medium);\n}\n\n.nav-icon {\n  font-size: var(--font-size-lg);\n}\n\n.nav-label {\n  font-size: var(--font-size-base);\n}\n"],["STYLE",{},".landing-page {\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: var(--spacing-xl);\n  background: linear-gradient(135deg, var(--color-primary-50) 0%, var(--color-secondary-50) 100%);\n}\n\n.landing-hero {\n  text-align: center;\n  margin-bottom: var(--spacing-2xl);\n  max-width: 640px;\n}\n\n.landing-hero-title {\n  font-size: var(--font-size-4xl);\n  font-weight: 700;\n  color: var(--color-primary-800);\n  margin: 0 0 var(--spacing-md);\n  line-height: 1.2;\n}\n\n.landing-hero-subtitle {\n  font-size: var(--font-size-lg);\n  color: var(--color-neutral-700);\n  margin: 0;\n  line-height: 1.5;\n}\n\n.landing-value {\n  margin-bottom: var(--spacing-2xl);\n  max-width: 480px;\n}\n\n.landing-value-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  font-size: var(--font-size-base);\n  color: var(--color-neutral-700);\n  line-height: 1.6;\n}\n\n.landing-value-list li {\n  padding: var(--spacing-xs) 0;\n  padding-left: var(--spacing-lg);\n  position: relative;\n}\n\n.landing-value-list li::before {\n  content: '';\n  position: absolute;\n  left: 0;\n  top: 0.6em;\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--color-primary-500);\n}\n\n.landing-actions {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: var(--spacing-md);\n}\n\n.landing-button {\n  display: inline-block;\n  padding: var(--spacing-md) var(--spacing-xl);\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-medium);\n  text-decoration: none;\n  min-width: 200px;\n  text-align: center;\n  transition: background-color 0.2s, color 0.2s;\n}\n\n.landing-button-primary {\n  background-color: var(--color-primary-700);\n  color: var(--color-text-on-primary);\n}\n\n.landing-button-primary:hover {\n  background-color: var(--color-primary-800);\n  color: var(--color-text-on-primary);\n}\n\n.landing-button-secondary {\n  background-color: var(--color-background-primary);\n  color: var(--color-primary-700);\n  border: 2px solid var(--color-primary-700);\n}\n\n.landing-button-secondary:hover {\n  background-color: var(--color-primary-50);\n  color: var(--color-primary-800);\n}\n\n.landing-link {\n  font-size: var(--font-size-sm);\n  color: var(--color-primary-800);\n  text-decoration: none;\n  margin-top: var(--spacing-sm);\n}\n\n.landing-link:hover {\n  text-decoration: underline;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n"],["STYLE",{},".root-route-loading {\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n"],["STYLE",{},".unavailable-page {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 60vh;\n  padding: var(--spacing-xl);\n}\n\n.unavailable-container {\n  text-align: center;\n  max-width: 600px;\n}\n\n.unavailable-container h1 {\n  color: var(--color-warning-700);\n  margin-bottom: var(--spacing-md);\n}\n\n.unavailable-details {\n  margin-top: var(--spacing-lg);\n  font-weight: var(--font-weight-medium);\n}\n\n.unavailable-container ul {\n  text-align: left;\n  display: inline-block;\n  margin: var(--spacing-md) 0;\n}\n\n.back-link {\n  display: inline-block;\n  margin-top: var(--spacing-lg);\n  padding: var(--spacing-md) var(--spacing-lg);\n  background-color: var(--color-primary-500);\n  color: var(--color-text-on-primary);\n  text-decoration: none;\n  border-radius: var(--border-radius-md);\n  transition: background-color 0.2s;\n}\n\n.back-link:hover {\n  background-color: var(--color-primary-600);\n}\n"],["STYLE",{},"/**\n * Global Styles with Design System Tokens\n */\n\n:root {\n  /* Colors — Meshant palette: primary #0A1F44, secondary #2F6BFF, accent #17C6E6 */\n  --color-primary-50: #E8ECF4;\n  --color-primary-100: #CFD8E8;\n  --color-primary-200: #9BA8C4;\n  --color-primary-300: #6778A0;\n  --color-primary-400: #33497C;\n  --color-primary-500: #0A1F44;\n  --color-primary-600: #081A3A;\n  --color-primary-700: #061530;\n  --color-primary-800: #0A1F44;\n  --color-primary-900: #030D22;\n\n  --color-secondary-50: #EBF0FF;\n  --color-secondary-100: #D6E0FF;\n  --color-secondary-200: #ADBFFF;\n  --color-secondary-300: #849EFF;\n  --color-secondary-400: #5B7DFF;\n  --color-secondary-500: #2F6BFF;\n  --color-secondary-600: #2756E6;\n  --color-secondary-700: #1F41CC;\n  --color-secondary-800: #172DB3;\n  --color-secondary-900: #0F1999;\n\n  --color-accent-50: #E6FAFC;\n  --color-accent-100: #CCF5F9;\n  --color-accent-200: #99EBF3;\n  --color-accent-300: #66E0ED;\n  --color-accent-400: #33D6E7;\n  --color-accent-500: #17C6E6;\n  --color-accent-600: #12A0C0;\n  --color-accent-700: #0E7A9A;\n  --color-accent-800: #095474;\n  --color-accent-900: #052E3D;\n\n  --color-success-50: #E8F5E9;\n  --color-success-100: #C8E6C9;\n  --color-success-500: #4CAF50;\n  --color-success-700: #388E3C;\n  --color-success-900: #1B5E20;\n\n  --color-warning-50: #FFF8E1;\n  --color-warning-100: #FFECB3;\n  --color-warning-500: #FFC107;\n  --color-warning-700: #F57C00;\n  --color-warning-800: #7D4200;\n  --color-warning-900: #E65100;\n\n  --color-error-50: #FFEBEE;\n  --color-error-100: #FFCDD2;\n  --color-error-500: #F44336;\n  --color-error-700: #D32F2F;\n  --color-error-900: #B71C1C;\n\n  --color-neutral-50: #FAFAFA;\n  --color-neutral-100: #F5F5F5;\n  --color-neutral-200: #EEEEEE;\n  --color-neutral-300: #E0E0E0;\n  --color-neutral-400: #BDBDBD;\n  --color-neutral-500: #9E9E9E;\n  --color-neutral-600: #757575;\n  --color-neutral-700: #616161;\n  --color-neutral-800: #424242;\n  --color-neutral-900: #212121;\n\n  /* Spacing */\n  --spacing-xs: 4px;\n  --spacing-sm: 8px;\n  --spacing-md: 16px;\n  --spacing-lg: 24px;\n  --spacing-xl: 32px;\n  --spacing-xxl: 48px;\n  --spacing-2xl: 48px;\n  --spacing-3xl: 64px;\n\n  /* Typography */\n  --font-size-xs: 12px;\n  --font-size-sm: 14px;\n  --font-size-base: 16px;\n  --font-size-lg: 18px;\n  --font-size-xl: 20px;\n  --font-size-xxl: 24px;\n  --font-size-2xl: 24px;\n  --font-size-3xl: 30px;\n  --font-size-4xl: 36px;\n\n  --font-weight-normal: 400;\n  --font-weight-medium: 500;\n  --font-weight-semibold: 600;\n  --font-weight-bold: 700;\n\n  --line-height-tight: 1.25;\n  --line-height-normal: 1.5;\n  --line-height-relaxed: 1.75;\n\n  /* Shadows */\n  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);\n  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\n  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);\n  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);\n\n  /* Layout — Meshant design system */\n  --layout-sidebar-width: 240px;\n  --layout-content-max-width: 1200px;\n\n  /* Border Radius */\n  --border-radius-none: 0;\n  --border-radius-sm: 4px;\n  --border-radius-md: 8px;\n  --border-radius-lg: 12px;\n  --border-radius-xl: 16px;\n  --border-radius-full: 9999px;\n\n  /* Semantic Colors */\n  --color-primary: var(--color-primary-500);\n  --color-primary-dark: var(--color-primary-600);\n  --color-primary-darker: var(--color-primary-700);\n  --color-primary-light: var(--color-primary-100);\n  --color-text-on-primary: #ffffff;\n\n  --color-secondary: var(--color-secondary-500);\n  --color-secondary-dark: var(--color-secondary-600);\n  --color-secondary-light: var(--color-secondary-100);\n\n  --color-accent: var(--color-accent-500);\n  --color-accent-light: var(--color-accent-50);\n\n  --color-success: var(--color-success-500);\n  --color-success-dark: var(--color-success-700);\n  --color-success-light: var(--color-success-100);\n\n  --color-warning: var(--color-warning-500);\n  --color-warning-dark: var(--color-warning-700);\n  --color-warning-light: var(--color-warning-100);\n\n  --color-error: var(--color-error-500);\n  --color-error-dark: var(--color-error-700);\n  --color-error-light: var(--color-error-100);\n\n  --color-info: var(--color-primary-500);\n  --color-info-dark: var(--color-primary-700);\n  --color-info-light: var(--color-primary-100);\n\n  /* Background Colors */\n  --color-background-primary: #ffffff;\n  --color-background-secondary: var(--color-neutral-50);\n  --color-background-tertiary: var(--color-neutral-100);\n  --color-surface: var(--color-background-tertiary);\n\n  /* Text Colors */\n  --color-text-primary: var(--color-neutral-900);\n  --color-text-secondary: var(--color-neutral-700);\n  --color-text-tertiary: var(--color-neutral-600);\n\n  /* Border Colors */\n  --color-border: var(--color-neutral-300);\n  --color-border-light: var(--color-neutral-200);\n\n  /* Font Family (Phase 28.7.3: Inter via Google Fonts) */\n  --font-family-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\n  --font-family-mono: 'Monaco', 'Menlo', 'Consolas', monospace;\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  font-family: var(--font-family-sans);\n  font-size: var(--font-size-base);\n  line-height: var(--line-height-normal);\n  color: var(--color-neutral-900);\n  background-color: var(--color-neutral-50);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\n#root {\n  min-height: 100vh;\n}\n\n/* Accessibility */\n:focus-visible {\n  outline: 2px solid var(--color-primary-500);\n  outline-offset: 2px;\n}\n\n/* Remove default button styles */\nbutton {\n  font-family: inherit;\n}\n\n/* Remove default list styles */\nul, ol {\n  list-style: none;\n}\n"],["STYLE",{},"/**\n * Accessibility Styles\n * WCAG 2.1 AA compliant styles\n */\n\n/* Screen reader only content */\n.sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n\n/* Focus visible styles (already in index.css, but ensure consistency) */\n:focus-visible {\n  outline: 2px solid var(--color-primary-500);\n  outline-offset: 2px;\n  border-radius: 2px;\n}\n\n/* Ensure interactive elements have minimum touch target size (44x44px) */\nbutton,\na,\ninput[type='checkbox'],\ninput[type='radio'],\nselect {\n  min-height: 44px;\n  min-width: 44px;\n}\n\n/* High contrast mode support */\n@media (prefers-contrast: high) {\n  :root {\n    --color-primary-500: #0056b3;\n    --color-text-primary: #000000;\n    --color-text-secondary: #333333;\n  }\n}\n\n/* Reduced motion support */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* Ensure sufficient color contrast for text */\n.text-muted {\n  color: var(--color-text-secondary);\n}\n\n/* Ensure links are distinguishable and meet WCAG 2 AA contrast (4.5:1 on white) */\na:not([class]) {\n  color: var(--color-primary-700);\n  text-decoration: underline;\n}\n\na:not([class]):hover,\na:not([class]):focus {\n  color: var(--color-primary-800);\n  text-decoration: underline;\n}\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"auth-page"},["DIV",{"class":"auth-container"},["H1",{},"Meshant"],["FORM",{"class":"auth-form"},["DIV",{"class":"form-group"},["LABEL",{"for":"email"},"Email"],["INPUT",{