 transform: rotate(360deg); }\n}\n\n.loading-spinner-message {\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-sm);\n  margin: 0;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n"],["STYLE",{},".skip-link {\n  position: absolute;\n  top: -40px;\n  left: 0;\n  background: var(--color-primary-600);\n  color: var(--color-text-on-primary);\n  padding: var(--spacing-sm) var(--spacing-md);\n  text-decoration: none;\n  z-index: 1000;\n  border-radius: 0 0 var(--border-radius-sm) 0;\n}\n\n.skip-link:focus {\n  top: 0;\n  outline: 2px solid var(--color-primary-300);\n  outline-offset: 2px;\n}\n"],["STYLE",{},".app-shell {\n  display: flex;\n  flex-direction: column;\n  height: 100vh;\n  overflow: hidden;\n}\n\n.app-body {\n  display: flex;\n  flex: 1;\n  overflow: hidden;\n}\n\n.app-main {\n  flex: 1;\n  max-width: var(--layout-content-max-width);\n  margin: 0 auto;\n  overflow-y: auto;\n  padding: var(--spacing-lg);\n  background-color: var(--color-neutral-50);\n}\n"],["STYLE",{},".app-header {\n  background-color: var(--color-neutral-50);\n  border-bottom: 1px solid var(--color-neutral-200);\n  padding: var(--spacing-md);\n  position: sticky;\n  top: 0;\n  z-index: 100;\n}\n\n.header-content {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  max-width: 100%;\n  gap: var(--spacing-md);\n}\n\n.header-left {\n  flex: 0 0 auto;\n}\n\n.app-title-link {\n  text-decoration: none;\n  display: inline-flex;\n  align-items: center;\n  border-radius: var(--border-radius-sm);\n  outline-offset: 2px;\n}\n\n.app-title-link:hover .app-title {\n  color: var(--color-primary-600);\n}\n\n.app-title {\n  font-size: var(--font-size-xl);\n  font-weight: var(--font-weight-semibold);\n  /* WCAG 2 AA: primary-800 (#0A1F44 Meshant navy) on neutral-50 (#fafafa) ≥ 12:1 */\n  color: var(--color-primary-800);\n  margin: 0;\n  transition: color 0.15s ease;\n}\n\n.header-center {\n  flex: 1 1 auto;\n  max-width: 600px;\n  margin: 0 auto;\n}\n\n.global-search {\n  width: 100%;\n  padding: var(--spacing-sm) var(--spacing-md);\n  border: 1px solid var(--color-neutral-300);\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-base);\n}\n\n.global-search:focus {\n  outline: 2px solid var(--color-primary-500);\n  outline-offset: 2px;\n}\n\n.header-right {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  flex: 0 0 auto;\n}\n\n.tenant-switcher {\n  position: relative;\n}\n\n.tenant-static {\n  padding: var(--spacing-sm) var(--spacing-md);\n  font-size: var(--font-size-sm);\n  color: var(--color-neutral-700);\n}\n\n.tenant-button {\n  padding: var(--spacing-sm) var(--spacing-md);\n  border: 1px solid var(--color-neutral-300);\n  border-radius: var(--border-radius-md);\n  background: var(--color-background-primary);\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-xs);\n}\n\n.tenant-dropdown {\n  position: absolute;\n  top: 100%;\n  right: 0;\n  margin-top: var(--spacing-xs);\n  background: var(--color-background-primary);\n  border: 1px solid var(--color-neutral-300);\n  border-radius: var(--border-radius-md);\n  box-shadow: var(--shadow-lg);\n  min-width: 200px;\n  padding: var(--spacing-md);\n}\n\n.tenant-current {\n  padding-bottom: var(--spacing-sm);\n  border-bottom: 1px solid var(--color-neutral-200);\n  margin-bottom: var(--spacing-sm);\n}\n\n.tenant-option {\n  display: block;\n  width: 100%;\n  padding: var(--spacing-sm) var(--spacing-md);\n  text-align: left;\n  border: none;\n  background: none;\n  cursor: pointer;\n  font-size: var(--font-size-sm);\n  color: var(--color-neutral-800);\n  border-radius: var(--border-radius-sm);\n}\n\n.tenant-option:hover:not(.disabled) {\n  background: var(--color-neutral-100);\n}\n\n.tenant-option.active {\n  background: var(--color-neutral-100);\