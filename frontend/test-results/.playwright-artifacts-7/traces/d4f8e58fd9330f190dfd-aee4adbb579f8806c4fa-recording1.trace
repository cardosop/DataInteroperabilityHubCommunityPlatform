n.accept-invitation-card {\n  background: var(--color-background-primary);\n  border-radius: 8px;\n  padding: 2rem;\n  max-width: 420px;\n  width: 100%;\n  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);\n}\n\n.accept-invitation-card h1 {\n  margin: 0 0 0.5rem;\n  font-size: 1.5rem;\n  font-weight: 600;\n}\n\n.accept-invitation-description {\n  margin: 0 0 1.5rem;\n  color: var(--color-text-secondary);\n  font-size: 0.95rem;\n}\n\n.accept-invitation-missing-token {\n  padding: 1rem 0;\n}\n\n.accept-invitation-missing-token a {\n  color: var(--color-secondary-500);\n  text-decoration: none;\n}\n\n.accept-invitation-missing-token a:hover {\n  text-decoration: underline;\n}\n\n.accept-invitation-validation-error {\n  color: var(--color-error-700);\n  font-size: 0.9rem;\n  margin: 0 0 1rem;\n}\n\n.accept-invitation-form .form-group {\n  margin-bottom: 1rem;\n}\n\n.accept-invitation-form .form-group label {\n  display: block;\n  margin-bottom: 0.25rem;\n  font-weight: 500;\n  font-size: 0.9rem;\n}\n\n.accept-invitation-form .form-group input {\n  width: 100%;\n  padding: 0.75rem;\n  border: 1px solid #ddd;\n  border-radius: 4px;\n  font-size: 1rem;\n}\n\n.accept-invitation-actions {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n  margin-top: 1.5rem;\n}\n\n.accept-invitation-actions .btn-primary {\n  padding: 0.75rem 1rem;\n  border-radius: 4px;\n  border: none;\n  background: var(--color-secondary-500);\n  color: var(--color-text-on-primary);\n  font-weight: 500;\n  font-size: 1rem;\n  cursor: pointer;\n}\n\n.accept-invitation-actions .btn-primary:hover:not(:disabled) {\n  background: var(--color-secondary-600);\n}\n\n.accept-invitation-actions .btn-primary:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n.link-cancel {\n  text-align: center;\n  color: #666;\n  font-size: 0.9rem;\n  text-decoration: none;\n}\n\n.link-cancel:hover {\n  text-decoration: underline;\n}\n"],["STYLE",{},".auth-page {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 100vh;\n  background: linear-gradient(135deg, var(--color-primary-50) 0%, var(--color-secondary-50) 100%);\n}\n\n.auth-container {\n  background: var(--color-background-primary);\n  padding: var(--spacing-2xl);\n  border-radius: var(--border-radius-lg);\n  box-shadow: var(--shadow-xl);\n  width: 100%;\n  max-width: 420px;\n}\n\n.auth-container h1 {\n  text-align: center;\n  margin-bottom: var(--spacing-xl);\n  color: var(--color-primary-700);\n}\n\n.auth-form {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-md);\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-xs);\n}\n\n.form-group label {\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-neutral-700);\n}\n\n.form-group input {\n  padding: var(--spacing-sm) var(--spacing-md);\n  border: 1px solid var(--color-neutral-300);\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-base);\n}\n\n.form-group input:focus {\n  outline: 2px solid var(--color-primary-500);\n  outline-offset: 2px;\n}\n\n.error-message {\n  padding: var(--spacing-sm) var(--spacing-md);\n  background-color: var(--color-error-50);\n  color: var(--color-error-700);\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-sm);\n}\n\n.success-message {\n  padding: var(--spacing-sm) var(--spacing-md);\n  background-color: var(--color-success-50);\n  color: var(--color-success-700);\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-sm);\n}\n\n/* WCAG 2 AA: 4.5:1 contrast for normal text; primary-700/800 meet threshold */\n.auth-button {\n  padding: var(--spacing-md);\n  background-color: var(--color-primary-700);\n  color: var(--color-text-on-primary);\n  border: none;\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-medium);\n  cursor: pointer;\n  transition: background-color 0.2s;\n}\n\n.auth-bu