lute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  font-weight: 600;\n  color: #333;\n  font-size: 0.9rem;\n}\n\n.current-step {\n  font-style: italic;\n  color: #888;\n}\n\n.workflow-completed {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 1rem;\n}\n\n.success-icon {\n  font-size: 4rem;\n  color: var(--color-success-500);\n}\n\n.workflow-completed h3 {\n  margin: 0;\n  color: var(--color-success-700);\n}\n\n.created-contract-id {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  margin: 0.5rem 0;\n}\n\n.created-contract-id .uuid-with-copy {\n  flex: 1;\n}\n\n.created-contracts {\n  text-align: left;\n  background: var(--color-background-secondary);\n  padding: 1rem;\n  border-radius: 4px;\n  margin: 1rem 0;\n}\n\n.created-contracts p {\n  margin: 0.5rem 0;\n}\n\n.btn-link {\n  background: none;\n  border: none;\n  color: var(--color-info);\n  text-decoration: underline;\n  cursor: pointer;\n  font-size: inherit;\n}\n\n.btn-link:hover {\n  color: var(--color-info-dark);\n}\n\n.workflow-failed {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 1rem;\n}\n\n.error-icon {\n  font-size: 4rem;\n  color: var(--color-error-700);\n}\n\n.workflow-failed h3 {\n  margin: 0;\n  color: var(--color-error-700);\n}\n\n.workflow-failed p {\n  color: #666;\n}\n"]],[[10,53]],["BODY",{},[[10,54]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},["A",{"href":"#main-content","class":"skip-link"},"Skip to main content"],["HEADER",{"class":"app-header","role":"banner"},["DIV",{"class":"header-content"},["DIV",{"class":"header-left"},["A",{"class":"app-title-link","aria-label":"Meshant — go to home","href":"/","data-discover":"true"},["H1",{"class":"app-title"},"Meshant"]]],["DIV",{"class":"header-center"},["INPUT",{"__playwright_value_":"","placeholder":"Search assets, contracts, datasets...","class":"global-search","aria-label":"Global search","type":"search"}]],["DIV",{"class":"header-right"},["DIV