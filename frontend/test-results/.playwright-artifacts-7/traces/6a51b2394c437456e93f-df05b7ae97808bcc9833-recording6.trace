atus-badge {\n  display: inline-block;\n  padding: 0.25rem 0.75rem;\n  border-radius: 12px;\n  font-size: 0.85rem;\n  font-weight: 600;\n}\n\n.status-normalized-ok {\n  background: var(--color-success-50);\n  color: var(--color-success-700);\n}\n\n.status-normalized-with-warnings {\n  background: var(--color-warning-50);\n  color: var(--color-warning-700);\n}\n\n.status-normalization-failed {\n  background: var(--color-error-50);\n  color: var(--color-error-700);\n}\n\n.status-not-normalized {\n  background: var(--color-neutral-100);\n  color: var(--color-neutral-600);\n}\n\n.action-buttons {\n  display: flex;\n  gap: 0.5rem;\n}\n\n.btn-link {\n  background: none;\n  border: none;\n  color: var(--color-info);\n  text-decoration: underline;\n  cursor: pointer;\n  font-size: 0.9rem;\n  padding: 0;\n}\n\n.btn-link:hover {\n  color: var(--color-info-dark);\n}\n"]],[[18,53]],["BODY",{},[[18,54]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},[[16,6]],[[16,32]],["DIV",{"class":"app-body"},["ASIDE",{"class":"app-sidebar","role":"navigation","aria-label":"Main navigation"},["NAV",{"class":"sidebar-nav"},["UL",{"class":"nav-list"},["LI",{},["A",{"class":"nav-link ","href":"/","data-discover":"true"},[[16,34]],[[16,36]]]],[[16,44]],[[16,50]],[[16,56]],[[16,62]],[[16,68]],[[16,74]],["LI",{},["A",{"__playwright_target__":"call@399","class":"nav-link active","href":"/odps","data-discover":"true","aria-current":"page"},[[16,76]],[[16,78]]]],[[16,86]],[[16,92]],[[16,98]],[[16,104]],[[16,110]],[[16,116]],[[16,122]],[[16,128]],[[16,134]]]]],["MAIN",{"class":"app-main","role":"main","id":"main-content","tabindex":"-1"},["DIV",{"class":"loading-spinner-container","role":"status","aria-live":"polite","aria-label":"Loading ODPS contracts..."},["DIV",{"class":"loading-spinner loading-spinner-medium","aria-hidden":"true"}],["P",{"class":"loading-spinner-message"},"Loading ODPS contracts..."]]]]],[[18,60]],[[17,346]]],[[18,63]],[[18,64]]]],"viewport":{"width":1280,"height":720},"timesta