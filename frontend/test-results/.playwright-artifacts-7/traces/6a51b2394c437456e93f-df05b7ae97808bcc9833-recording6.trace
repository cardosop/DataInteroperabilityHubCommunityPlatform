 24px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.toast-close:hover {\n  color: var(--color-text-primary);\n}\n"],["STYLE",{},".error-display {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: var(--spacing-xl);\n  gap: var(--spacing-md);\n  text-align: center;\n  background: var(--color-background-secondary);\n  border: 1px solid var(--color-border);\n  border-radius: var(--border-radius-md);\n}\n\n.error-display-icon {\n  font-size: 48px;\n  line-height: 1;\n}\n\n.error-display-title {\n  margin: 0;\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-primary);\n}\n\n.error-display-message {\n  margin: 0;\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-base);\n}\n\n.error-display-code,\n.error-display-request-id {\n  margin: 0;\n  font-size: var(--font-size-sm);\n  color: var(--color-text-tertiary);\n}\n\n.error-display-code code,\n.error-display-request-id code {\n  background: var(--color-background-tertiary);\n  padding: 2px 6px;\n  border-radius: var(--border-radius-sm);\n  font-family: var(--font-family-mono);\n  font-size: var(--font-size-xs);\n}\n\n.error-display-retry {\n  margin-top: var(--spacing-sm);\n  padding: var(--spacing-sm) var(--spacing-md);\n  background: var(--color-primary);\n  color: var(--color-text-on-primary);\n  border: none;\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-medium);\n  cursor: pointer;\n  transition: background-color 0.2s;\n}\n\n.error-display-retry:hover {\n  background: var(--color-primary-dark);\n}\n\n.error-display-retry:active {\n  background: var(--color-primary-darker);\n}\n"],["STYLE",{},".accept-invitation-page {\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 2rem;\n  background: var(--color-background-secondary);\n}\n\n.accept-invitation-card {\n  background: var(--color-background-primary);\n  border-radius: 8px;\n  padding: 2rem;\n  max-width: 420px;\n  width: 100%;\n  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);\n}\n\n.accept-invitation-card h1 {\n  margin: 0 0 0.5rem;\n  font-size: 1.5rem;\n  font-weight: 600;\n}\n\n.accept-invitation-description {\n  margin: 0 0 1.5rem;\n  color: var(--color-text-secondary);\n  font-size: 0.95rem;\n}\n\n.accept-invitation-missing-token {\n  padding: 1rem 0;\n}\n\n.accept-invitation-missing-token a {\n  color: var(--color-secondary-500);\n  text-decoration: none;\n}\n\n.accept-invitation-missing-token a:hover {\n  text-decoration: underline;\n}\n\n.accept-invitation-validation-error {\n  color: var(--color-error-700);\n  font-size: 0.9rem;\n  margin: 0 0 1rem;\n}\n\n.accept-invitation-form .form-group {\n  margin-bottom: 1rem;\n}\n\n.accept-invitation-form .form-group label {\n  display: block;\n  margin-bottom: 0.25rem;\n  font-weight: 500;\n  font-size: 0.9rem;\n}\n\n.accept-invitation-form .form-group input {\n  width: 100%;\n  padding: 0.75rem;\n  border: 1px solid #ddd;\n  border-radius: 4px;\n  font-size: 1rem;\n}\n\n.accept-invitation-actions {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n  margin-top: 1.5rem;\n}\n\n.accept-invitation-actions .btn-primary {\n  padding: 0.75rem 1rem;\n  border-radius: 4px;\n  border: none;\n  background: var(--color-secondary-500);\n  color: var(--color-text-on-primary);\n  font-weight: 500;\n  font-size: 1rem;\n  cursor: pointer;\n}\n\n.accept-invitation-actions .btn-primary:hover:not(:disabled) {\n  background: var(--color-secondary-600);\n}\n\n.accept-invitation-actions .btn-primary:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n.link-cancel {\n  text-align: center;\n  color: #666;\n  font-size: 0.9rem;\n  text-decoration: none;\n}\n\n.link-cancel:hover {\n  text-decoration: underline;\n}\n"],["STYLE",{},".auth-page {\n  display: flex;\n  align-items: center;\n  justify-content: c