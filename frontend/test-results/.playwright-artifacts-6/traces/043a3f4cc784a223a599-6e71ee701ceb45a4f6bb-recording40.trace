argin: var(--spacing-md) 0;\n}\n\n.back-link {\n  display: inline-block;\n  margin-top: var(--spacing-lg);\n  padding: var(--spacing-md) var(--spacing-lg);\n  background-color: var(--color-primary-500);\n  color: var(--color-text-on-primary);\n  text-decoration: none;\n  border-radius: var(--border-radius-md);\n  transition: background-color 0.2s;\n}\n\n.back-link:hover {\n  background-color: var(--color-primary-600);\n}\n"],["STYLE",{},"/**\n * Global Styles with Design System Tokens\n */\n\n:root {\n  /* Colors — Meshant palette: primary #0A1F44, secondary #2F6BFF, accent #17C6E6 */\n  --color-primary-50: #E8ECF4;\n  --color-primary-100: #CFD8E8;\n  --color-primary-200: #9BA8C4;\n  --color-primary-300: #6778A0;\n  --color-primary-400: #33497C;\n  --color-primary-500: #0A1F44;\n  --color-primary-600: #081A3A;\n  --color-primary-700: #061530;\n  --color-primary-800: #0A1F44;\n  --color-primary-900: #030D22;\n\n  --color-secondary-50: #EBF0FF;\n  --color-secondary-100: #D6E0FF;\n  --color-secondary-200: #ADBFFF;\n  --color-secondary-300: #849EFF;\n  --color-secondary-400: #5B7DFF;\n  --color-secondary-500: #2F6BFF;\n  --color-secondary-600: #2756E6;\n  --color-secondary-700: #1F41CC;\n  --color-secondary-800: #172DB3;\n  --color-secondary-900: #0F1999;\n\n  --color-accent-50: #E6FAFC;\n  --color-accent-100: #CCF5F9;\n  --color-accent-200: #99EBF3;\n  --color-accent-300: #66E0ED;\n  --color-accent-400: #33D6E7;\n  --color-accent-500: #17C6E6;\n  --color-accent-600: #12A0C0;\n  --color-accent-700: #0E7A9A;\n  --color-accent-800: #095474;\n  --color-accent-900: #052E3D;\n\n  --color-success-50: #E8F5E9;\n  --color-success-100: #C8E6C9;\n  --color-success-500: #4CAF50;\n  --color-success-700: #388E3C;\n  --color-success-900: #1B5E20;\n\n  --color-warning-50: #FFF8E1;\n  --color-warning-100: #FFECB3;\n  --color-warning-500: #FFC107;\n  --color-warning-700: #F57C00;\n  --color-warning-800: #7D4200;\n  --color-warning-900: #E65100;\n\n  --color-error-50: #FFEBEE;\n  --color-error-100: #FFCDD2;\n  --color-error-500: #F44336;\n  --color-error-700: #D32F2F;\n  --color-error-900: #B71C1C;\n\n  --color-neutral-50: #FAFAFA;\n  --color-neutral-100: #F5F5F5;\n  --color-neutral-200: #EEEEEE;\n  --color-neutral-300: #E0E0E0;\n  --color-neutral-400: #BDBDBD;\n  --color-neutral-500: #9E9E9E;\n  --color-neutral-600: #757575;\n  --color-neutral-700: #616161;\n  --color-neutral-800: #424242;\n  --color-neutral-900: #212121;\n\n  /* Spacing */\n  --spacing-xs: 4px;\n  --spacing-sm: 8px;\n  --spacing-md: 16px;\n  --spacing-lg: 24px;\n  --spacing-xl: 32px;\n  --spacing-xxl: 48px;\n  --spacing-2xl: 48px;\n  --spacing-3xl: 64px;\n\n  /* Typography */\n  --font-size-xs: 12px;\n  --font-size-sm: 14px;\n  --font-size-base: 16px;\n  --font-size-lg: 18px;\n  --font-size-xl: 20px;\n  --font-size-xxl: 24px;\n  --font-size-2xl: 24px;\n  --font-size-3xl: 30px;\n  --font-size-4xl: 36px;\n\n  --font-weight-normal: 400;\n  --font-weight-medium: 500;\n  --font-weight-semibold: 600;\n  --font-weight-bold: 700;\n\n  --line-height-tight: 1.25;\n  --line-height-normal: 1.5;\n  --line-height-relaxed: 1.75;\n\n  /* Shadows */\n  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);\n  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\n  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);\n  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);\n\n  /* Layout — Meshant design system */\n  --layout-sidebar-width: 240px;\n  --layout-content-max-width: 1200px;\n\n  /* Border Radius */\n  --border-radius-none: 0;\n  --border-radius-sm: 4px;\n  --border-radius-md: 8px;\n  --border-radius-lg: 12px;\n  --border-radius-xl: 16px;\n  --border-radius-full: 9999px;\n\n  /* Semantic Colors */\n  --color-primary: var(--color-primary-500);\n  --color-primary-dark: var(--color-primary-600);\n  --color-primary-darker: var(--color-primary-700);\n  --color-primary-light: var(--color-primary-100);\n  --color-text-on-primary: #ffffff;\n\n  --color-secondary: var(--color-secondary-500);\n  --color-secondary-dark: var(--color-secondary-600);\n  --color-secondary-light: var(--color-secondary-100);\n\n  --color-accent: var(--color-accent-500);\n  --color-accent-light: var(--color-accent-50);\n\n  --color-success: var(--color-success-500);\n  --color-success-dark: var(--color-success-700);\n  --color-success-light: var(--color-success-100);\n\n  --color-warning: var(--color-warning-500);\n  --color-warning-dark: var(--color-warning-700);\n  --color-warning-light: var(--color-warning-100);\n\n  --color-error: var(--color-error-500);\n  --color-error-dark: var(--color-error-700);\n  --color-error-light: var(--color-error-100);\n\n  --color-info: var(--color-primary-500);\n  --color-info-dark: var(--color-primary-700);\n  --color-info-light: var(--color-primary-100);\n\n  /* Background Colors */\n  --color-background-primary: #ffffff;\n  --color-background-secondary: var(--color-neutral-50);\n  --color-background-tertiary: var(--color-neutral-100);\n  --color-surface: var(--color-background-tertiary);\n\n  /* Text Colors */\n  --color-text-primary: var(--color-neutral-900);\n  --color-text-secondary: var(--color-neutral-700);\n  --color-text-tertiary: var(--color-neutral-600);\n\n  /* Border Colors */\n  --color-border: var(--color-neutral-300);\n  --color-border-light: var(--color-neutral-200);\n\n  /* Font Family (Phase 28.7.3: Inter via Google Fonts) */\n  --font-family-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\n  --font-family-mono: 'Monaco', 'Menlo', 'Consolas', monospace;\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  font-family: var(--font-family-sans);\n  font-size: var(--font-size-base);\n  line-height: var(--line-height-normal);\n  color: var(--color-neutral-900);\n  background-color: var(--color-neutral-50);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\n#root {\n  min-height: 100vh;\n}\n\n/* Accessibility */\n:focus-visible {\n  outline: 2px solid var(--color-primary-500);\n  outline-offset: 2px;\n}\n\n/* Remove default button styles */\nbutton {\n  font-family: inherit;\n}\n\n/* Remove default list styles */\nul, ol {\n  list-style: none;\n}\n"],["STYLE",{},"/**\n * Accessibility Styles\n * WCAG 2.1 AA compliant styles\n */\n\n/* Screen reader only content */\n.sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n\n/* Focus visible styles (already in index.css, but ensure consistency) */\n:focus-visible {\n  outline: 2px solid var(--color-primary-500);\n  outline-offset: 2px;\n  border-radius: 2px;\n}\n\n/* Ensure interactive elements have minimum touch target size (44x44px) */\nbutton,\na,\ninput[type='checkbox'],\ninput[type='radio'],\nselect {\n  min-height: 44px;\n  min-width: 44px;\n}\n\n/* High contrast mode support */\n@media (prefers-contrast: high) {\n  :root {\n    --color-primary-500: #0056b3;\n    --color-text-primary: #000000;\n    --color-text-secondary: #333333;\n  }\n}\n\n/* Reduced motion support */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* Ensure sufficient color contrast for text */\n.text-muted {\n  color: var(--color-text-secondary);\n}\n\n/* Ensure links are distinguishable and meet WCAG 2 AA contrast (4.5:1 on white) */\na:not([class]) {\n  color: var(--color-primary-700);\n  text-decoration: underline;\n}\n\na:not([class]):hover,\na:not([class]):focus {\n  color: var(--color-primary-800);\n  text-decoration: underline;\n}\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"auth-page"},["DIV",{"class":"auth-container"},["H1",{},"Meshant"],["FORM",{"class":"auth-form"},["DIV",{"class":"form-group"},["LABEL",{"for":"email"},"Email"],["INPUT"