e-sm);\n  text-transform: uppercase;\n  color: var(--color-text-secondary);\n}\n\n.entitlement-list-table td {\n  padding: var(--spacing-md);\n  border-top: var(--border-width) solid var(--color-border);\n}\n\n.entitlement-row {\n  cursor: pointer;\n  transition: background-color 0.2s ease;\n}\n\n.entitlement-row:hover {\n  background: var(--color-gray-light);\n}\n\n.entitlement-status {\n  padding: var(--spacing-xs) var(--spacing-sm);\n  border-radius: var(--border-radius-sm);\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  text-transform: uppercase;\n}\n\n.entitlement-status-active {\n  background: var(--color-success-light);\n  color: var(--color-success-dark);\n}\n\n.entitlement-status-revoked {\n  background: var(--color-error-light);\n  color: var(--color-error-dark);\n}\n\n.entitlement-status-expired {\n  background: var(--color-gray-light);\n  color: var(--color-gray-dark);\n}\n\n.entitlement-list-pagination {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: var(--spacing-md);\n  margin-top: var(--spacing-lg);\n}\n\n.pagination-info {\n  color: var(--color-text-secondary);\n}\n\n.btn-link {\n  background: none;\n  border: none;\n  color: var(--color-primary);\n  cursor: pointer;\n  font-size: var(--font-size-sm);\n  text-decoration: underline;\n}\n\n.btn-link:hover {\n  color: var(--color-primary-dark);\n}\n"]],[[1,53]],["BODY",{},[[1,54]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},["A",{"href":"#main-content","class":"skip-link"},"Skip to main content"],["HEADER",{"class":"app-header","role":"banner"},["DIV",{"class":"header-content"},["DIV",{"class":"header-left"},["A",{"class":"app-title-link","aria-label":"Meshant — go to home","href":"/","data-discover":"true"},["H1",{"class":"app-title"},"Meshant"]]],["DIV",{"class":"header-center"},["INPUT",{"__playwright_value_":"","placeholder":"Search assets, contracts, datasets...","class":"global-search","aria-label":"Global search","type":"sear