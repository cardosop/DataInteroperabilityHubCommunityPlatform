ackground-color 0.2s;\n}\n\n.auth-button:hover:not(:disabled) {\n  background-color: var(--color-primary-800);\n}\n\n.auth-button:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n.auth-links {\n  margin-top: var(--spacing-lg);\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-sm);\n  font-size: var(--font-size-sm);\n  color: var(--color-neutral-700);\n}\n\n.auth-links a {\n  color: var(--color-primary-800);\n  text-decoration: none;\n}\n\n.auth-links a:hover {\n  text-decoration: underline;\n}\n\n"],["STYLE",{},".org-onboarding-page .org-onboarding-container {\n  max-width: 440px;\n}\n\n.org-onboarding-subtitle {\n  text-align: center;\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-sm);\n  margin: calc(-1 * var(--spacing-md)) 0 var(--spacing-lg) 0;\n}\n\n.form-hint {\n  font-size: var(--font-size-xs);\n  color: var(--color-text-secondary);\n  margin-top: var(--spacing-xs);\n}\n\n.optional {\n  color: var(--color-neutral-500);\n  font-weight: normal;\n}\n\n.org-onboarding-footer {\n  margin-top: var(--spacing-lg);\n  text-align: center;\n  font-size: var(--font-size-sm);\n  color: var(--color-text-secondary);\n}\n\n.org-onboarding-footer a {\n  color: var(--color-primary);\n  text-decoration: none;\n}\n\n.org-onboarding-footer a:hover {\n  text-decoration: underline;\n}\n"],["STYLE",{},".loading-spinner-container {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: var(--spacing-xl);\n  gap: var(--spacing-md);\n}\n\n.loading-spinner {\n  border: 3px solid var(--color-border-light);\n  border-top: 3px solid var(--color-primary);\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n}\n\n.loading-spinner-small {\n  width: 24px;\n  height: 24px;\n  border-width: 2px;\n}\n\n.loading-spinner-medium {\n  width: 40px;\n  height: 40px;\n}\n\n.loading-spinner-large {\n  width: 64px;\n  height: 64px;\n  border-width: 4px;\n}\n\n@keyframes spin {\n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}\n\n.loading-spinner-message {\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-sm);\n  margin: 0;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n"],["STYLE",{},".skip-link {\n  position: absolute;\n  top: -40px;\n  left: 0;\n  background: var(--color-primary-600);\n  color: var(--color-text-on-primary);\n  padding: var(--spacing-sm) var(--spacing-md);\n  text-decoration: none;\n  z-index: 1000;\n  border-radius: 0 0 var(--border-radius-sm) 0;\n}\n\n.skip-link:focus {\n  top: 0;\n  outline: 2px solid var(--color-primary-300);\n  outline-offset: 2px;\n}\n"],["STYLE",{},".app-shell {\n  display: flex;\n  flex-direction: column;\n  height: 100vh;\n  overflow: hidden;\n}\n\n.app-body {\n  display: flex;\n  flex: 1;\n  overflow: hidden;\n}\n\n.app-main {\n  flex: 1;\n  max-width: var(--layout-content-max-width);\n  margin: 0 auto;\n  overflow-y: auto;\n  padding: var(--spacing-lg);\n  background-color: var(--color-neutral-50);\n}\n"],["STYLE",{},".app-header {\n  background-color: var(--color-neutral-50);\n  border-bottom: 1px solid var(--color-neutral-200);\n  padding: var(--spacing-md);\n  position: sticky;\n  top: 0;\n  z-index: 100;\n}\n\n.header-content {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  max-width: 100%;\n  gap: var(--spacing-md);\n}\n\n.header-left {\n  flex: 0 0 auto;\n}\n\n.app-title-link {\n  text-decoration: none;\n  display: inline-flex;\n  align-items: center;\n  border-radius: var(--border-radius-sm);\n  outline-offset: 2px;\n}\n\n.app-title-link:hover .app-title {\n  color: var(--color-primary-600);\n}\n\n.app-title {\n  font-size: var(--font-size-xl);\n  font-weight: var(--font-weight-semibold);\n  /* WCAG 2 AA: primary-800 (#0A1F44 Meshant navy) on neutral-50 (#fafafa) ≥ 12:1