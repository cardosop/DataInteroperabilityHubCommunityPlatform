r(--border-radius-md);\n  font-size: var(--font-size-base);\n  background: var(--color-background-primary);\n  color: var(--color-text-primary);\n}\n\n.filter-input {\n  flex: 1;\n  min-width: 200px;\n}\n\n.filter-select {\n  min-width: 150px;\n}\n\n.asset-list-table {\n  background: var(--color-background-primary);\n  border: 1px solid var(--color-border);\n  border-radius: var(--border-radius-md);\n  overflow: hidden;\n}\n\n.asset-list-table table {\n  width: 100%;\n  border-collapse: collapse;\n}\n\n.asset-list-table thead {\n  background: var(--color-background-secondary);\n}\n\n.asset-list-table th {\n  padding: var(--spacing-md);\n  text-align: left;\n  font-weight: var(--font-weight-semibold);\n  font-size: var(--font-size-sm);\n  color: var(--color-text-secondary);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.asset-list-table tbody tr {\n  border-top: 1px solid var(--color-border);\n  transition: background-color 0.2s;\n}\n\n.asset-list-table tbody tr:hover {\n  background: var(--color-background-secondary);\n}\n\n.asset-row {\n  cursor: pointer;\n}\n\n.asset-list-table td {\n  padding: var(--spacing-md);\n  font-size: var(--font-size-base);\n  color: var(--color-text-primary);\n}\n\n.asset-description {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-secondary);\n  margin-top: var(--spacing-xs);\n}\n\n.status-badge,\n.visibility-badge {\n  display: inline-block;\n  padding: 2px 8px;\n  border-radius: var(--border-radius-sm);\n  font-size: var(--font-size-xs);\n  font-weight: var(--font-weight-medium);\n  text-transform: uppercase;\n}\n\n.status-draft {\n  background: var(--color-warning-light);\n  /* --color-warning-dark (#F57C00) on --color-warning-100 (#FFECB3) = 2.3:1 — fails WCAG AA.\n     Use --color-warning-800 (#7D4200) which gives ≥6.5:1 on #FFECB3. */\n  color: var(--color-warning-800);\n}\n\n.status-active {\n  background: var(--color-success-light);\n  /* --color-success-dark (#388E3C) on --color-success-100 (#C8E6