t-weight: var(--font-weight-semibold);\n}\n\n.tenant-option.disabled,\n.tenant-option:disabled {\n  color: var(--color-neutral-500);\n  cursor: not-allowed;\n}\n\n.tenant-error {\n  color: var(--color-error-600);\n  font-size: var(--font-size-sm);\n  padding: var(--spacing-sm) 0;\n}\n\n.notifications-wrapper {\n  position: relative;\n}\n\n.notifications-button {\n  position: relative;\n  padding: var(--spacing-sm);\n  border: none;\n  background: transparent;\n  cursor: pointer;\n  font-size: var(--font-size-xl);\n}\n\n.notifications-dropdown {\n  position: absolute;\n  top: 100%;\n  right: 0;\n  margin-top: var(--spacing-xs);\n  background: var(--color-background-primary);\n  border: 1px solid var(--color-neutral-300);\n  border-radius: var(--border-radius-md);\n  box-shadow: var(--shadow-lg);\n  min-width: 280px;\n  max-width: 360px;\n  padding: var(--spacing-lg);\n  z-index: 50;\n}\n\n.notifications-empty {\n  text-align: center;\n}\n\n.notifications-empty-title {\n  margin: 0 0 var(--spacing-sm);\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-neutral-800);\n}\n\n.notifications-empty-message {\n  margin: 0;\n  font-size: var(--font-size-sm);\n  color: var(--color-neutral-600);\n  line-height: 1.4;\n}\n\n.notification-badge {\n  position: absolute;\n  top: 0;\n  right: 0;\n  background: var(--color-error-500);\n  color: var(--color-text-on-primary);\n  border-radius: var(--border-radius-full);\n  width: 18px;\n  height: 18px;\n  font-size: var(--font-size-xs);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.user-menu {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n}\n\n.user-menu-trigger {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-xs);\n  padding: var(--spacing-sm) var(--spacing-md);\n  border: 1px solid var(--color-neutral-300);\n  border-radius: var(--border-radius-md);\n  background: var(--color-background-primary);\n  cursor: pointer;\n  font-size: var(--font-size-sm);\n}\n\n.user-menu-trigger:hover {\n  background: var(--color-neutral-100);\n}\n\n.user-menu-trigger .dropdown-arrow {\n  font-size: 0.7rem;\n  color: var(--color-neutral-500);\n}\n\n.user-menu-dropdown {\n  position: absolute;\n  top: 100%;\n  right: 0;\n  margin-top: var(--spacing-xs);\n  background: var(--color-background-primary);\n  border: 1px solid var(--color-neutral-300);\n  border-radius: var(--border-radius-md);\n  box-shadow: var(--shadow-lg);\n  min-width: 180px;\n  padding: var(--spacing-xs);\n  z-index: 50;\n}\n\n.user-menu-item {\n  display: block;\n  width: 100%;\n  padding: var(--spacing-sm) var(--spacing-md);\n  text-align: left;\n  border: none;\n  background: none;\n  cursor: pointer;\n  font-size: var(--font-size-sm);\n  color: var(--color-neutral-800);\n  text-decoration: none;\n  border-radius: var(--border-radius-sm);\n}\n\n.user-menu-item:hover {\n  background: var(--color-neutral-100);\n}\n\n.user-menu-logout {\n  border-top: 1px solid var(--color-neutral-200);\n  margin-top: var(--spacing-xs);\n  padding-top: var(--spacing-sm);\n}\n\n.user-name {\n  font-size: var(--font-size-sm);\n  color: var(--color-neutral-700);\n}\n\n.logout-button {\n  padding: var(--spacing-sm) var(--spacing-md);\n  border: 1px solid var(--color-neutral-300);\n  border-radius: var(--border-radius-md);\n  background: var(--color-background-primary);\n  cursor: pointer;\n  font-size: var(--font-size-sm);\n}\n\n.logout-button:hover {\n  background: var(--color-neutral-100);\n}\n"],["STYLE",{},".app-sidebar {\n  width: var(--layout-sidebar-width);\n  background-color: var(--color-neutral-50);\n  border-right: 1px solid var(--color-neutral-200);\n  height: 100%;\n  overflow-y: auto;\n}\n\n.sidebar-nav {\n  padding: var(--spacing-md);\n}\n\n.nav-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n.nav-list li {\n  margin-bottom: var(--spacing-xs);\n}\n\n.nav-link {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  padding: var(--spacing-sm) var(--spacing-md);\n  border-radius: var(--border-radius-md);\n  text-decoration: none;\n  color: var(--color-neutral-700);\n  transition: background-color 0.2s;\n}\n\n.nav-link:hover {\n  background-color: var(--color-neutral-100);\n}\n\n.nav-link.active {\n  background-color: var(--color-primary-50);\n  /* WCAG 2 AA: primary-800 (#0A1F44 Meshant navy) on primary-50 (#E8ECF4) ≥ 10:1 */\n  color: var(--color-primary-800);\n  font-weight: var(--font-weight-medium);\n}\n\n.nav-icon {\n  font-size: var(--font-size-lg);\n}\n\n.nav-label {\n  font-size: var(--font-size-base);\n}\n"],["STYLE",{},".landing-page {\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: var(--spacing-xl);\n  background: linear-gradient(135deg, var(--color-primary-50) 0%, var(--color-secondary-50) 100%);\n}\n\n.landing-hero {\n  text-align: center;\n  margin-bottom: var(--spacing-2xl);\n  max-width: 640px;\n}\n\n.landing-hero-title {\n  font-size: var(--font-size-4xl);\n  font-weight: 700;\n  color: var(--color-primary-800);\n  margin: 0 0 var(--spacing-md);\n  line-height: 1.2;\n}\n\n.landing-hero-subtitle {\n  font-size: var(--font-size-lg);\n  color: var(--color-neutral-700);\n  margin: 0;\n  line-height: 1.5;\n}\n\n.landing-value {\n  margin-bottom: var(--spacing-2xl);\n  max-width: 480px;\n}\n\n.landing-value-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  font-size: var(--font-size-base);\n  color: var(--color-neutral-700);\n  line-height: 1.6;\n}\n\n.landing-value-list li {\n  padding: var(--spacing-xs) 0;\n  padding-left: var(--spacing-lg);\n  position: relative;\n}\n\n.landing-value-list li::before {\n  content: '';\n  position: absolute;\n  left: 0;\n  top: 0.6em;\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--color-primary-500);\n}\n\n.landing-actions {\n  display: flex;\n  flex-direction: column;\n  align