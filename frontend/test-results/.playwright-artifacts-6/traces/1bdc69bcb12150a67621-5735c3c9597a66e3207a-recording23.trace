r;\n  justify-content: center;\n  min-height: 100vh;\n  background: linear-gradient(135deg, var(--color-primary-50) 0%, var(--color-secondary-50) 100%);\n}\n\n.auth-container {\n  background: var(--color-background-primary);\n  padding: var(--spacing-2xl);\n  border-radius: var(--border-radius-lg);\n  box-shadow: var(--shadow-xl);\n  width: 100%;\n  max-width: 420px;\n}\n\n.auth-container h1 {\n  text-align: center;\n  margin-bottom: var(--spacing-xl);\n  color: var(--color-primary-700);\n}\n\n.auth-form {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-md);\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-xs);\n}\n\n.form-group label {\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-neutral-700);\n}\n\n.form-group input {\n  padding: var(--spacing-sm) var(--spacing-md);\n  border: 1px solid var(--color-neutral-300);\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-base);\n}\n\n.form-group input:focus {\n  outline: 2px solid var(--color-primary-500);\n  outline-offset: 2px;\n}\n\n.error-message {\n  padding: var(--spacing-sm) var(--spacing-md);\n  background-color: var(--color-error-50);\n  color: var(--color-error-700);\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-sm);\n}\n\n.success-message {\n  padding: var(--spacing-sm) var(--spacing-md);\n  background-color: var(--color-success-50);\n  color: var(--color-success-700);\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-sm);\n}\n\n/* WCAG 2 AA: 4.5:1 contrast for normal text; primary-700/800 meet threshold */\n.auth-button {\n  padding: var(--spacing-md);\n  background-color: var(--color-primary-700);\n  color: var(--color-text-on-primary);\n  border: none;\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-medium);\n  cursor: pointer;\n  transition: background-color 0.2s;\n}\n\n.auth-button:hover:not(:disabled) {\n  background-color: var(--color-primary-800);\n}\n\n.auth-button:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n.auth-links {\n  margin-top: var(--spacing-lg);\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-sm);\n  font-size: var(--font-size-sm);\n  color: var(--color-neutral-700);\n}\n\n.auth-links a {\n  color: var(--color-primary-800);\n  text-decoration: none;\n}\n\n.auth-links a:hover {\n  text-decoration: underline;\n}\n\n"],["STYLE",{},".org-onboarding-page .org-onboarding-container {\n  max-width: 440px;\n}\n\n.org-onboarding-subtitle {\n  text-align: center;\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-sm);\n  margin: calc(-1 * var(--spacing-md)) 0 var(--spacing-lg) 0;\n}\n\n.form-hint {\n  font-size: var(--font-size-xs);\n  color: var(--color-text-secondary);\n  margin-top: var(--spacing-xs);\n}\n\n.optional {\n  color: var(--color-neutral-500);\n  font-weight: normal;\n}\n\n.org-onboarding-footer {\n  margin-top: var(--spacing-lg);\n  text-align: center;\n  font-size: var(--font-size-sm);\n  color: var(--color-text-secondary);\n}\n\n.org-onboarding-footer a {\n  color: var(--color-primary);\n  text-decoration: none;\n}\n\n.org-onboarding-footer a:hover {\n  text-decoration: underline;\n}\n"],["STYLE",{},".loading-spinner-container {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: var(--spacing-xl);\n  gap: var(--spacing-md);\n}\n\n.loading-spinner {\n  border: 3px solid var(--color-border-light);\n  border-top: 3px solid var(--color-primary);\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n}\n\n.loading-spinner-small {\n  width: 24px;\n  height: 24px;\n  border-width: 2px;\n}\n\n.loading-spinner-medium {\n  width: 40px;\n  height: 40px;\n}\n\n.loading-spinner-large {\n  width: 64px;\n  height: 64px;\n  border-width: 4px;\n}\n\n@keyframes spin {\n  0% { transform: rotate(0deg); }\n  