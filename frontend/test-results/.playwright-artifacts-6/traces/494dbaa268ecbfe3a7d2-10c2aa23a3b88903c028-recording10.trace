ine-height: 1;\n  opacity: 0.6;\n}\n\n.empty-state-title {\n  margin: 0;\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-primary);\n}\n\n.empty-state-message {\n  margin: 0;\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-base);\n  max-width: 400px;\n}\n\n.empty-state-action {\n  margin-top: var(--spacing-sm);\n  padding: var(--spacing-sm) var(--spacing-lg);\n  background: var(--color-primary);\n  color: var(--color-text-on-primary);\n  border: none;\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-medium);\n  cursor: pointer;\n  transition: background-color 0.2s;\n}\n\n.empty-state-action:hover {\n  background: var(--color-primary-dark);\n}\n\n.empty-state-action:active {\n  background: var(--color-primary-darker);\n}\n"],["STYLE",{},".entitlement-list-page {\n  padding: var(--spacing-lg);\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n.entitlement-list-header {\n  margin-bottom: var(--spacing-lg);\n}\n\n.entitlement-list-header h1 {\n  margin: 0;\n  font-size: var(--font-size-2xl);\n  font-weight: var(--font-weight-bold);\n}\n\n.entitlement-list-filters {\n  margin-bottom: var(--spacing-lg);\n}\n\n.filter-select {\n  padding: var(--spacing-sm) var(--spacing-md);\n  border: var(--border-width) solid var(--color-border);\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-base);\n  min-width: 200px;\n}\n\n.entitlement-list-table {\n  background: var(--color-surface);\n  border: var(--border-width) solid var(--color-border);\n  border-radius: var(--border-radius-lg);\n  overflow: hidden;\n}\n\n.entitlement-list-table table {\n  width: 100%;\n  border-collapse: collapse;\n}\n\n.entitlement-list-table thead {\n  background: var(--color-gray-light);\n}\n\n.entitlement-list-table th {\n  padding: var(--spacing-md);\n  text-align: left;\n  font-weight: var(--font-weight-semibold);\n  font-size: var(--font-siz