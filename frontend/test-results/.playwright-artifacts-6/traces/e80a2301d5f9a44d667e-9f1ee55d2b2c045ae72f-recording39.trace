* Content wrapper when using Modal */\n}\n\n.confirm-dialog-message {\n  margin: 0 0 var(--spacing-lg);\n  color: var(--color-text-secondary);\n  line-height: 1.5;\n}\n\n.confirm-dialog-actions {\n  display: flex;\n  gap: var(--spacing-md);\n  justify-content: flex-end;\n}\n\n.confirm-dialog-danger .confirm-dialog-actions .btn-primary,\n.confirm-dialog-actions .btn-danger {\n  background: var(--color-error-500);\n  border-color: var(--color-error-500);\n}\n\n.confirm-dialog-danger .confirm-dialog-actions .btn-primary:hover,\n.confirm-dialog-actions .btn-danger:hover {\n  background: var(--color-danger-dark, #c82333);\n  border-color: var(--color-danger-dark, #c82333);\n}\n"],["STYLE",{},".uuid-with-copy {\n  display: inline-flex;\n  flex-direction: column;\n  gap: var(--spacing-xs, 4px);\n}\n\n.uuid-label {\n  font-size: var(--font-size-sm, 0.875rem);\n  color: var(--color-text-secondary);\n  font-weight: var(--font-weight-medium);\n}\n\n.uuid-value-row {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm, 8px);\n}\n\n.uuid-value {\n  font-family: var(--font-mono, monospace);\n  font-size: var(--font-size-sm, 0.875rem);\n  background: var(--color-background-secondary);\n  padding: var(--spacing-xs, 4px) var(--spacing-sm, 8px);\n  border-radius: var(--border-radius-sm);\n  word-break: break-all;\n}\n\n.uuid-copy-btn {\n  background: var(--color-background-secondary);\n  border: 1px solid var(--color-border);\n  border-radius: var(--border-radius-sm);\n  padding: var(--spacing-xs, 4px) var(--spacing-sm, 8px);\n  cursor: pointer;\n  font-size: var(--font-size-base);\n  flex-shrink: 0;\n}\n\n.uuid-copy-btn:hover,\n.uuid-copy-btn:focus {\n  background: var(--color-background-tertiary);\n  border-color: var(--color-primary);\n}\n"],["STYLE",{},".breadcrumbs {\n  margin-bottom: var(--spacing-md);\n}\n\n.breadcrumbs-list {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  font-size: var(--font-size-sm);\n  color: var(--color-text-secondary);\n}\n\n.breadcrumbs-item {\n  display: inline-flex;\n  align-items: baseline;\n}\n\n.breadcrumbs-item-with-sep::after {\n  content: ' / ';\n  margin: 0 var(--spacing-xs);\n  color: var(--color-text-tertiary);\n  font-weight: normal;\n  user-select: none;\n}\n\n.breadcrumbs-link {\n  color: var(--color-primary);\n  text-decoration: none;\n}\n\n.breadcrumbs-link:hover {\n  text-decoration: underline;\n}\n\n.breadcrumbs-current {\n  color: var(--color-text-primary);\n  font-weight: var(--font-weight-medium);\n}\n"],["STYLE",{},".job-detail-page {\n  padding: var(--spacing-lg);\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n.job-detail-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--spacing-lg);\n}\n\n.job-detail-content h1 {\n  margin: 0 0 var(--spacing-md) 0;\n  font-size: var(--font-size-2xl);\n  font-weight: var(--font-weight-bold);\n}\n\n.job-status-section {\n  margin: var(--spacing-lg) 0;\n  padding: var(--spacing-lg);\n  background: var(--color-background-secondary);\n  border-radius: var(--border-radius-md);\n}\n\n.status-header {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  margin-bottom: var(--spacing-md);\n}\n\n.progress-indicator {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-sm);\n}\n\n.progress-bar-container {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n}\n\n.progress-bar {\n  flex: 1;\n  height: 8px;\n  background: var(--color-background-tertiary);\n  border-radius: var(--border-radius-full);\n  overflow: hidden;\n}\n\n.progress-bar-fill {\n  height: 100%;\n  background: var(--color-primary);\n  transition: width 0.3s ease;\n}\n\n.progress-text {\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text-secondary);\n  min-width: 50px;\n  text-align: right;\n}\n\n.job-detail-metadata {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: var(--spacing-md);\n  margin: var(--spacing-lg) 0;\n  padding: var(--spacing-lg);\n  background: var(--color-background-secondary);\n  border-radius: var(--border-radius-md);\n}\n\n.metadata-item {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-xs);\n}\n\n.metadata-item label {\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-secondary);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.metadata-item span,\n.metadata-item code {\n  font-size: var(--font-size-base);\n  color: var(--color-text-primary);\n}\n\n.metadata-item code {\n  background: var(--color-background-tertiary);\n  padding: 2px 6px;\n  border-radius: var(--border-radius-sm);\n  font-family: var(--font-family-mono);\n}\n\n.job-error,\n.job-details,\n.job-results {\n  margin-top: var(--spacing-lg);\n  padding: var(--spacing-lg);\n  background: var(--color-background-secondary);\n  border-radius: var(--border-radius-md);\n}\n\n.job-error {\n  background: var(--color-error-light);\n  border: 1px solid var(--color-error);\n}\n\n.job-error h3,\n.job-details h3,\n.job-results h3 {\n  margin: 0 0 var(--spacing-md) 0;\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-semibold);\n}\n\n.job-error pre,\n.job-details pre,\n.job-results pre {\n  margin: 0;\n  padding: var(--spacing-md);\n  background: var(--color-background-primary);\n  border-radius: var(--border-radius-sm);\n  font-family: var(--font-family-mono);\n  font-size: var(--font-size-sm);\n  overflow-x: auto;\n  white-space: pre-wrap;\n  word-wrap: break-word;\n}\n\n.status-badge {\n  display: inline-block;\n  padding: 4px 10px;\n  border-radius: var(--border-radius-sm);\n  font-size: var(--font-size-xs);\n  font-weight: var(--font-weight-medium);\n  text-transform: uppercase;\n}\n\n.status-pending {\n  background: var(--color-warning-light);\n  color: var(--color-warning-dark);\n}\n\n.status-running {\n  background: var(--color-info-light);\n  color: var(--color-info-dark);\n}\n\n.status-completed {\n  background: var(--color-success-light);\n  color: var(--color-success-dark);\n}\n\n.status-failed {\n  background: var(--color-error-light);\n  color: var(--color-error-dark);\n}\n\n.status-cancelled {\n  background: var(--color-background-tertiary);\n  color: var(--color-text-secondary);\n}\n"]],[[6,53]],["BODY",{},[[6,54]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},["A",{"href":"#main-content","class":"skip-link"},"Skip to main content"],["HEADER",{"class":"app-header","role":"banner"},["DIV",{"class":"header-content"},["DIV",{"class":"header-left"},["A",{"class":"app-title-link","aria-label":"Meshant — go to home","href":"/","data-discover":"true"},["H1",{"class":"app-title"},"Meshant"]]],["DIV",{"class":"header-center"},["INPUT",{"__playwright_value_":"","placeholder":"Search assets, contracts, datasets...","class":"global-search","aria-label":"Global search","type":"search"}]],["DIV",{"class":"header-right"},["DIV",{"class":"tenant-switcher"},["BUTTON",{"class":"tenant-button","aria-label":"Switch tenant","aria-expanded":"false","aria-haspopup":"true"},["SPAN",{},"b4188ab5-8427-42a6-a577-91411243f1cf"],["SPAN",{"class":"dropdown-arrow"},"▼"]]],["DIV",{"class":"notifications-wrapper"},["BUTTON",{"type":"button","class":"notifications-button","aria-label":"Notifications","aria-expanded":"false","aria-haspopup":"true"},"🔔",["SPAN",{"class":"notification-badge","aria-hidden":"true"},"0"]]],["DIV",{"class":"user-menu"},["BUTTON",{"type":"button","class":"user-menu-trigger","aria-expanded":"false","aria-haspopup":"true","aria-label":"User menu"},["SPAN",{"class":"user-name"},"E2E-Profile-1773240780227"],["SPAN",{"class":"dropdown-arrow"},"▼"]]]]]],["DIV",{"class":"app-body"},["ASIDE",{"class":"app-sidebar","role":"navigation","aria-label":"Main navigation"},["NAV",{"class":"sidebar-