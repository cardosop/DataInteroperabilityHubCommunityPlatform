outline-offset: 2px;\n}\n\n/* Remove default button styles */\nbutton {\n  font-family: inherit;\n}\n\n/* Remove default list styles */\nul, ol {\n  list-style: none;\n}\n"],["STYLE",{},"/**\n * Accessibility Styles\n * WCAG 2.1 AA compliant styles\n */\n\n/* Screen reader only content */\n.sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n\n/* Focus visible styles (already in index.css, but ensure consistency) */\n:focus-visible {\n  outline: 2px solid var(--color-primary-500);\n  outline-offset: 2px;\n  border-radius: 2px;\n}\n\n/* Ensure interactive elements have minimum touch target size (44x44px) */\nbutton,\na,\ninput[type='checkbox'],\ninput[type='radio'],\nselect {\n  min-height: 44px;\n  min-width: 44px;\n}\n\n/* High contrast mode support */\n@media (prefers-contrast: high) {\n  :root {\n    --color-primary-500: #0056b3;\n    --color-text-primary: #000000;\n    --color-text-secondary: #333333;\n  }\n}\n\n/* Reduced motion support */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* Ensure sufficient color contrast for text */\n.text-muted {\n  color: var(--color-text-secondary);\n}\n\n/* Ensure links are distinguishable and meet WCAG 2 AA contrast (4.5:1 on white) */\na:not([class]) {\n  color: var(--color-primary-700);\n  text-decoration: underline;\n}\n\na:not([class]):hover,\na:not([class]):focus {\n  color: var(--color-primary-800);\n  text-decoration: underline;\n}\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"auth-page"},["DIV",{"class":"auth-container"},["H1",{},"Meshant"],["FORM",{"class":"auth-form"},["DIV",{"class":"form-group"},["LABEL",{"for":"email"},"Email"],["INPUT",{