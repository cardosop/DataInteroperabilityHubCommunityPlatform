;\n  opacity: 0.6;\n}\n\n.empty-state-title {\n  margin: 0;\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-primary);\n}\n\n.empty-state-message {\n  margin: 0;\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-base);\n  max-width: 400px;\n}\n\n.empty-state-action {\n  margin-top: var(--spacing-sm);\n  padding: var(--spacing-sm) var(--spacing-lg);\n  background: var(--color-primary);\n  color: var(--color-text-on-primary);\n  border: none;\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-medium);\n  cursor: pointer;\n  transition: background-color 0.2s;\n}\n\n.empty-state-action:hover {\n  background: var(--color-primary-dark);\n}\n\n.empty-state-action:active {\n  background: var(--color-primary-darker);\n}\n"],["STYLE",{},".listing-list-page {\n  padding: var(--spacing-lg);\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n.listing-list-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--spacing-lg);\n}\n\n.listing-list-header h1 {\n  margin: 0;\n  font-size: var(--font-size-2xl);\n  font-weight: var(--font-weight-bold);\n}\n\n.listing-list-header-actions {\n  display: flex;\n  gap: var(--spacing-md);\n  align-items: center;\n}\n\n.listing-list-filters {\n  display: flex;\n  gap: var(--spacing-md);\n  margin-bottom: var(--spacing-lg);\n  flex-wrap: wrap;\n}\n\n.filter-input,\n.filter-select {\n  padding: var(--spacing-sm) var(--spacing-md);\n  border: var(--border-width) solid var(--color-border);\n  border-radius: var(--border-radius-md);\n  font-size: var(--font-size-base);\n}\n\n.filter-input {\n  flex: 1;\n  min-width: 200px;\n}\n\n.filter-select {\n  min-width: 150px;\n}\n\n.listing-list-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n  gap: var(--spacing-lg);\n  margin-bottom: var(--spacing-lg);\n}\n\n.listing-card {\n  background: var(--color-surface);\n  border: var(--border-width) solid var(--color-border);\n  border-radius: var(--border-radius-lg);\n  padding: var(--spacing-lg);\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.listing-card:hover {\n  border-color: var(--color-primary);\n  box-shadow: var(--shadow-md);\n  transform: translateY(-2px);\n}\n\n.listing-card:focus {\n  outline: 2px solid var(--color-primary);\n  outline-offset: 2px;\n}\n\n.listing-card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: start;\n  margin-bottom: var(--spacing-md);\n}\n\n.listing-card-header h3 {\n  margin: 0;\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-semibold);\n  flex: 1;\n}\n\n.listing-status {\n  padding: var(--spacing-xs) var(--spacing-sm);\n  border-radius: var(--border-radius-sm);\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  text-transform: uppercase;\n}\n\n.listing-status-draft {\n  background: var(--color-warning-light);\n  color: var(--color-warning-dark);\n}\n\n.listing-status-published {\n  background: var(--color-success-light);\n  color: var(--color-success-dark);\n}\n\n.listing-status-unlisted {\n  background: var(--color-gray-light);\n  color: var(--color-gray-dark);\n}\n\n.listing-card-description {\n  color: var(--color-text-secondary);\n  margin-bottom: var(--spacing-md);\n  display: -webkit-box;\n  -webkit-line-clamp: 3;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n.listing-card-footer {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding-top: var(--spacing-md);\n  border-top: var(--border-width) solid var(--color-border);\n}\n\n.listing-pricing {\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-primary);\n}\n\n.listing-domain {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-secondary);\n  background: var(--color-gray-light);\n  padding: var(--spacing-xs) var(--spacing-sm);\n  border-radius: var(--border-radius-sm);\n}\n\n.listing-list-pagination {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: var(--spacing-md);\n  margin-top: var(--spacing-lg);\n}\n\n.pagination-info {\n  color: var(--color-text-secondary);\n}\n"]],[[1,53]],["BODY",{},[[1,54]],["DIV",{"id":"root"},["DIV",{"class":"app-shell"},["A",{"href":"#main-content","class":"skip-link"},"Skip to main content"],["HEADER",{"class":"app-header","role":"banner"},["DIV",{"class":"header-content"},["DIV",{"class":"header-left"},["A",{"class":"app-title-link","aria-label":"Meshant — go to home","href":"/","data-discover":"true"},["H1",{"class":"app-title"},"Meshant"]]],["DIV",{"class":"header-center"},["INPUT",{"__playwright_value_":"","placeholder":"Search assets, contracts, datasets...","class":"global-search","aria-label":"Global search","type":"search"}]],["DIV",{"class":"header-right"},["DIV",{"class":"tenant-switcher"},["BUTTON",{"class":"tenant-button","aria-label":"Switch tenant","aria-expanded":"false","aria-haspopup":"true"},["SPAN",{},"98547636-bffc-48cb-b014-a17511729ffd"],["SPAN",{"class":"dropdown-arrow"},"▼"]]],["DIV",{"class":"notifications-wrapper"},["BUTTON",{"type":"button","class":"notifications-button","aria-label":"Notifications","aria-expanded":"false","aria-haspopup":"true"},"🔔",["SPAN",{"class":"notification-badge","aria-hidden":"true"},"0"]]],["DIV",{"class":"user-menu"},["BUTTON",{"type":"button","class":"user-menu-trigger","aria-expanded":"false","aria-haspopup":"true","aria-label":"User menu"},["SPAN",{"class":"user-name"},"E2E Consumer User"],["SPAN",{"class":"dropdown-arrow"},"▼"]]]]]],["DIV",{"class":"app-body"},["ASIDE",{"class":"app-sidebar","role":"navigation","aria-label":"Main navigation"},["NAV",{"class":"sidebar-nav"},["UL",{"class":"nav-list"},["LI",{},["A",{"class":"nav-link ","href":"/","data-discover":"true"},["SPAN",{"class":"nav-icon"},"🏠"],["SPAN",{"class":"nav-label"},"Home"]]],["LI",{},["A",{"class":"nav-link ","href":"/as