# Brand (Phase 28.7 Meshant Design System)
VITE_APP_NAME=Meshant

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000

# Optional: use Traefik as single entrypoint (see docs/API_GATEWAY_TRAEFIK.md)
# When true, set VITE_API_BASE_URL to the Traefik API base (e.g. https://api.hub.local/api/v1)
# VITE_USE_TRAEFIK_ENTRYPOINT=false

# Optional: Prefect UI base URL for "View in Prefect" link on scheduled ingestion run detail
# When set, run detail shows a link to the flow run in Prefect UI.
# VITE_PREFECT_UI_BASE_URL=https://prefect.example.com

# Environment
VITE_ENV=development

# Optional: Feature flags (default: enabled when unset)
# VITE_FEATURE_TOAST_ENABLED=true
# VITE_FEATURE_BREADCRUMBS_ENABLED=true
# VITE_FEATURE_RESOURCE_PICKERS_ENABLED=true
