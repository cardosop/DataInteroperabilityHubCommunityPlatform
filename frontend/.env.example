# Brand (Phase 28.7 Meshant Design System)
VITE_APP_NAME=Meshant

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000

# Optional: use Traefik as single entrypoint (see docs/API_GATEWAY_TRAEFIK.md)
# When true, set VITE_API_BASE_URL to the Traefik API base (e.g. https://api.hub.local/api/v1)
# VITE_USE_TRAEFIK_ENTRYPOINT=false

# Optional: Prefect UI base URL for "View in Prefect" link on scheduled ingestion run detail
# When set, run detail shows a link to the flow run in Prefect UI.
# VITE_PREFECT_UI_BASE_URL=https://prefect.example.com

# Environment
VITE_ENV=development

# WebSocket — set to 'false' to disable real-time WS connections (default: enabled)
# VITE_WS_ENABLED=true

# Auth registration — 'true' | 'false' | 'auto' (default: auto, checks backend capability)
# VITE_AUTH_REGISTRATION_ENABLED=auto

# Public resources page — set to 'false' to disable public API docs & health access
# VITE_PUBLIC_RESOURCES_ENABLED=true

# Error reporting — Sentry DSN (leave empty to disable)
# VITE_SENTRY_DSN=

# Dev server proxy target (optional, auto-detected from VITE_API_BASE_URL)
# VITE_PROXY_TARGET=http://localhost:8000

# E2E testing — set to 'true' by Playwright config to suppress console error logs
# VITE_E2E_TEST=false

# Optional: Feature flags (default: enabled when unset)
# VITE_FEATURE_TOAST_ENABLED=true
# VITE_FEATURE_BREADCRUMBS_ENABLED=true
# VITE_FEATURE_RESOURCE_PICKERS_ENABLED=true

# MVP UI: hide non-MVP sidebar entries; capability-gated routes redirect to /coming-soon
# VITE_MVP_MODE=false

# Stripe publishable key (optional)
# VITE_STRIPE_PUBLISHABLE_KEY=
