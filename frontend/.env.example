# =============================================================================
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure with your values
# For environment-specific configs, see .env.development, .env.staging, .env.production
#
# All variables prefixed with VITE_ are exposed to the client-side code.
# Never put sensitive secrets in VITE_ prefixed variables!
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration (Required)
# -----------------------------------------------------------------------------
# Backend API base URL (without trailing slash)
# Default: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# WebSocket URL for real-time features
# Default: ws://localhost:8000
VITE_WS_URL=ws://localhost:8000

# GraphQL endpoint URL
# Default: http://localhost:8000/graphql (or VITE_API_BASE_URL/graphql)
VITE_GRAPHQL_URL=http://localhost:8000/graphql

# API version (used in API requests)
# Default: v1
VITE_API_VERSION=v1

# OpenAPI schema URL (for API documentation and type generation)
# Default: http://localhost:8000/api/v1/openapi.json
VITE_OPENAPI_SCHEMA_URL=http://localhost:8000/api/v1/openapi.json

# -----------------------------------------------------------------------------
# Environment Settings (Required)
# -----------------------------------------------------------------------------
# Environment name: development, staging, or production
# Default: development
VITE_ENV=development

# Enable debug mode (shows additional logging and error details)
# Default: false (true in development)
VITE_DEBUG=false

# -----------------------------------------------------------------------------
# Analytics Configuration (Optional)
# -----------------------------------------------------------------------------
# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
# Leave empty to disable Google Analytics
VITE_GA_MEASUREMENT_ID=

# Sentry DSN for error tracking
# Format: https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# Leave empty to disable Sentry
VITE_SENTRY_DSN=

# Enable analytics (Sentry and Google Analytics)
# Set to 'true' to enable, 'false' to disable
# Default: false (true in production)
VITE_ENABLE_ANALYTICS=false

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# Enable/disable specific features
# Set to 'true' to enable, 'false' to disable
# Default: true for most features, false for AI/ML and Social (opt-in)

# Marketplace feature
VITE_ENABLE_MARKETPLACE=true

# Compliance feature
VITE_ENABLE_COMPLIANCE=true

# Data Quality feature
VITE_ENABLE_DATA_QUALITY=true

# Scheduled Ingestion feature
VITE_ENABLE_SCHEDULED_INGESTION=true

# Search feature
VITE_ENABLE_SEARCH=true

# Governance feature
VITE_ENABLE_GOVERNANCE=true

# AI/ML features (natural language search, schema matching)
# Default: false (opt-in feature)
VITE_ENABLE_AI_ML=false

# Social features (ratings, reviews, comments, communities)
# Default: false (opt-in feature)
VITE_ENABLE_SOCIAL=false

# Developer features (plugins, SDK documentation)
VITE_ENABLE_DEVELOPER=true

# -----------------------------------------------------------------------------
# Performance & Optimization (Optional)
# -----------------------------------------------------------------------------
# Enable React Query DevTools in development
# Default: true in development, false in production
VITE_ENABLE_REACT_QUERY_DEVTOOLS=true

# API request timeout in milliseconds
# Default: 30000 (30 seconds)
VITE_API_TIMEOUT=30000

# WebSocket reconnection delay in milliseconds
# Default: 3000 (3 seconds)
VITE_WS_RECONNECT_DELAY=3000

# Maximum WebSocket reconnection attempts
# Default: 5
VITE_WS_MAX_RECONNECT_ATTEMPTS=5

# -----------------------------------------------------------------------------
# Internationalization (Optional)
# -----------------------------------------------------------------------------
# Default language code (ISO 639-1)
# Supported: en, es, fr
# Default: en
VITE_DEFAULT_LANGUAGE=en

# Supported languages (comma-separated)
# Default: en,es,fr
VITE_SUPPORTED_LANGUAGES=en,es,fr

# -----------------------------------------------------------------------------
# UI Configuration (Optional)
# -----------------------------------------------------------------------------
# Default theme mode: light or dark
# Default: light
VITE_THEME_MODE=light

# Enable theme persistence in localStorage
# Default: true
VITE_THEME_PERSIST=true

# Items per page for pagination
# Default: 20
VITE_PAGE_SIZE=20

# Maximum items per page
# Default: 100
VITE_MAX_PAGE_SIZE=100

# -----------------------------------------------------------------------------
# Development Only (Optional)
# -----------------------------------------------------------------------------
# Enable React DevTools Profiler
# Default: true in development
VITE_ENABLE_PROFILER=true

# Enable API request/response logging
# Default: true in development
VITE_ENABLE_API_LOGGING=true

# Mock API responses (for development/testing)
# Default: false
VITE_MOCK_API=false
