# W0.6 (oss-release-remediation): private key material and the staging
# secrets dir must never re-enter the tracked tree — the postgres TLS
# keys were committed once (dropped by the W0.4 rewrite); the staging
# secrets dir carries provider secrets (W0.7 ExternalSecrets).
*.key
*.pem
# only the ExternalSecret MANIFESTS ship (referenced store keys,
# never values — the contracts pinned by the secrets-contract suites);
# runtime secret material under the dir stays out.
infrastructure/staging/secrets/*
!infrastructure/staging/secrets/*.yaml
infrastructure/staging/config-artifacts/

# P0-8 (H-4): dev TLS material is GENERATED-ONLY (ssl-setup.sh, run at
# stack boot by the tls-certs-init service) — keys must never be committed.
infrastructure/postgres/certs/
# W2.10 (oss-release-remediation): repo-owned Stripe CLI binary (.tools) and
# the per-run Stripe listen webhook signing secret (.e2e) — the secret is
# generated by `stripe listen` on every E2E run and must never be committed.
.tools/
.e2e/

# W12.1 (oss-release-remediation): shipped-tree litter classes that must
# never re-enter the tree — GATE-55 (scripts/check_shipped_tree_litter.py)
# pins the gitignore coverage of each (git check-ignore).
storybook-static/
sdk/typescript/
mock_audit_results.json
/guard-failures/
/generated/
coverage.xml


# W11.11 DAST local scan working dir (ZAP sessions, minted tokens — never commit)
.zap-work/
