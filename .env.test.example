# Test Environment Configuration
# Copy this file to .env.test and set values there. .env.test is gitignored so secrets are never committed.
#   cp .env.test.example .env.test
# Then edit .env.test with real values (from your password manager or CI secrets). Never commit .env.test.
# Usage: docker-compose -f docker-compose.test.yml --env-file .env.test up -d
# Batch script run_phase_12a_batched.sh sources .env.test if present, so integration tests get these vars.

# Database Configuration (docker-compose.test.yml uses POSTGRES_TEST_* to avoid .env override)
POSTGRES_TEST_USER=hub_test
POSTGRES_TEST_PASSWORD=hub_test
POSTGRES_TEST_DB=hub_test
POSTGRES_TEST_PORT=5434

# Redis Configuration (use alternate ports when main compose is running: 6379, 6380-6382)
# REDIS_CACHE_TEST_PORT=6479
# REDIS_QUEUE_TEST_PORT=6470
# REDIS_EVENTS_TEST_PORT=6471
# REDIS_CHANNELS_TEST_PORT=6472
REDIS_TEST_PORT=6380
REDIS_MAX_MEMORY=1gb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# MinIO Configuration — must match AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY below so tests see MinIO as available
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_TEST_API_PORT=9010
MINIO_TEST_CONSOLE_PORT=9011
AWS_STORAGE_BUCKET_NAME=hub-test

# ClamAV (Phase 203) — docker-compose.test.yml defaults CLAMAV_ENABLED=false for api/worker.
# For live scan tests: docker compose -f docker-compose.test.yml --profile clamav-test up -d clamav-test
# then CLAMAV_ENABLED=true CLAMAV_HOST=clamav-test (and RUN_CLAMAV_LIVE_TESTS=1 for pytest from host).
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav-test
CLAMAV_PORT=3310
# CLAMAV_TEST_PORT=13310

# Fuseki Configuration
FUSEKI_DATASET=hub
FUSEKI_ADMIN_PASSWORD=admin
FUSEKI_TEST_PORT=3031

# Service Ports (Test Environment)
API_TEST_PORT=8001
DATACONTRACT_TEST_PORT=8093
# Jaeger: override if 6831 is in use (e.g. another Jaeger instance)
# JAEGER_UDP_TEST_PORT=6832
DQ_TEST_PORT=8084
COMPLIANCE_TEST_PORT=8085
SEMANTIC_TEST_PORT=8086
WORKER_TEST_HEALTH_PORT=8087

# Prefect / Scheduled Export (E2E batch 18)
# Worker API key for scheduled export/ingestion internal endpoints. Default in docker-compose.test.yml
# allows test_complete_export_lifecycle to pass; override here if using a DB-backed API key.
# HUB_WORKER_API_KEY=e2e-test-worker-key-scheduled-export

# Prefect Configuration
PREFECT_SERVER_TEST_PORT=4202
PREFECT_UI_TEST_PORT=4203
PREFECT_DB_TEST_PORT=5437

# Django Configuration
DJANGO_SETTINGS_MODULE=hub.settings
DEBUG=True
LOG_LEVEL=DEBUG
ENVIRONMENT=test

# Service URLs (for API service)
DATACONTRACT_SERVICE_URL=http://datacontract-service-test:8080
DQ_SERVICE_URL=http://dq-service-test:8083
COMPLIANCE_SERVICE_URL=http://compliance-service-test:8082
SEMANTIC_SERVICE_URL=http://semantic-service-test:8081
FUSEKI_URL=http://fuseki-test:3030

# Email Configuration (Console backend for testing)
EMAIL_BACKEND=console
EMAIL_BASE_URL=http://localhost:8001
EMAIL_JOB_NOTIFICATIONS_ENABLED=false

# Application Configuration
APP_VERSION=1.0.0-test
USE_PRODUCTION_DB_FOR_SDK_TESTS=0

# Billing (Stripe) - optional; when set, Stripe-dependent tests in hub/apps/billing/tests run (no mocks)
# Use a Stripe test key (sk_test_...) from https://dashboard.stripe.com/test/apikeys. Never commit real keys.
# If unset, 4 tests in test_services.py are skipped (Batch 17: Billing).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...) - enables test_stripe_webhook_invalid_signature. Default whsec_test in compose.
STRIPE_WEBHOOK_SECRET=
STRIPE_MARKETPLACE_WEBHOOK_SECRET=

# Optional: Marketplace connector integration tests (Batch 51)
# Set these in .env.test (or CI secrets) to run integration tests that currently skip.
# Leave empty to keep skips; never commit real credentials. Prefer a secrets manager in CI.
# Dados.gov.br (JWT from https://dados.gov.br/swagger-ui/index.html)
DADOS_GOV_BR_API_KEY=
# Or legacy name used by some tests
CKAN_DADOS_GOV_BR_API_KEY=
# Snowflake Data Marketplace (all three required for Snowflake integration tests; leave empty to skip)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_TOKEN=
# GCP Marketplace
GCP_PROJECT_ID=
# GCP credentials: set one of the two. Prefer file path to avoid .env quoting issues.
# Option A: path to service account JSON file (recommended)
# GCP_CREDENTIALS_JSON_FILE=/path/to/service-account.json
GCP_CREDENTIALS_JSON_FILE=
# Option B: inline JSON (single-quote the whole value so shell does not mangle braces)
# Example: GCP_CREDENTIALS_JSON='{"type":"service_account",...}'
GCP_CREDENTIALS_JSON=
# Alternative env name (same value as GCP_CREDENTIALS_JSON). Use single quotes: GCP_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
GCP_SERVICE_ACCOUNT_JSON=
# S3-compatible storage in test: must match MINIO_ROOT_USER and MINIO_ROOT_PASSWORD above.
# AWS Data Exchange connector uses connection config; these are for Django default file storage.
# AWS_ACCESS_KEY_ID=minio
# AWS_SECRET_ACCESS_KEY=minio123
# Optional: override S3 endpoint (e.g. http://minio-test:9000 in Docker, http://localhost:9010 on host)
# AWS_S3_ENDPOINT_URL=
