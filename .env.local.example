# Local Environment Overrides
# Copy this file to .env.local and customize for local development overrides
# This file is loaded after .env.dev and takes precedence
# DO NOT commit .env.local to version control (it's in .gitignore)

# ==============================================================================
# Local Development Overrides
# ==============================================================================
# Use this file to override environment variables for local development
# without modifying .env.dev (which may be shared or version controlled)

# ==============================================================================
# CKAN Integration - Local Overrides
# ==============================================================================
# Override CKAN configuration for local testing
# Example: Use a local CKAN instance or different test instance
# CKAN_TEST_URL=https://localhost:5000
# CKAN_TEST_API_KEY=your-local-test-api-key

# Override dados.gov.br API key for local testing
# CKAN_DADOS_GOV_BR_API_KEY=your-local-api-key

# ==============================================================================
# Database - Local Overrides
# ==============================================================================
# Override database connection for local development
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ==============================================================================
# Service URLs - Local Overrides
# ==============================================================================
# Override service URLs if running services locally instead of in Docker
# DATACONTRACT_SERVICE_URL=http://localhost:8080
# DQ_SERVICE_URL=http://localhost:8083
# COMPLIANCE_SERVICE_URL=http://localhost:8082
# SEMANTIC_SERVICE_URL=http://localhost:8081

# ==============================================================================
# Debugging - Local Overrides
# ==============================================================================
# Enable additional debugging for local development
# DEBUG=True
# LOG_LEVEL=DEBUG

# ==============================================================================
# Notes
# ==============================================================================
# - Variables in this file override values from .env.dev
# - This file is gitignored and should not be committed
# - Use this for personal development preferences
# - Team-shared overrides should go in .env.dev
