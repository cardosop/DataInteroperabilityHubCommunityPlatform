{
  "consumer": {
    "name": "PythonSDK"
  },
  "interactions": [
    {
      "description": "list contracts",
      "pending": false,
      "providerStates": [
        {
          "name": "contracts exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/contracts/",
        "query": {
          "limit": [
            "50"
          ],
          "offset": [
            "0"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "count": 1,
            "next": "https://example.com/contracts/?limit=50&offset=50",
            "previous": "https://example.com/contracts/?limit=50&offset=0",
            "results": [
              {
                "asset_id": "asset-uuid-0000-0000-000000000002",
                "created_at": "2025-01-01T00:00:00Z",
                "id": "contract-uuid-0000-0000-000000000001",
                "normalization_status": "NORMALIZED_OK",
                "original_format": "YAML",
                "original_spec_type": "ODCS",
                "status": "DRAFT",
                "version": 1
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.count": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.next": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.previous": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].asset_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}|[0-9A-F]{8}(-[0-9A-F]{4}){3}-[0-9A-F]{12})$"
                }
              ]
            },
            "$.results[0].created_at": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ssZ",
                  "match": "datetime"
                }
              ]
            },
            "$.results[0].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}|[0-9A-F]{8}(-[0-9A-F]{4}){3}-[0-9A-F]{12})$"
                }
              ]
            },
            "$.results[0].normalization_status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].original_format": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].original_spec_type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].version": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
