{
  "consumer": {
    "name": "ScheduledExport"
  },
  "interactions": [
    {
      "description": "get export run history",
      "pending": false,
      "providerStates": [
        {
          "name": "export has run history"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/scheduled-exports/export-uuid/runs/",
        "query": {
          "limit": [
            "20"
          ],
          "offset": [
            "0"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "results": [
              {
                "completed_at": "2026-05-15T00:05:00Z",
                "id": "run-uuid",
                "row_count": 1000,
                "started_at": "2026-05-15T00:00:00Z",
                "status": "COMPLETED"
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.results[0].completed_at": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].row_count": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].started_at": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "list scheduled exports",
      "pending": false,
      "providerStates": [
        {
          "name": "scheduled exports exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/scheduled-exports/",
        "query": {
          "limit": [
            "50"
          ],
          "offset": [
            "0"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "count": 1,
            "results": [
              {
                "format": "CSV",
                "id": "export-uuid",
                "name": "Daily Sales Export",
                "schedule": "0 6 * * *",
                "status": "ACTIVE"
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.results[0].format": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[0-9a-f-]+$"
                }
              ]
            },
            "$.results[0].name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].schedule": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "trigger scheduled export",
      "pending": false,
      "providerStates": [
        {
          "name": "export is active"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/api/v1/scheduled-exports/export-uuid/trigger/"
      },
      "response": {
        "body": {
          "content": {
            "id": "run-uuid",
            "status": "QUEUED",
            "triggered_at": "2026-05-15T00:00:00Z"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.triggered_at": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "MeshantAPI"
  }
}