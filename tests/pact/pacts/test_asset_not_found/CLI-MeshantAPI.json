{
  "consumer": {
    "name": "CLI"
  },
  "interactions": [
    {
      "description": "get non-existent asset",
      "pending": false,
      "providerStates": [
        {
          "name": "asset does not exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/assets/nonexistent/"
      },
      "response": {
        "body": {
          "content": {
            "error": {
              "code": "ASSET_NOT_FOUND",
              "http_status": 404,
              "message": "Asset not found"
            }
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.error.code": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.error.http_status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.error.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 404
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "MeshantAPI"
  }
}