{
  "consumer": {
    "name": "MarketplaceUI"
  },
  "interactions": [
    {
      "description": "browse marketplace listings",
      "pending": false,
      "providerStates": [
        {
          "name": "listings exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/marketplace/listings/",
        "query": {
          "limit": [
            "20"
          ],
          "offset": [
            "0"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "count": 1,
            "results": [
              {
                "id": "listing-uuid",
                "price": "$100",
                "status": "PUBLISHED",
                "title": "Sales Dataset"
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.results[0].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[0-9a-f-]+$"
                }
              ]
            },
            "$.results[0].price": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "create order from listing",
      "pending": false,
      "providerStates": [
        {
          "name": "listing is purchasable"
        }
      ],
      "request": {
        "body": {
          "content": {
            "listing_id": "listing-uuid"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.listing_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/v1/marketplace/orders/"
      },
      "response": {
        "body": {
          "content": {
            "id": "order-uuid",
            "status": "PENDING",
            "total": "$100"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[0-9a-f-]+$"
                }
              ]
            },
            "$.total": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 201
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "list my entitlements",
      "pending": false,
      "providerStates": [
        {
          "name": "user has purchased listings"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/marketplace/entitlements/",
        "query": {
          "limit": [
            "50"
          ],
          "offset": [
            "0"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "results": [
              {
                "asset": {
                  "name": "Sales Data"
                },
                "id": "ent-uuid",
                "status": "ACTIVE"
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.results[0].asset.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[0-9a-f-]+$"
                }
              ]
            },
            "$.results[0].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "MeshantAPI"
  }
}