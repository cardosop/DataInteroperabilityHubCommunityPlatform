{
  "consumer": {
    "name": "ScheduledExport"
  },
  "interactions": [
    {
      "description": "get export run history",
      "pending": false,
      "providerStates": [
        {
          "name": "export has run history"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/scheduled-exports/export-uuid/runs/",
        "query": {
          "limit": [
            "20"
          ],
          "offset": [
            "0"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "results": [
              {
                "completed_at": "2026-05-15T00:05:00Z",
                "id": "run-uuid",
                "row_count": 1000,
                "started_at": "2026-05-15T00:00:00Z",
                "status": "COMPLETED"
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.results[0].completed_at": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ssZ",
                  "match": "datetime"
                }
              ]
            },
            "$.results[0].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].row_count": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].started_at": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ssZ",
                  "match": "datetime"
                }
              ]
            },
            "$.results[0].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "MeshantAPI"
  }
}