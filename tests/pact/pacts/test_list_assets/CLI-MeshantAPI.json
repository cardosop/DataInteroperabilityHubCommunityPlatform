{
  "consumer": {
    "name": "CLI"
  },
  "interactions": [
    {
      "description": "list assets with status filter",
      "pending": false,
      "providerStates": [
        {
          "name": "assets exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/assets/",
        "query": {
          "limit": [
            "50"
          ],
          "offset": [
            "0"
          ],
          "status": [
            "ACTIVE"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "count": 2,
            "next": "https://example.com/assets/?limit=50&offset=50",
            "previous": "https://example.com/assets/?limit=50&offset=0",
            "results": [
              {
                "created_at": "2025-01-01T00:00:00Z",
                "description": "A test asset",
                "domain": "finance",
                "id": "asset-uuid-001",
                "key": "test-asset",
                "name": "Test Asset",
                "status": "ACTIVE",
                "updated_at": "2025-01-01T00:00:00Z",
                "visibility": "INTERNAL"
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.count": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.next": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.previous": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].created_at": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ssZ",
                  "match": "datetime"
                }
              ]
            },
            "$.results[0].description": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].domain": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}|[0-9A-F]{8}(-[0-9A-F]{4}){3}-[0-9A-F]{12})$"
                }
              ]
            },
            "$.results[0].key": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[0].updated_at": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ssZ",
                  "match": "datetime"
                }
              ]
            },
            "$.results[0].visibility": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "MeshantAPI"
  }
}