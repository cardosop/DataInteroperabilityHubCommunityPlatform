{
  "schema": "https://opendataproducts.org/schema/v4.1",
  "version": "4.1",
  "product": {
    "details": {
      "en": {
        "productID": "sample-product-internal-ref-v4.1",
        "name": "Sample Data Product with Internal $ref v4.1",
        "description": "A sample ODPS 4.1 data product demonstrating internal $ref usage. The dataQuality section is defined separately and referenced using $ref."
      }
    },
    "contract": {
      "contractURL": "https://example.com/contracts/sample-product-internal-ref-v4.1"
    },
    "dataQuality": {
      "qualityScore": 95,
      "completeness": 0.98,
      "accuracy": 0.97,
      "rules": [
        {
          "ruleID": "completeness-check",
          "description": "Ensures all required fields are present",
          "threshold": 0.95
        },
        {
          "ruleID": "accuracy-check",
          "description": "Validates data accuracy against source",
          "threshold": 0.90
        }
      ]
    },
    "marketplace": {
      "pricingPlans": [
        {
          "planID": "basic",
          "name": "Basic Plan",
          "price": 9.99,
          "currency": "USD"
        }
      ]
    }
  },
  "$defs": {
    "dataQualityReference": {
      "$ref": "#/product/dataQuality"
    }
  }
}

