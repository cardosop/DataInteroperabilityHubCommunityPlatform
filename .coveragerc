# Coverage configuration for hub and tests
# See https://coverage.readthedocs.io/

[run]
source = hub
# Fragment files that are not valid standalone modules (class-body only); omit to avoid "couldn't parse"
omit =
    hub/apps/notifications/business_rules_template_validation.py
    # Phase 91: legacy backup files (kept for rollback reference only)
    hub/apps/integrations/_services_legacy.py
    hub/apps/virtualization/_services_legacy.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
