# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv
pip-log.txt
pip-delete-this-directory.txt

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/media
/staticfiles

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
.env*

# Secrets and local dev certs
*.pem
*.key
infrastructure/postgres/certs/

# Git
.git/
.gitignore

# Documentation
docs/_build/

# OpenSpec
openspec/

# InputDocs
InputDocs/

# Node — ** prefix matches at any depth (frontend/node_modules/, sdk/js/node_modules/, etc.)
**/node_modules/
npm-debug.log*

# Frontend source — backend services don't need it; the frontend Dockerfile
# uses context: frontend/ so this exclusion doesn't affect it.
frontend/

# Docker
docker-compose.override.yml

# Local environments and CI artifacts — never COPY'd into images but default
# compose `context: .` still hashes/sends them to the daemon (multi‑GB on dev machines).
venv/
.venv/
venv-*/
**/venv/
test_reports_comprehensive/
test_reports_integration/
htmlcov/
htmlcov-unit/
awscliv2.zip
backups/
coverage.xml
# Local AWS CLI bundle / artifacts — not COPY'd into images
aws/

# Terraform — provider/plugin cache under each module (often 500MB+ each). .tf files stay; tests
# e.g. hub/apps/search/tests/test_fts_search.py read infrastructure/terraform/s3/main.tf.
**/.terraform/
*.tfstate
*.tfstate.*

# Type-check / misc local caches (not needed in API/worker images)
.mypy_cache/
deployment_logs/
test-results*.txt
frontend/e2e-results*.txt
