# Tier 10 — Phase 235.4 audit-fix: JWT expiry returns 401 (spec 235.4.16)
# ---------------------------------------------------------------------------


@pytest.mark.integration
class TestImpersonationJWTExpiry:
    """Spec 235.4.16 — an impersonation JWT past its ``exp`` window must
    fail JWT verification at the auth layer.

    The start endpoint mints the JWT with ``ttl_seconds = max_minutes * 60``
    via the new ``JWTTokenGenerator.generate_access_token(..., ttl_seconds=...)``
    kwarg. Audit-replay relies on this behaviour: once the session is
    expired by the cron, EVEN IF an attacker captured the JWT, the
    JWT itself becomes useless after its natural ``exp`` (a defence
    layer in addition to the ImpersonationMiddleware's "trust the
    row over the claim" rule).
    """

    @pytest.mark.integration
    def test_expired_impersonation_jwt_decodes_to_none(self):
        from hub.apps.auth.jwt_utils import JWTTokenGenerator

        target_tenant = _make_tenant()
        target = _make_regular_user(target_tenant)
        # ttl_seconds=-1 mints a token whose ``exp`` is already in the
        # past, so ``jwt.decode`` raises ``ExpiredSignatureError`` and
        # ``decode_access_token`` returns None — the auth layer would
        # reject the request with 401.
        expired_token = JWTTokenGenerator.generate_access_token(
            target,
            tenant_id=str(target_tenant.id),
            impersonation_session_id=str(uuid.uuid4()),
            ttl_seconds=-1,
        )
        payload = JWTTokenGenerator.decode_access_token(
            expired_token, verify_version=False
        )
        assert payload is None, (
            "An impersonation JWT past its exp window MUST decode to None "
            "(the auth layer translates this to HTTP 401)."
        )


# ---------------------------------------------------------------------------
# Tier 11 — Phase 235.4 audit-fix Gap 2: exit-endpoint permission contract
# ---------------------------------------------------------------------------


@pytest.mark.integration
class TestImpersonateExitPermissionMatrix:
    """Phase 235.4 audit-fix — the exit endpoint must accept TWO auth
    surfaces:

    1. The original operator using their regular cookie/Bearer auth
       (PLATFORM_ADMIN) — force-end / incident-response path.
    2. The same operator using the impersonation JWT they just minted —
       common-case banner Exit button flow, where ``request.user`` is
       the IMPERSONATED user but ``request.impersonation_session_id``
       points to the session being exited.

    AND it must reject a DIFFERENT-session impersonation JWT (defence-
    in-depth — an attacker holding session-B's JWT cannot use it to
    end session-A).
    """

    @pytest.fixture(autouse=True)
    def _setup(self):
        self.target_tenant = _make_tenant()
        self.target = _make_regular_user(self.target_tenant)
        self.admin = _make_platform_admin()
        self.client = APIClient()
        self.client.force_authenticate(self.admin)
        # Open a session so we have something to exit.
        resp = self.client.post(
            _start_url(),
            {"user_id": str(self.target.id), "reason": "support call"},
            format="json",
        )
        assert resp.status_code == status.HTTP_201_CREATED, resp.content
        self.session_id = resp.json()["session"]["id"]
        self.impersonation_jwt = resp.json()["access_token"]

    @pytest.mark.integration
    def test_exit_via_platform_admin_cookie_session_succeeds(self):
        # Already force_authenticated as PLATFORM_ADMIN.
        resp = self.client.post(
            _exit_url(), {"session_id": self.session_id}, format="json"
        )
        assert resp.status_code == status.HTTP_200_OK, resp.content

    @pytest.mark.integration
    def test_exit_via_impersonation_jwt_succeeds(self):
        from hub.apps.tenants.models import ImpersonationSession

        # Drop the force_authenticate and use the impersonation JWT
        # instead — this is the path the SPA banner Exit button takes.
        anon = APIClient()
        anon.credentials(HTTP_AUTHORIZATION=f"Bearer {self.impersonation_jwt}")
        resp = anon.post(
            _exit_url(), {"session_id": self.session_id}, format="json"
        )
        assert resp.status_code == status.HTTP_200_OK, resp.content
        sess = ImpersonationSession.objects.using("admin").get(pk=self.session_id)
        assert sess.status == "ENDED"
        assert sess.end_reason == "manual_exit"

    @pytest.mark.integration
    def test_exit_via_different_session_jwt_returns_403(self):
        """An impersonation JWT for session-B MUST NOT exit session-A."""
        from hub.apps.auth.jwt_utils import JWTTokenGenerator
        from hub.apps.tenants.models import ImpersonationSession

        # Mint a JWT for a DIFFERENT (hypothetical) session.
        other_session_id = str(uuid.uuid4()
        bogus_jwt = JWTTokenGenerator.generate_access_token(
            self.target,
            tenant_id=str(self.target_tenant.id),
            impersonation_session_id=other_session_id,
        )
        anon = APIClient()
        anon.credentials(HTTP_AUTHORIZATION=f"Bearer {bogus_jwt}")
        resp = anon.post(
            _exit_url(), {"session_id": self.session_id}, format="json"
        )
        # The middleware rejects the JWT (session doesn't exist) so
        # request.impersonation_session_id is None — the permission
        # class returns False — DRF returns 403 (or 401 depending on
        # negotiation).
        assert resp.status_code in (
            status.HTTP_401_UNAUTHORIZED,
            status.HTTP_403_FORBIDDEN,
        )
        # The genuine session remains ACTIVE.
        sess = ImpersonationSession.objects.using("admin".get(
            pk=self.session_id
        )
        assert sess.status == "ACTIVE"

    @pytest.mark.integration
    def test_exit_audit_records_ended_by_user_id(self):
        """The audit row's ``details_json.ended_by_user_id`` records
        WHO clicked Exit — important when a different PLATFORM_ADMIN
        force-ends another operator's runaway session."""
        # Force-end as a SECOND PLATFORM_ADMIN (not the original
        # session's impersonator).
        force_ender = _make_platform_admin()
        self.client.force_authenticate(force_ender)
        resp = self.client.post(
            _exit_url(), {"session_id": self.session_id}, format="json"
        )
        assert resp.status_code == status.HTTP_200_OK, resp.content
        evt = AuditEvent.all_objects.filter(
            action=_audit_et.IMPERSONATION_ENDED,
            details_json__impersonation_session_id=self.session_id,
        ).first()
        assert evt is not None
        d = evt.details_json or {}
        assert d.get("ended_by_user_id") == str(force_ender.id)
        # The session's impersonator_user_id is preserved — distinct
        # from ended_by_user_id, proves the force-end model.
        assert d.get("impersonator_user_id") == str(self.admin.id)
