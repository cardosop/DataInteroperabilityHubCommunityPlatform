"""
Phase 235.2 — PLATFORM_ADMIN tenant-create endpoint.

Engineering contract this suite pins (REQ-ADMIN-TENANT-CREATE-001 in
``openspec/changes/preprod01/specs/admin-tenant-lifecycle/spec.md``):

1.  ``POST /api/v1/admin/tenants/`` is PLATFORM_ADMIN-only via
    ``IsPlatformAdmin``; TENANT_ADMIN gets 403; unauthenticated gets
    401/403.
2.  Payload shape: ``{slug, display_name, jurisdiction, admin_email}``
    with strict validation:
    * slug must be unique AND lowercase-alphanumeric-with-hyphens;
      duplicate slug → 422 with code ``TENANT_SLUG_DUPLICATE``.
    * jurisdiction must be a key in the platform's compliance-regime
      registry (``hub.apps.tenants.validators.VALID_COMPLIANCE_REGIMES``);
      unknown jurisdiction → 400.
    * admin_email must be a syntactically-valid email; bad email → 400.
3.  On success, the platform SHALL ATOMICALLY create:
    * a ``Tenant`` row with ``status=ACTIVE``, ``kyc_status=UNVERIFIED``,
      ``slug`` and ``name=display_name``;
    * a ``TenantConfig`` row with platform defaults + the supplied
      ``jurisdiction`` recorded in ``default_compliance_regimes``;
    * a TENANT_ADMIN ``Role`` on the new tenant + a ``UserRole`` row
      binding the freshly-created invited user to it;
    * a ``User`` with ``status=INVITED``, an ``invitation_token`` hash,
      ``invitation_token_expires_at = now + 7 days``;
4.  The platform SHALL emit a ``TENANT_CREATED`` audit event with
    ``details_json`` ``{slug, display_name, jurisdiction, admin_email,
    admin_user_id, created_by}``;
5.  The platform SHALL schedule the invitation email via the existing
    ``send_invitation_email`` task (deferred via ``transaction.on_commit``
    so a rollback doesn't leave orphaned emails);
6.  Rollback contract: if email-scheduling raises, the entire creation
    rolls back (no half-baked tenant);
7.  Duplicate-slug request returns 422 with code
    ``TENANT_SLUG_DUPLICATE`` BEFORE any side effect.
"""
from __future__ import annotations
import pytest

import uuid
from datetime import timedelta
from unittest.mock import patch

from django.contrib.auth import get_user_model
from django.utils import timezone
from rest_framework.test import APIClient

from hub.apps.audit import event_types as _audit_et
from hub.apps.audit.models import AuditEvent
from hub.apps.tenants.models import Tenant, TenantConfig

pytestmark = pytest.mark.django_db(transaction=True)
User = get_user_model()

ADMIN_TENANTS_URL = "/api/v1/admin/tenants/"


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------


def _ensure_tenant_has_subscription(tenant: Tenant) -> None:
    from datetime import timedelta
    from django.utils import timezone
    from hub.apps.billing.models import Subscription, SubscriptionStatus
    from hub.apps.tenants.models import PlanTier, TenantPlan

    if Subscription.objects.filter(tenant=tenant, status=SubscriptionStatus.ACTIVE).exists():
        return
    plan, _ = TenantPlan.objects.get_or_create(
        slug=f"test-plan-{tenant.slug}",
        defaults={
            "name": f"Test Plan {tenant.slug}",
            "tier": PlanTier.FREE,
            "limits_json": {"max_assets": 100},
            "is_active": True,
        },
    )
    Subscription.objects.create(
        tenant=tenant,
        plan=plan,
        status=SubscriptionStatus.ACTIVE,
        current_period_start=timezone.now(),
        current_period_end=timezone.now() + timedelta(days=365),
    )


def _make_tenant(*, slug_suffix: str | None = None) -> Tenant:
    uid = slug_suffix or uuid.uuid4().hex[:8]
    tenant = Tenant.objects.create(name=f"Tenant {uid}", slug=f"tenant-{uid}")
    _ensure_tenant_has_subscription(tenant)
    return tenant


def _make_platform_admin(*, tenant: Tenant | None = None) -> User:
    uid = uuid.uuid4().hex[:8]
    home_tenant = tenant or _make_tenant(slug_suffix=f"pa-home-{uid}")
    user = User.objects.create_user(
        email=f"pa-{uid}@example.com", password="testpass123", tenant=home_tenant
    )
    user.is_platform_admin = True
    user.save(update_fields=["is_platform_admin"])
    return user


def _make_regular_user(tenant: Tenant) -> User:
    uid = uuid.uuid4().hex[:8]
    return User.objects.create_user(
        email=f"u-{uid}@example.com", password="testpass123", tenant=tenant
    )


def _valid_payload() -> dict:
    uid = uuid.uuid4().hex[:8]
    return {
        "slug": f"acme-{uid}",
        "display_name": "Acme Corp",
        "jurisdiction": "GDPR",
        "admin_email": f"admin-{uid}@acme.example",
    }


# ---------------------------------------------------------------------------
# Tier 1 — permission gating
# ---------------------------------------------------------------------------


@pytest.mark.integration
class TestAdminTenantCreatePermissions:
    @pytest.fixture(autouse=True)
    def _setup(self):
        self.client = APIClient()

    @pytest.mark.integration
    def test_unauthenticated_blocked(self):
        resp = self.client.post(ADMIN_TENANTS_URL, _valid_payload(), format="json")
        assert resp.status_code in (
            status.HTTP_401_UNAUTHORIZED,
            status.HTTP_403_FORBIDDEN,
        )

    @pytest.mark.integration
    def test_tenant_admin_blocked(self):
        t = _make_tenant()
        user = _make_regular_user(t)
        self.client.force_authenticate(user)
        resp = self.client.post(ADMIN_TENANTS_URL, _valid_payload(), format="json")
        assert resp.status_code == status.HTTP_403_FORBIDDEN  # ---------------------------------------------------------------------------)
# Tier 2 — happy path + side-effects
# ---------------------------------------------------------------------------


@pytest.mark.integration
class TestAdminTenantCreateHappyPath:
    @pytest.fixture(autouse=True)
    def _setup(self):
        self.admin = _make_platform_admin()
        self.client = APIClient()
        self.client.force_authenticate(self.admin)

    @pytest.mark.integration
    def test_creates_tenant_with_status_active_and_kyc_unverified(self):
        payload = _valid_payload()
        resp = self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        assert resp.status_code == status.HTTP_201_CREATED, resp.content

        tenant = Tenant.objects.get(slug=payload["slug"])
        assert tenant.name == payload["display_name"]
        assert tenant.status == "ACTIVE"
        assert tenant.kyc_status == "UNVERIFIED"

    @pytest.mark.integration
    def test_creates_tenant_config_with_jurisdiction_in_default_compliance_regimes(self):
        payload = _valid_payload()
        payload["jurisdiction"] = "LGPD"
        self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        tenant = Tenant.objects.get(slug=payload["slug"])
        config = TenantConfig.objects.get(tenant=tenant)
        # The chosen jurisdiction is part of the tenant's regime
        # defaults — the orchestrator records the operator's intent
        # in default_compliance_regimes so downstream gates see it.
        assert "LGPD" in (config.default_compliance_regimes or [])

    @pytest.mark.integration
    def test_creates_invited_user_with_token_and_7d_expiry(self):
        payload = _valid_payload()
        resp = self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        assert resp.status_code == status.HTTP_201_CREATED
        invited = User.objects.get(email=payload["admin_email"])
        assert invited.invitation_token  # SHA-256 hex is set
        assert invited.invitation_token_expires_at is not None
        delta = invited.invitation_token_expires_at - timezone.now()
        # +/- 60s slack for test latency.
        assert timedelta(days=6, hours=23, minutes=58) <= delta <= timedelta(days=7, minutes=1)
    @pytest.mark.integration
    def test_grants_tenant_admin_role_to_invited_user(self):
        from hub.apps.users.models import Role, UserRole

        payload = _valid_payload()
        self.client.post(ADMIN_TENANTS_URL, payload, format="json")

        tenant = Tenant.objects.get(slug=payload["slug"])
        invited = User.objects.get(email=payload["admin_email"])
        tenant_admin_role = Role.objects.get(tenant=tenant, name="TENANT_ADMIN")
        assert UserRole.objects.filter(user=invited, role=tenant_admin_role).exists()

    @pytest.mark.integration
    def test_response_returns_tenant_summary(self):
        payload = _valid_payload()
        resp = self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        assert resp.status_code == status.HTTP_201_CREATED
        body = resp.json()
        # Operator must be able to navigate to the new tenant immediately.
        assert "tenant" in body
        assert body["tenant"]["slug"] == payload["slug"]
        assert body["tenant"]["name"] == payload["display_name"]  # AND know which user got invited (so the SPA can render)
        # "Invitation sent to <email>").
        assert "admin_user" in body
        assert body["admin_user"]["email"] == payload["admin_email"]

    @pytest.mark.integration
    def test_emits_tenant_created_audit_event_with_full_details(self):
        payload = _valid_payload()
        self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        tenant = Tenant.objects.get(slug=payload["slug"])
        audit = AuditEvent.objects.filter(
            tenant=tenant,
            action=_audit_et.TENANT_CREATED,
        ).order_by("-timestamp").first()
        assert audit is not None
        d = audit.details_json or {}
        assert d.get("slug") == payload["slug"]
        assert d.get("display_name") == payload["display_name"]
        assert d.get("jurisdiction") == payload["jurisdiction"]
        assert d.get("admin_email") == payload["admin_email"]
        # The PLATFORM_ADMIN who issued the request is the actor.
        assert audit.actor_user_id == self.admin.id  # And the audit event records the platform admin's id explicitly)
        # in details so audit-replay surfaces the operator across joins.
        assert d.get("created_by") == str(self.admin.id)

    @pytest.mark.integration
    def test_invitation_email_scheduled_after_commit(self):
        """The send_invitation_email task is scheduled via on_commit.

        We patch the task module's ``delay`` to capture the
        invocation argument tuple. The orchestrator MUST schedule
        the email so the invited user actually receives the
        invitation link.
        """
        payload = _valid_payload()
        with patch("hub.apps.notifications.tasks.send_invitation_email.delay") as m:
            resp = self.client.post(ADMIN_TENANTS_URL, payload, format="json")
            assert resp.status_code == status.HTTP_201_CREATED
        assert m.call_count == 1, (
            f"send_invitation_email.delay should be called exactly once; "
            f"got {m.call_count}"
        )
        called_args, called_kwargs = m.call_args
        invited = User.objects.get(email=payload["admin_email"])
        # The first positional arg is the user id (str).
        assert called_args[0] == str(invited.id)  # plaintext_token is passed as a kwarg so the URL builder can)
        # use the unhashed UUID. Confirm the kwarg is present + non-empty.
        assert called_kwargs.get("plaintext_token")


# ---------------------------------------------------------------------------
# Tier 3 — validation errors
# ---------------------------------------------------------------------------


@pytest.mark.integration
class TestAdminTenantCreateValidation:
    @pytest.fixture(autouse=True)
    def _setup(self):
        self.admin = _make_platform_admin()
        self.client = APIClient()
        self.client.force_authenticate(self.admin)

    @pytest.mark.integration
    def test_missing_slug_rejected(self):
        payload = _valid_payload()
        del payload["slug"]
        resp = self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        assert resp.status_code == status.HTTP_400_BAD_REQUEST

    @pytest.mark.integration
    def test_invalid_slug_format_rejected(self):
        payload = _valid_payload()
        payload["slug"] = "Acme Corp!"  # spaces + special chars
        resp = self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        assert resp.status_code == status.HTTP_400_BAD_REQUEST

    @pytest.mark.integration
    def test_duplicate_slug_returns_422_with_explicit_code(self):
        payload = _valid_payload()
        _make_tenant(slug_suffix=payload["slug"].replace("acme-", "")
        # Pre-create a tenant with the EXACT slug we're about to use.
        Tenant.objects.create(name="Existing", slug=payload["slug"])
        resp = self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        # Spec scenario: response is 422 with code TENANT_SLUG_DUPLICATE.
        assert resp.status_code == status.HTTP_422_UNPROCESSABLE_ENTITY, resp.content
        body = resp.json()
        assert "TENANT_SLUG_DUPLICATE" in str(body)

    @pytest.mark.integration
    def test_missing_display_name_rejected(self):
        payload = _valid_payload()
        del payload["display_name"]
        resp = self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        assert resp.status_code == status.HTTP_400_BAD_REQUEST

    @pytest.mark.integration
    def test_unknown_jurisdiction_rejected(self):
        payload = _valid_payload()
        payload["jurisdiction"] = "MADE_UP_REGIME"
        resp = self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        assert resp.status_code == status.HTTP_400_BAD_REQUEST
        body = str(resp.json()).lower()
        assert "jurisdiction" in body or "regime" in body

    @pytest.mark.integration
    def test_missing_jurisdiction_rejected(self):
        payload = _valid_payload()
        del payload["jurisdiction"]
        resp = self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        assert resp.status_code == status.HTTP_400_BAD_REQUEST

    @pytest.mark.integration
    def test_invalid_admin_email_rejected(self):
        payload = _valid_payload()
        payload["admin_email"] = "not-an-email"
        resp = self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        assert resp.status_code == status.HTTP_400_BAD_REQUEST

    @pytest.mark.integration
    def test_missing_admin_email_rejected(self):
        payload = _valid_payload()
        del payload["admin_email"]
        resp = self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        assert resp.status_code == status.HTTP_400_BAD_REQUEST

    @pytest.mark.integration
    def test_no_tenant_created_on_validation_failure(self):
        """Validation failures MUST NOT leave half-baked state."""
        before = Tenant.objects.count()
        payload = _valid_payload()
        payload["jurisdiction"] = "NOT_REAL"
        self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        after = Tenant.objects.count()
        assert before == after  # ---------------------------------------------------------------------------)
# Tier 4 — atomicity / rollback on side-effect failure
# ---------------------------------------------------------------------------


@pytest.mark.integration
class TestAdminTenantCreateAtomicity:
    @pytest.fixture(autouse=True)
    def _setup(self):
        self.admin = _make_platform_admin()
        self.client = APIClient()
        self.client.force_authenticate(self.admin)

    @pytest.mark.integration
    def test_duplicate_slug_creates_no_user_no_audit(self):
        """422 path is reject-before-write — User + AuditEvent absent."""
        payload = _valid_payload()
        Tenant.objects.create(name="Existing", slug=payload["slug"])
        resp = self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        assert resp.status_code == status.HTTP_422_UNPROCESSABLE_ENTITY

        assert not User.objects.filter(email=payload["admin_email"].exists()
        # No TENANT_CREATED audit for the failed attempt (slug already
        # belonged to a pre-existing tenant — that tenant's create
        # event predates THIS test and the filter is by email which
        # didn't get created, so this assertion is robust).
        assert not AuditEvent.objects.filter(
            action=_audit_et.TENANT_CREATED,
            details_json__admin_email=payload["admin_email"],
        ).exists()

    @pytest.mark.integration
    def test_duplicate_admin_email_returns_422_with_explicit_code(self):
        """Phase 235.2 audit-fix Gap 1 — distinct code for email collision.

        When an admin attempts to create a tenant with an
        ``admin_email`` that already belongs to a user (any tenant on
        the platform — User.email is globally unique), the response
        MUST be 422 with code ``ADMIN_EMAIL_DUPLICATE`` — NOT the
        slug-collision code. The earlier string-match disambiguation
        would have been fragile in non-en-US Postgres locales; the
        new ``.exists()`` re-query is locale-independent.
        """
        payload = _valid_payload()
        existing_tenant = _make_tenant()
        User.objects.create_user(
            email=payload["admin_email"],
            password="testpass123",
            tenant=existing_tenant,
        )
        resp = self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        assert resp.status_code == status.HTTP_422_UNPROCESSABLE_ENTITY, resp.content
        body = resp.json()
        assert body.get("code") == "ADMIN_EMAIL_DUPLICATE", body
        # Rollback contract: no Tenant row created for the failed attempt.
        assert not Tenant.objects.filter(slug=payload["slug"].exists()
    @pytest.mark.integration
    def test_tenant_config_invariant_default_subset_of_allowed(self):
        """Phase 235.2 audit-fix Gap 2 — ``default ⊆ allowed`` invariant holds.

        Even when the platform default's allowed list doesn't
        include the operator-chosen jurisdiction (or the default
        list contains regimes the allowed list doesn't), the
        orchestrator UNIONs default into allowed before creating
        the TenantConfig — preserving the superset invariant the
        TenantConfig serializer would otherwise reject.
        """
        payload = _valid_payload()
        # Pick a regime that's unlikely to be on the platform default's
        # allowed list out of the box.
        payload["jurisdiction"] = "TDPSA"
        resp = self.client.post(ADMIN_TENANTS_URL, payload, format="json")
        assert resp.status_code == status.HTTP_201_CREATED, resp.content

        tenant = Tenant.objects.get(slug=payload["slug"])
        config = TenantConfig.objects.get(tenant=tenant)
        default_set = set(config.default_compliance_regimes or [])
        allowed_set = set(config.allowed_compliance_regimes or [])
        assert "TDPSA" in default_set
        assert default_set.issubset(allowed_set), (
            f"TenantConfig invariant violated: default={default_set}, "
            f"allowed={allowed_set}; default MUST be a subset of allowed."
        )
