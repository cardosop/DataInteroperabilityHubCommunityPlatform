    @extend_schema(
        summary="Get hierarchical lineage",
        description="""
        Get complete hierarchical lineage (contract, model, and field levels).

        Returns full lineage traversal with all levels.
        """,
        parameters=[
            OpenApiParameter(
                name="max_contract_depth",
