{
  "name": "@datahub/interoperability-sdk",
  "version": "1.0.0",
  "description": "JavaScript/TypeScript SDK for Interoperable Data Hub",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:unit": "jest --testPathPattern=__tests__ --coverage --coveragePathIgnorePatterns=__tests__/e2e.test.ts",
    "test:integration": "jest --testPathPattern=__tests__/integration.test.ts --coverage",
    "test:e2e": "jest --testPathPattern=__tests__/e2e.test.ts",
    "test:coverage": "jest --coverage --coverageThreshold='{\"global\":{\"branches\":100,\"functions\":100,\"lines\":100,\"statements\":100}}'",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "generate": "openapi-generator-cli generate -i ../../api/openapi-hub-v1.yaml -g typescript-axios -o ./generated --additional-properties=typescriptThreePlus=true,withInterfaces=true",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "datahub",
    "data-contracts",
    "data-quality",
    "compliance",
    "marketplace"
  ],
  "author": "DataHub Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "@openapitools/openapi-generator-cli": "^2.7.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datahub/interoperability-hub.git",
    "directory": "sdk/js"
  }
}
